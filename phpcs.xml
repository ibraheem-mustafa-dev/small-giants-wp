<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="SGS WordPress Framework"
         xsi:noNamespaceSchemaLocation="https://schema.phpcodesniffer.com/phpcs.xsd">

    <description>PHP_CodeSniffer ruleset for the SGS WordPress Framework (theme + blocks plugin).</description>

    <!-- ── Scan targets ─────────────────────────────────────────────────── -->
    <file>plugins/sgs-blocks</file>
    <file>theme/sgs-theme</file>
    <file>plugins/sgs-booking</file>
    <file>plugins/sgs-client-notes</file>

    <!-- ── Exclusions ───────────────────────────────────────────────────── -->
    <!-- Compiled output — not source code -->
    <exclude-pattern>*/build/*</exclude-pattern>
    <!-- Composer + NPM dependencies -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <!-- Auto-generated Lucide icon map (1963 lines, exempt per CLAUDE.md) -->
    <exclude-pattern>*/includes/lucide-icons.php</exclude-pattern>
    <!-- Minified assets -->
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- ── Ruleset ──────────────────────────────────────────────────────── -->
    <!-- WordPress-Extra includes WordPress-Core + additional best-practice sniffs -->
    <rule ref="WordPress-Extra">
        <!--
            PSR-4 namespacing (e.g. SGS\Blocks) means class files may not
            follow the WordPress lowercase-hyphen naming exactly in some
            contexts — suppress this sniff to avoid false positives.
        -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <!-- Include inline doc-comment standards -->
    <rule ref="WordPress-Docs"/>

    <!-- ── WordPress environment config ────────────────────────────────── -->
    <config name="minimum_wp_version" value="6.5"/>

    <!-- ── Capabilities core WordPress does not register ─────────────────── -->
    <!-- WooCommerce's (manage_woocommerce, view_order, and the product post type's) and the SGS plugins' own. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
                <element value="view_order"/>
                <element value="edit_product"/>
                <element value="edit_products"/>
                <element value="edit_sgs_forms"/>
                <element value="sgs_manage_notes"/>
                <element value="sgs_create_notes"/>
                <element value="sgs_view_own_notes"/>
            </property>
        </properties>
    </rule>

    <!-- ── Escaping functions of the framework's own ─────────────────────── -->
    <!-- sgs_rich_text_kses(): wp_kses() with the post allow-list less style attributes (includes/helpers-inline-formats.php). -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customEscapingFunctions" type="array">
                <element value="sgs_rich_text_kses"/>
            </property>
        </properties>
    </rule>

    <!-- ── Text domain validation ───────────────────────────────────────── -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="sgs-blocks"/>
                <element value="sgs-theme"/>
                <element value="sgs-booking"/>
                <element value="sgs-client-notes"/>
            </property>
        </properties>
    </rule>

    <!-- ── Global prefix enforcement ────────────────────────────────────── -->
    <!--
        'sgs' is 3 chars — below WPCS's 4-char minimum — but it is the
        established prefix for this entire framework and is specific enough
        for a private codebase. Suppress ShortPrefixPassed only.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
        <properties>
            <property name="prefixes" type="array">
                <element value="sgs"/>
                <element value="SGS"/>
                <element value="sgs_"/>
            </property>
        </properties>
    </rule>

    <!--
        A block's render.php (block.json "render": "file:./render.php") is required inside the
        closure register_block_type_from_metadata() builds, so its top-level variables are local
        to that call, never globals. Other PHP files in a block folder stay checked: some are
        loaded at plugin start, where their variables are real globals.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>*/src/blocks/*/render\.php$</exclude-pattern>
    </rule>

    <!-- ── Tests ────────────────────────────────────────────────────────── -->
    <!--
        PHP tests run without WordPress loaded. They stand in for WordPress and WooCommerce under the real, unprefixed
        names (add_filter, WC_Order), several stand-ins to a file, often in braced namespaces; they read fixtures and run
        PHP child processes with plain PHP functions, because the wp_* replacements do not exist there; and stand-ins
        keep the real signatures, so some parameters go unused. These rules guard code that runs inside WordPress.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="WordPress.WP.AlternativeFunctions"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="WordPress.WP.EnqueuedResources"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="WordPress.Security.EscapeOutput"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="Universal.Namespaces"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="Universal.Files.SeparateFunctionsFromOO"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <!-- A test's name says what it proves; stand-ins mirror documented WordPress functions. -->
    <rule ref="Squiz.Commenting.FunctionComment.Missing"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="Squiz.Commenting.ClassComment.Missing"><exclude-pattern>*/tests/*</exclude-pattern></rule>
    <rule ref="Squiz.Commenting.VariableComment.Missing"><exclude-pattern>*/tests/*</exclude-pattern></rule>

    <!-- ── Performance ──────────────────────────────────────────────────── -->
    <arg name="parallel" value="8"/>

    <!-- Show progress and sniff codes in output -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Report only errors and warnings (not info) -->
    <arg name="report-width" value="120"/>

</ruleset>
