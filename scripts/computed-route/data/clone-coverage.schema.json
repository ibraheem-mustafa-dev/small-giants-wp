{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Clone coverage map (clone coverage plan Phase 1, step 1.3)",
	"type": "object",
	"required": [ "_meta", "entries" ],
	"additionalProperties": false,
	"properties": {
		"_meta": { "type": "object" },
		"entries": {
			"type": "object",
			"propertyNames": { "pattern": "^[a-z][a-z0-9-]*:.+$" },
			"additionalProperties": {
				"oneOf": [
					{
						"type": "object",
						"required": [ "excluded" ],
						"additionalProperties": false,
						"properties": {
							"excluded": {
								"type": "object",
								"required": [ "reason", "signedBy", "date" ],
								"additionalProperties": false,
								"properties": {
									"reason": { "type": "string", "minLength": 1 },
									"signedBy": { "type": "string" },
									"date": { "type": "string" }
								}
							},
							"note": { "type": "string" }
						}
					},
					{
						"type": "object",
						"required": [ "recognise", "write", "check" ],
						"additionalProperties": false,
						"properties": {
							"recognise": { "type": [ "string", "null" ], "minLength": 1 },
							"write": { "type": [ "string", "null" ], "minLength": 1 },
							"check": { "type": [ "string", "null" ], "minLength": 1 },
							"wave": { "type": "string" },
							"waiting": { "const": "phase-0" },
							"note": { "type": "string" }
						}
					}
				]
			}
		}
	}
}
