{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sgs.local/computed-route/facts.schema.json",
  "title": "Handoff fact record (Spec 48 FR-48-7)",
  "type": "object",
  "required": [ "schema", "client", "widths", "sources", "elements", "surfaces", "pages", "animations", "assets", "gaps", "counts" ],
  "properties": {
    "schema": { "const": "6" },
    "client": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "widths": { "type": "array", "items": { "type": "integer", "minimum": 200, "maximum": 4000 }, "minItems": 1 },
    "sources": {
      "type": "object",
      "required": [ "files", "route" ],
      "properties": {
        "files": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "route": { "type": "object", "required": [ "commit" ], "properties": { "commit": { "type": [ "string", "null" ] } } }
      }
    },
    "elements": { "type": "object", "additionalProperties": { "$ref": "#/$defs/element" } },
    "surfaces": { "type": "object", "additionalProperties": { "$ref": "#/$defs/surface" } },
    "pages": { "type": "array", "items": { "type": "object", "required": [ "surface", "route", "blocks" ], "properties": { "surface": { "type": "string" }, "route": { "type": [ "string", "null" ] }, "blocks": { "type": "array", "items": { "type": "string" } } } } },
    "animations": { "type": "object", "required": [ "records", "unjoined" ], "properties": { "records": { "type": "integer" }, "unjoined": { "type": "array", "items": { "type": "object", "required": [ "id", "reason" ], "properties": { "id": { "type": "string" }, "reason": { "type": "string" } } } } } },
    "assets": { "type": "object", "required": [ "files", "unused", "missing", "logicRefs" ], "properties": { "files": { "type": "integer" }, "unused": { "type": "array", "items": { "type": "string" } }, "logicRefs": { "type": "array", "description": "asset paths the logic names that no template element owns (a static, a getter, an instance field), with what names them", "items": { "type": "object", "required": [ "path", "by" ], "properties": { "path": { "type": "string" }, "by": { "type": "string" } } } }, "missing": { "type": "array", "items": { "type": "object", "required": [ "path", "by" ], "properties": { "path": { "type": "string" }, "by": { "type": "string" }, "via": { "type": "string" } } } } } },
    "readme": {
      "type": "object",
      "required": [ "present", "title", "sections", "judgementCalls", "openItems", "businessDetails", "platformIntent", "blockHints", "flagged", "missing" ],
      "properties": {
        "present": { "type": "boolean" },
        "title": { "type": [ "string", "null" ] },
        "sections": { "type": "array", "items": { "type": "object", "required": [ "heading", "level", "line", "template", "text", "none", "flagged" ], "properties": { "heading": { "type": "string" }, "level": { "type": "integer" }, "line": { "type": "integer" }, "template": { "type": [ "string", "null" ] }, "text": { "type": "string" }, "none": { "type": "boolean" }, "flagged": { "type": "array", "items": { "$ref": "#/$defs/readmeFlag" } } } } },
        "judgementCalls": { "type": "array", "items": { "$ref": "#/$defs/readmeItem" } },
        "openItems": { "type": "array", "items": { "$ref": "#/$defs/readmeItem" } },
        "businessDetails": { "type": "array", "items": { "$ref": "#/$defs/readmeItem" } },
        "platformIntent": { "type": "array", "items": { "$ref": "#/$defs/readmeItem" } },
        "blockHints": { "type": "array", "items": { "$ref": "#/$defs/readmeItem" } },
        "flagged": { "type": "array", "items": { "$ref": "#/$defs/readmeFlag" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "logic": {
      "type": "object",
      "description": "the logic instances' data: statics, getters and instance fields holding arrays and plain objects, per component (lib/read-logic-statics.mjs)",
      "properties": {
        "truncated": { "const": true, "description": "the record's statics passed their node budget" },
        "stateSideEffects": { "type": "object", "description": "keyed <surface id>:<state name>: template keys outside the state's surface whose hole values the state changes", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "statics": { "type": "object", "additionalProperties": { "type": "object", "required": [ "entries", "functions", "width" ], "properties": {
          "width": { "type": "integer", "description": "the viewport width the getters were read at" },
          "truncated": { "const": true },
          "dropped": { "type": "array", "description": "entries whose value changed between two reads", "items": { "type": "object", "required": [ "name", "source", "reason" ], "properties": { "name": { "type": "string" }, "source": { "enum": [ "static", "getter", "field" ] }, "reason": { "const": "volatile" } } } },
          "entries": { "type": "array", "items": { "type": "object", "required": [ "name", "source", "kind", "length", "value" ], "properties": { "name": { "type": "string" }, "source": { "enum": [ "static", "getter", "field" ] }, "kind": { "enum": [ "array", "object" ] }, "length": { "type": "integer", "minimum": 0 }, "value": {}, "dropped": { "type": "array", "items": { "type": "string" } }, "truncated": { "const": true }, "err": { "type": "string" } } } },
          "functions": { "type": "array", "items": { "type": "string" } }
        } } }
      }
    },
    "mounted": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "boolean" } } },
    "state": { "type": "object", "additionalProperties": { "type": "object", "required": [ "keys", "widthKeys" ], "properties": { "keys": { "type": "array", "items": { "type": "string" } }, "widthKeys": { "type": "array", "items": { "type": "string" } } } } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "counts": {
      "type": "object",
      "required": [ "elements", "holes", "perWidth", "widthConditions", "elementsInSurfaces", "instances", "gaps", "effects", "assets" ],
      "properties": {
        "elements": { "type": "integer" },
        "holes": { "type": "integer" },
        "perWidth": { "type": "object", "additionalProperties": { "type": "object", "required": [ "resolved", "absent", "unresolved" ], "properties": { "resolved": { "type": "integer" }, "absent": { "type": "integer" }, "unresolved": { "type": "integer" } } } },
        "widthConditions": { "type": "integer" },
        "elementsInSurfaces": { "type": "integer" },
        "instances": { "type": "integer" },
        "gaps": { "type": "integer" },
        "effects": { "type": "object", "required": [ "records", "joined", "unjoined", "elements" ], "properties": { "records": { "type": "integer" }, "joined": { "type": "integer" }, "unjoined": { "type": "integer" }, "elements": { "type": "integer" } } },
        "assets": { "type": "object", "required": [ "files", "elements", "unused", "missing" ], "properties": { "files": { "type": "integer" }, "elements": { "type": "integer" }, "unused": { "type": "integer" }, "missing": { "type": "integer" } } }
      }
    }
  },
  "$defs": {
    "gap": {
      "type": "object",
      "required": [ "construct", "draftId", "error" ],
      "properties": { "construct": { "type": "string" }, "draftId": { "type": "string" }, "error": { "type": "string" } }
    },
    "pairs": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string" } } },
    "templateRef": { "type": [ "string", "null" ] },
    "summary": {
      "type": "object",
      "required": [ "t" ],
      "properties": { "t": { "enum": [ "string", "number", "boolean", "null", "undefined", "function", "element", "array", "object" ] } }
    },
    "answer": {
      "type": "object",
      "required": [ "v", "n", "loop" ],
      "properties": {
        "v": { "type": "array", "items": { "$ref": "#/$defs/summary" } },
        "n": { "type": "integer", "minimum": 0 },
        "loop": { "type": "boolean" },
        "more": { "type": "integer" },
        "err": { "type": "string" }
      }
    },
    "hole": {
      "type": "object",
      "required": [ "id", "where", "expr", "path", "whole" ],
      "properties": {
        "id": { "type": "string" },
        "where": { "type": "string" },
        "expr": { "type": "string" },
        "path": { "type": [ "string", "null" ] },
        "whole": { "type": "boolean" }
      }
    },
    "condition": {
      "type": [ "object", "null" ],
      "properties": {
        "w": { "enum": [ "<", "<=", ">", ">=", "===", "!==", "==", "!=" ] },
        "n": { "type": "number" },
        "bp": { "type": "string" },
        "is": { "type": "boolean" },
        "when": { "$ref": "#/$defs/condition" },
        "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" },
        "partial": { "type": "boolean" }
      }
    },
    "template": {
      "type": "object",
      "required": [ "component", "n", "tag", "realTag", "attrs", "style", "pseudo", "holes", "parent", "realParent", "parentChain", "membership", "own", "ref", "hooks", "events", "words", "srcLine" ],
      "properties": {
        "component": { "type": "string" },
        "n": { "type": "string" },
        "key": { "type": "string" },
        "tag": { "type": "string" },
        "realTag": { "type": "string" },
        "attrs": { "type": "object", "additionalProperties": { "type": "string" } },
        "style": { "type": "object", "required": [ "static", "holes" ], "properties": { "static": { "$ref": "#/$defs/pairs" }, "holes": { "type": "array", "items": { "type": "string" } } } },
        "pseudo": { "type": "object", "additionalProperties": { "type": "object", "required": [ "static", "holes" ], "properties": { "static": { "$ref": "#/$defs/pairs" }, "holes": { "type": "array", "items": { "type": "string" } } } } },
        "holes": { "type": "array", "items": { "$ref": "#/$defs/hole" } },
        "parent": { "$ref": "#/$defs/templateRef" },
        "realParent": { "$ref": "#/$defs/templateRef" },
        "parentChain": { "type": "array", "items": { "type": "string" } },
        "membership": {
          "type": "object",
          "required": [ "scIf", "scFor", "dcImport" ],
          "properties": {
            "scIf": { "type": "array", "items": { "type": "object", "required": [ "key", "value" ], "properties": { "key": { "type": "string" }, "value": { "type": [ "string", "null" ] } } } },
            "scFor": { "type": "array", "items": { "type": "object", "required": [ "key", "list", "as" ], "properties": { "key": { "type": "string" }, "list": { "type": [ "string", "null" ] }, "as": { "type": "string" } } } },
            "dcImport": { "type": "array", "items": { "type": "object", "required": [ "key", "name" ], "properties": { "key": { "type": "string" }, "name": { "type": [ "string", "null" ] } } } }
          }
        },
        "own": { "type": "object" },
        "inHelmet": { "type": "boolean" },
        "inFor": { "type": "boolean" },
        "ref": { "type": [ "string", "null" ] },
        "hooks": { "type": "object", "additionalProperties": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "object", "required": [ "name", "expr" ], "properties": { "name": { "type": "string" }, "expr": { "type": [ "string", "null" ] } } } },
        "words": { "type": "string" },
        "srcLine": { "type": [ "integer", "string", "null" ] }
      }
    },
    "membership": {
      "type": "object",
      "required": [ "id", "kind", "parent", "root", "states", "otherStates", "closed_by", "time_dependent", "unresolved" ],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "parent": { "type": [ "string", "null" ] },
        "root": { "type": "boolean" },
        "states": { "$ref": "#/$defs/membershipStates" },
        "otherStates": { "$ref": "#/$defs/membershipStates" },
        "closed_by": { "type": [ "string", "null" ] },
        "time_dependent": { "type": [ "object", "null" ], "properties": { "value": { "type": "boolean" }, "reason": { "type": "string" } } },
        "unresolved": {}
      }
    },
    "membershipStates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "name", "state_keys", "in_sc_if", "animation_ids" ],
        "properties": { "name": { "type": "string" }, "state_keys": { "type": "object" }, "in_sc_if": { "type": "boolean" }, "animation_ids": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "effect": {
      "type": "object",
      "required": [ "id", "status", "flagged", "reach", "target", "via", "trigger", "breakpoints", "routes", "reduced_motion" ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": [ "string", "null" ] },
        "mechanism": { "type": [ "string", "null" ] },
        "group": { "type": [ "string", "null" ] },
        "status": { "enum": [ "active", "dead-code", "no-op" ] },
        "flagged": { "enum": [ null, "dead-code", "no-op" ] },
        "reach": { "enum": [ "self", "descendant" ] },
        "target": { "type": "string" },
        "via": { "enum": [ "template_tpl_id", "nearest_tpl_id" ] },
        "trigger": { "type": "object", "required": [ "type", "detail" ], "properties": { "type": { "type": [ "string", "null" ] }, "detail": { "type": "string" }, "state_keys": { "type": "array", "items": { "type": "string" } } } },
        "breakpoints": { "type": "array", "items": { "enum": [ "mobile", "tablet", "desktop" ] } },
        "routes": { "type": "array", "items": { "type": "string" } },
        "reduced_motion": { "type": "object", "required": [ "behaviour", "detail" ], "properties": { "behaviour": { "enum": [ null, "skip", "final-state", "unchanged" ] }, "detail": { "type": "string" } } }
      }
    },
    "readmeItem": { "type": "object", "required": [ "text", "line", "section" ], "properties": { "text": { "type": "string" }, "line": { "type": "integer" }, "section": { "type": "string" }, "flagged": { "type": "string" } } },
    "readmeFlag": { "type": "object", "required": [ "line", "text", "why" ], "properties": { "line": { "type": "integer" }, "text": { "type": "string" }, "why": { "type": "string" } } },
    "assetUse": {
      "type": "object",
      "required": [ "path", "ratio", "kind", "sha256", "animated", "via" ],
      "properties": { "path": { "type": "string" }, "ratio": { "type": [ "number", "null" ] }, "kind": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "animated": { "type": "boolean" }, "via": { "type": "string" } }
    },
    "surface": {
      "type": "object",
      "required": [ "id", "kind", "dc", "parent", "roots", "parts", "states" ],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": [ "string", "null" ] },
        "dc": { "type": "string" },
        "parent": { "type": [ "string", "null" ] },
        "roots": { "type": "array", "items": { "type": "string" } },
        "parts": { "type": "array", "items": { "type": "object", "required": [ "id", "kind", "roots" ], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "roots": { "type": "array", "items": { "type": "string" } } } } },
        "states": { "type": "array", "items": { "type": "object", "required": [ "name", "state_keys", "sc_if_tpl_ids", "animation_ids" ] } },
        "closed_by": { "type": [ "string", "null" ] },
        "time_dependent": { "type": [ "object", "null" ], "properties": { "value": { "type": "boolean" }, "reason": { "type": "string" } } },
        "unresolved": {}
      }
    },
    "element": {
      "type": "object",
      "required": [ "template", "logic", "surfaces", "effects", "assets", "instances", "fingerprint" ],
      "properties": {
        "template": { "$ref": "#/$defs/template" },
        "logic": {
          "type": "object",
          "required": [ "holes" ],
          "properties": {
            "holes": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/answer" } } },
            "holesByState": { "type": "object", "description": "keyed <surface id>:<state name>, then hole id, then width: only the values that differ from the resting ones", "additionalProperties": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/answer" } } } },
            "width": { "$ref": "#/$defs/condition" },
            "via": { "type": "string" }
          }
        },
        "surfaces": { "type": "array", "items": { "$ref": "#/$defs/membership" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/assetUse" } },
        "alt": { "type": "object", "required": [ "source", "placeholder", "hole", "id" ], "properties": { "source": { "const": "image-slot" }, "placeholder": { "type": "string" }, "hole": { "type": "boolean" }, "id": { "type": [ "string", "null" ] } } },
        "instances": { "type": "array", "items": { "type": "object", "required": [ "key", "state" ], "properties": { "key": { "type": "string" }, "state": { "type": "string" } } } },
        "fingerprint": { "type": "object", "required": [ "tag", "parentTags", "textHash" ], "properties": { "tag": { "type": "string" }, "parentTags": { "type": "array", "items": { "type": "string" } }, "textHash": { "type": "string" } } }
      }
    }
  }
}
