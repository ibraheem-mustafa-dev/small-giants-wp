{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page map (Spec 48 Appendix C, FR-48-30): sites/<client>/build/page-map.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "slug",
      "title",
      "postType",
      "collection",
      "id"
    ],
    "additionalProperties": false,
    "properties": {
      "route": {
        "type": "string"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "title": {
        "type": "string"
      },
      "parent": {
        "type": [
          "string",
          "null"
        ]
      },
      "template": {
        "type": [
          "string",
          "null"
        ]
      },
      "menus": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "menu",
            "position"
          ],
          "properties": {
            "menu": {
              "type": "string"
            },
            "position": {
              "type": "integer"
            },
            "parentItem": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "postType": {
        "enum": [
          "page",
          "post",
          "product",
          "product_cat",
          "shop",
          "sgs_header",
          "sgs_footer",
          "sgs_drawer",
          "sgs_modal",
          "sgs_mega_menu",
          "sgs_form",
          "sgs_choice_flow",
          "wp_block"
        ]
      },
      "collection": {
        "enum": [
          "static",
          "live"
        ]
      },
      "flags": {
        "type": "array",
        "items": {
          "enum": [
            "placeholder",
            "stock",
            "prototype-only"
          ]
        }
      },
      "id": {
        "type": [
          "integer",
          "null"
        ]
      }
    }
  }
}
