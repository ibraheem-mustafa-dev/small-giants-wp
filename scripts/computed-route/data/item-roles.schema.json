{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "List item roles (data/item-roles.json, Spec 48 FR-48-82)",
  "type": "object",
  "required": ["roles"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "words"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z]+$" },
          "words": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+$" }
          }
        }
      }
    }
  }
}
