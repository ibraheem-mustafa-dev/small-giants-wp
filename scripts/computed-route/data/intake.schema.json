{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intake record (Spec 48 Appendix C, FR-48-35): sites/<client>/build/intake/intake.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "client",
    "takenOn",
    "manifest",
    "tools",
    "harness",
    "census",
    "inventory",
    "routing",
    "breakpoints",
    "pageMap",
    "palette",
    "siteInfo",
    "flags",
    "draftDefects",
    "notDefects",
    "missingFeatures",
    "skeletons",
    "notices",
    "gaps",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "client": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "takenOn": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "required": [
        "files",
        "route"
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "route": {
          "type": "object",
          "required": [
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema_version",
        "files"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "required": [
        "playwright",
        "browser",
        "runtime"
      ],
      "properties": {
        "playwright": {
          "type": "string"
        },
        "browser": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "harness": {
      "type": "object",
      "required": [
        "clock",
        "seed",
        "stepMs"
      ],
      "properties": {
        "clock": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "stepMs": {
          "type": "integer"
        }
      }
    },
    "census": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "draftId",
          "source",
          "unreached"
        ],
        "anyOf": [
          {
            "required": [
              "reader"
            ]
          },
          {
            "required": [
              "gap"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "draftId": {
            "type": "string"
          },
          "source": {
            "enum": [
              "static",
              "runtime",
              "both"
            ]
          },
          "reader": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "unreached": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "required": [
        "animations",
        "surfaces"
      ],
      "properties": {
        "animations": {
          "description": "The re-derived animations inventory, validated against handoff-schema/animations.schema.json (lib/intake-inventory.mjs::validateInventory)."
        },
        "surfaces": {
          "description": "The re-derived surfaces inventory, validated against handoff-schema/surfaces.schema.json."
        },
        "diff": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rowId",
              "draftId"
            ],
            "properties": {
              "rowId": {
                "type": "string"
              },
              "draftId": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "ours": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "theirs": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "occurrence",
              "kind",
              "role",
              "recordIds"
            ],
            "properties": {
              "occurrence": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "effect",
                  "trigger",
                  "context",
                  "surface"
                ]
              },
              "recordIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "propVariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "component",
              "prop",
              "mounted",
              "variants",
              "unused"
            ]
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "recordId",
              "width",
              "t",
              "values"
            ]
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "adapter",
        "routes",
        "links"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "hash",
            "state-page",
            "files"
          ]
        },
        "routes": {
          "type": "array"
        },
        "links": {
          "type": "array"
        }
      }
    },
    "breakpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "basis",
          "thresholds"
        ],
        "properties": {
          "basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "thresholds": {
            "type": "array"
          }
        }
      }
    },
    "pageMap": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pageMapRow"
      }
    },
    "palette": {
      "type": "object",
      "required": [
        "tokens",
        "rows",
        "unused",
        "oneOff"
      ],
      "properties": {
        "tokens": {
          "type": "array"
        },
        "rows": {
          "type": "array"
        },
        "unused": {
          "type": "array"
        },
        "oneOff": {
          "type": "array"
        }
      }
    },
    "siteInfo": {
      "type": "object",
      "required": [
        "rows",
        "refused"
      ],
      "properties": {
        "rows": {
          "type": "array"
        },
        "refused": {
          "type": "array"
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rowId",
          "draftId"
        ],
        "properties": {
          "rowId": {
            "type": "string",
            "minLength": 1
          },
          "draftId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "draftDefects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rowId",
          "draftId"
        ],
        "properties": {
          "rowId": {
            "type": "string",
            "minLength": 1
          },
          "draftId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notDefects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "draftId",
          "why"
        ],
        "properties": {
          "draftId": {
            "type": "string",
            "minLength": 1
          },
          "censusId": {
            "type": "string"
          },
          "why": {
            "enum": [
              "render-wins",
              "reached-when-forced",
              "breakpoint",
              "dead-code",
              "prototype-only",
              "prop-variant"
            ]
          },
          "deadKind": {
            "enum": [
              "unwired",
              "constant-guard",
              "data-gated"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "missingFeatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rowId",
          "draftId"
        ],
        "properties": {
          "rowId": {
            "type": "string",
            "minLength": 1
          },
          "draftId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "skeletons": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "notices": {
      "type": "object",
      "required": [
        "prose",
        "blockedHosts"
      ],
      "properties": {
        "prose": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rowId",
              "file",
              "text"
            ]
          }
        },
        "blockedHosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "host",
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "unlisted-host",
                  "replay-miss",
                  "websocket"
                ]
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "construct",
          "draftId",
          "error"
        ],
        "properties": {
          "construct": {
            "type": "string"
          },
          "draftId": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rowId",
          "rowType",
          "contentHash",
          "mark",
          "markedOn",
          "carriedFrom"
        ],
        "additionalProperties": false,
        "properties": {
          "rowId": {
            "type": "string",
            "minLength": 1
          },
          "rowType": {
            "enum": [
              "page-map",
              "palette-role",
              "site-info",
              "flag",
              "draft-defect",
              "not-a-defect",
              "missing-feature",
              "effect",
              "skeleton-block",
              "inventory-diff",
              "notice"
            ]
          },
          "contentHash": {
            "type": "string",
            "minLength": 1
          },
          "mark": {
            "type": [
              "string",
              "null"
            ]
          },
          "markedOn": {
            "type": [
              "string",
              "null"
            ]
          },
          "carriedFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "changed": {
            "type": "boolean"
          },
          "realignedFrom": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "pageMapRow": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "postType",
        "collection",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "type": [
            "string",
            "null"
          ]
        },
        "menus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "menu",
              "position"
            ],
            "properties": {
              "menu": {
                "type": "string"
              },
              "position": {
                "type": "integer"
              },
              "parentItem": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "postType": {
          "enum": [
            "page",
            "post",
            "product",
            "product_cat",
            "shop",
            "sgs_header",
            "sgs_footer",
            "sgs_drawer",
            "sgs_modal",
            "sgs_mega_menu",
            "sgs_form",
            "sgs_choice_flow",
            "wp_block"
          ]
        },
        "collection": {
          "enum": [
            "static",
            "live"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "placeholder",
              "stock",
              "prototype-only"
            ]
          }
        },
        "parts": {
          "type": "array",
          "description": "Surfaces this row owns that make no row of their own (FR-48-30): a block's panel, WooCommerce's forms and endpoints, a page's own header, a surfaces.json record the code does not show",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "label",
              "owner",
              "draftId"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "owner": {
                "enum": [
                  "block",
                  "woocommerce",
                  "page",
                  "draft-notes"
                ]
              },
              "draftId": {
                "type": "string"
              }
            }
          }
        },
        "id": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
