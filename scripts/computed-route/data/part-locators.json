							"match": {
								"hasAll": [
									{
										"childText": [
											"words",
											"currency"
										]
									},
									{
										"repeats": true,
										"minChildren": 3,
										"tag": [
											"div",
											"li",
											"tr",
											"article"
										],
										"has": {
											"text": "currency"
										}
									}
								]
							},
							"smallest": true
						}
					]
				},
				"lines": {
					"from": "page",
					"match": {
						"repeats": true,
						"minChildren": 3,
						"tag": [
							"div",
							"li",
							"tr",
							"article"
						],
						"has": {
							"text": "currency"
						}
					}
				},
				"couponRow": {
					"from": "summary",
					"match": {
						"hasAll": [
							{
								"tag": [
									"input"
								]
							},
							{
								"tag": [
									"button"
								]
							}
						],
						"lacks": {
