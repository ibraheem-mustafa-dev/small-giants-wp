				"summary-heading": {
					"from": "summary",
					"match": {
						"ownText": true,
						"text": "words",
						"control": false
					},
					"pick": "first"
				},
				"summary-title-text": {
					"sameAs": "summary-heading"
				},
				"layout": {
					"from": "page",
					"match": {
						"parentOfAnchor": "summary"
					}
				},
				"summary-row-label": {
					"from": "summary",
