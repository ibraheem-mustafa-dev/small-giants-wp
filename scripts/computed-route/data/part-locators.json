		"accountIn": {
			"_comment": "The account signed in, read view by view (lib/part-look-signed-in.mjs). A part with view \"detail\" is read only on an item's own page (opened from the first listed item); every other part on the tabs the account menu opens. Address cards are read only in a view that lists no amount (the orders and a subscription list amounts; an address card never does). The parts the signed-out group already reads (the fields, their labels, the page header) are not repeated here, so the two surfaces never write one setting twice.",
			"anchors": {
				"menu": {
					"from": "page",
					"match": {
						"tag": [
							"nav"
						],
						"hasMany": {
							"match": {
								"control": true,
								"repeats": true
							},
							"atLeast": 2
						}
					},
					"pick": "first"
