					"from": "drawer",
					"match": {
						"parentOfAnchor": "lines"
					},
					"smallest": true
				},
				"itemThumb": {
					"from": "lines",
					"match": {
						"paint": "image",
						"square": true
					},
					"perRoot": true,
					"pick": "first"
				},
				"item-name": {
					"from": "lines",
					"match": {
						"ownText": true,
						"text": "words",
						"control": false
					},
					"perRoot": true,
					"pick": {
						"index": 0
					}
				},
				"itemDetail": {
					"from": "lines",
					"match": {
						"ownText": true,
						"text": "words",
						"control": false
					},
					"perRoot": true,
					"pick": {
						"index": 1
					}
				},
				"item-details": {
					"sameAs": "itemDetail"
				},
				"item-price": {
					"from": "lines",
					"match": {
						"ownText": true,
						"text": "currency"
					},
					"perRoot": true,
					"pick": "first"
				},
				"item-stepper": {
					"from": "lines",
					"match": {
						"hasAll": [
							{
								"text": "count"
							}
						],
						"hasMany": {
							"match": {
								"tag": [
									"button"
								]
							},
							"atLeast": 2
						}
					},
					"perRoot": true,
					"smallest": true
				},
				"itemQty": {
					"sameAs": "item-stepper"
				},
				"itemRemove": {
					"from": "lines",
					"match": {
						"tag": [
							"button"
						],
						"text": "words"
					},
					"perRoot": true,
					"pick": "first"
				},
				"subtotal": {
					"from": "drawer",
					"match": {
						"childText": [
							"words",
							"currency"
						]
					},
					"pick": "last"
				},
				"subtotalValue": {
					"from": "drawer",
					"match": {
						"childText": [
							"words",
							"currency"
						]
					},
					"pick": "last",
					"rel": {
						"childIndex": 1,
						"deepest": true
					}
				},
				"panelTaxNote": {
					"from": "drawer",
					"match": {
						"ownText": true,
						"text": "words",
						"control": false,
						"tag": [
							"div",
							"p"
						]
					},
					"pick": "last"
				},
				"panelNote": {
					"sameAs": "panelTaxNote"
				},
				"panel-note": {
					"sameAs": "panelTaxNote"
				},
				"panel-tax-note": {
					"sameAs": "panelTaxNote"
				},
				"checkout": {
					"from": "drawer",
					"match": {
						"control": true,
						"tag": [
							"a",
							"button"
						],
						"linksTo": "checkout"
					},
					"smallest": true
				},
				"panel-checkout": {
					"sameAs": "checkout"
				},
				"panelView": {
					"from": "drawer",
					"match": {
						"control": true,
						"tag": [
							"a"
						],
						"linksTo": "cart"
					},
					"smallest": true
				},
				"panel-view": {
					"sameAs": "panelView"
				},
				"panelFooter": {
					"from": "drawer",
					"match": {
						"hasAll": [
							{
								"linksTo": "checkout",
								"control": true
							},
							{
								"childText": [
									"words",
									"currency"
								]
							}
						]
					},
					"smallest": true
				},
				"trigger": {
					"sameAs": "trigger"
				},
				"pill": {
					"sameAs": "trigger"
				},
				"badge": {
					"from": "trigger",
					"match": {
						"text": "count"
					},
					"pick": "first"
				},
				"icon": {
					"from": "trigger",
					"match": {
						"tag": [
							"svg"
						]
					},
					"pick": "first"
				}
			}
		}
	}
}