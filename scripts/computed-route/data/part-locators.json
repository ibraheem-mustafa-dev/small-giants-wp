{
	"_comment": "How to find each shop look part's element in a client draft (lib/fill-part-look.mjs). A part is keyed by the framework database's css_element for the group's blocks (block_attributes.css_element), so the look table's rows and the older named settings are covered the same way. A locator names structure only: input type, ARIA role, autocomplete token, tag, position, repeated siblings, the kind of text an element holds (currency, count, words, none), what it holds and where it sits; the grammar is documented in lib/fill-part-look-page.mjs. Wording is never a signal. A part with no entry has no locator and shows in the report as such. `pages` roles are filled from the client's page map at run time (the file each WooCommerce page's draft lives in).",
	"surfaces": {
		"cart": {
			"group": "wc",
			"block": "woocommerce/cart",
			"pageRole": "cart"
		},
		"checkout": {
			"group": "wc",
			"block": "woocommerce/checkout",
			"pageRole": "checkout"
		},
		"my-account": {
			"group": "account",
			"block": "sgs/account",
			"pageRole": "account",
			"alsoRead": [
				"signin"
			]
		},
		"my-account-in": {
			"_comment": "The account's signed-in views (lib/part-look-signed-in.mjs): the draft is signed in on its sign-in page and read view by view; the client's my-account surface names the draft and the post.",
			"group": "accountIn",
			"block": "sgs/account",
			"pageRole": "account",
			"entryOf": "my-account",
			"signedIn": true
		},
		"header": {
			"group": "drawer",
			"block": "sgs/cart",
			"pageRole": "cart"
		},
		"product": {
			"group": "buybox",
			"block": "sgs/buybox",
			"pageRole": "product",
			"template": "single-product",
			"basket": false
		},
		"shop": {
			"group": "productcard",
			"block": "sgs/product-card",
			"pageRole": "shop",
			"template": "archive-product",
			"basket": false,
			"instances": "majority"
		}
	},
	"groups": {
		"wc": {
			"anchors": {
				"totalsRow": {
					"from": "page",
					"match": {
						"childText": [
							"words",
							"currency"
						],
						"tag": [
							"div",
							"li",
							"tr",
							"dl"
						]
					}
				},
				"summary": {
					"any": [
						{
							"from": "page",
							"match": {
								"hasAll": [
									{
										"childText": [
											"words",
											"currency"
										]
									},
									{
										"linksTo": "checkout",
										"control": true
									}
								]
							},
							"smallest": true
						},
						{
							"from": "page",
							"match": {
								"hasAll": [
									{
										"childText": [
											"words",
											"currency"
										]
									},
									{
										"repeats": true,
										"minChildren": 2,
										"tag": [
											"div",
											"li",
											"tr",
											"article"
										],
										"has": {
											"text": "currency"
										},
										"hasMany": {
											"match": {
												"ownText": true,
												"text": "words",
												"control": false
											},
											"atLeast": 2
										}
									}
								]
							},
							"smallest": true
						}
					]
				},
				"lines": {
					"from": "page",
					"match": {
						"repeats": true,
						"minChildren": 2,
						"tag": [
							"div",
							"li",
							"tr",
							"article"
						],
						"has": {
							"text": "currency"
						},
						"hasMany": {
							"match": {
								"ownText": true,
								"text": "words",
								"control": false
							},
							"atLeast": 2
						}
					}
				},
				"couponRow": {
					"from": "summary",
					"match": {
						"hasAll": [
							{
								"tag": [
									"input"
								]
							},
							{
								"tag": [
									"button"
								]
							}
						],
						"lacks": {
							"text": "currency"
						}
					},
					"smallest": true
				},
				"fields": {
					"from": "page",
					"match": {
						"tag": [
							"input"
						],
						"inputType": [
							"",
							"text",
							"email",
							"tel",
							"search",
							"number"
						],
						"control": true,
						"notInAnchor": "couponRow"
					}
				},
				"legends": {
					"from": "page",
					"match": {
						"tag": [
							"legend"
						]
					}
				},
				"radioCards": {
					"from": "page",
					"match": {
						"tag": [
							"button",
							"label"
						],
						"repeats": true,
						"hasAll": [
							{
								"text": "currency"
							},
							{
								"square": true,
								"text": "none"
							}
						],
						"inside": {
							"tag": [
								"fieldset"
							]
						}
					}
				},
				"placeOrder": {
					"from": "page",
					"match": {
						"tag": [
							"button"
						],
						"type": [
							"submit"
						]
					},
					"pick": "last"
				},
				"checkoutLink": {
					"from": "summary",
					"match": {
						"control": true,
						"linksTo": "checkout",
						"tag": [
							"a",
							"button"
						]
					},
					"smallest": true
				},
				"headerRow": {
					"from": "page",
					"match": {
						"precedesAnchor": "lines",
						"minChildren": 2,
						"allChildren": {
							"text": "words"
						},
						"control": false,
						"notInAnchor": "lines"
					},
					"smallest": true
				},
				"linesParent": {
					"from": "page",
					"match": {
						"parentOfAnchor": "lines"
					},
					"smallest": true
				},
				"express": {
					"from": "page",
					"match": {
						"tag": [
							"button"
						],
						"repeats": true,
						"text": "words",
						"notInside": {
							"tag": [
								"fieldset"
							]
						}
					}
				},
				"expressGroup": {
					"from": "page",
					"match": {
						"parentOfAnchor": "express"
					},
					"smallest": true
				},
				"expressRule": {
					"from": "page",
					"match": {
						"followsAnchor": "expressGroup",
						"ownText": true,
						"text": "words",
						"minChildren": 2,
						"allChildren": {
							"text": "none"
						}
					}
				}
			},
			"parts": {
				"field-input": {
					"sameAs": "fields"
				},
				"field-text-input": {
					"sameAs": "fields"
				},
				"field-label": {
					"from": "fields",
					"self": true,
					"match": {},
					"rel": "label"
				},
				"field-wrap": {
					"from": "fields",
					"self": true,
					"match": {},
					"rel": "wrapper"
				},
				"field-in-step": {
					"sameAs": "field-wrap"
				},
				"checkbox-input": {
					"from": "page",
					"match": {
						"tag": [
							"input"
						],
						"inputType": [
							"checkbox"
						]
					},
					"blocks": [
						"woocommerce/checkout"
					]
				},
				"checkbox-wrap-label": {
					"match": {
						"tag": [
							"input"
						],
						"inputType": [
							"checkbox"
						]
					},
					"rel": "label",
					"blocks": [
						"woocommerce/checkout"
					],
