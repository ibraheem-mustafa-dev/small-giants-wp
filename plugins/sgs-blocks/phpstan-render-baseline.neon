# PHPStan baseline for the render-template undefined-variable gate.
#
# Pre-existing findings, frozen 2026-08-21 so the gate could ship the same day it was
# written. Deliberately SMALL and reviewable — this is a triage list, not a dumping
# ground. Every entry was read before it was frozen; the triage is below. If this file
# ever grows past ~25 entries, something is being hidden rather than recorded.
#
# ⚠ `count:` is load-bearing. A SECOND defect in a baselined file raises the count and
# FAILS the gate. Baselined does not mean unguarded.
#
# TRIAGE — what each group is, and what is owed:
#
#   INHERITED SCOPE — none. The gate analyses each render.php with the partials it
#     pulls in by plain require/include inlined (check-render-undefined-vars.py::
#     _template_tree), as PHP runs them, so a partial's inherited locals are defined
#     and a typo in a partial still fails.
#
#   MISSING THIRD-PARTY SYMBOLS — RETIRED 2026-09-24: `php-stubs/woocommerce-stubs` is now in
#     require-dev and scanned by phpstan-render.neon, so the six WooCommerce entries are gone.
#
#   MISSING OWN CONSTANT — 2 entries
#     google-reviews/render.php — SGS_BLOCKS_PATH is defined in sgs-blocks.php (line 28)
#     but behind a guard PHPStan does not enter. OWED: a `constants:` declaration.
#
#   DEAD DEFENSIVE CODE (PHPStan is right, the code is redundant) — 3 entries
#     before-after:433, brand-strip:273, container:196 — `empty()`/`??` on values that
#     always exist. Harmless, but each is a guard that reads as protection and protects
#     nothing. OWED: delete the redundant guards.
#
# Regenerate (and re-triage — regeneration DROPS this header):
#   php vendor/bin/phpstan analyse -c phpstan-render.neon #       --generate-baseline=phpstan-render-baseline.neon --memory-limit=1G

parameters:
	ignoreErrors:
		-
			message: '#^Variable \$sgs_slot_tiers in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/blocks/before-after/render.php

		-
			message: '#^Variable \$css_vars in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/blocks/brand-strip/render.php

		-
			message: '#^Variable \$sgs_container_supports_css on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/blocks/container/render.php

		-
			message: '#^Constant SGS_BLOCKS_PATH not found\.$#'
			identifier: constant.notFound
			count: 2
			path: src/blocks/google-reviews/render.php

		-
			message: '#^Variable \$base_style_engine_args in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/blocks/before-after/render.php

		-
			message: '#^Variable \$hero_style_engine_args in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/blocks/hero/render.php

		-
			message: '#^Variable \$sf_style_engine_args in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/blocks/site-footer/render.php
