	"sgs/nav-bar-menu": {
		"attributes": {
			"ref": "{{menu}}",
			"splitAfterItemId": "id:{{menuItem}}",
			"disabledItemIds": [
				"id:{{menuItem}}",
				"id:9104>id:9106"
			],
			"submenuOpenOn": "hover",
			"triggerMode": {
				"desktop": "icon-and-text",
				"mobile": "icon"
			},
			"submenuCaret": false,
			"drawerRef": "{{drawer}}",
			"megaAlign": {
				"desktop": "full-width"
			},
			"featuredItemIds": [
				"id:9104>id:9105"
			]
		},
		"variants": [
			{},
			{
				"disabledItemIds": [
					"id:9104>id:9106"
				],
				"featuredItemIds": [
					"id:{{menuItem}}",
					"id:9104>id:9105"
				]
			},
			{
				"triggerDetach": {
					"desktop": "on",
					"tablet": "on",
					"mobile": "on"
				}
			},
			{
				"submenuCaret": true
			}
		],
		"preconditions": {
			"featuredRadius": {
				"featuredBg": "primary"
			},
			"itemBorderRadius": {
				"itemBg": "primary"
			},
			"itemMotionEasing": {
				"itemMotionDuration": 300
			},
			"submenuCaretTurnEasingCustom": {
				"submenuCaretTurnEasing": "custom",
				"submenuCaretTurnDuration": 300
			},
			"scrimFadeDuration": {
				"scrimOpacity": {
					"desktop": 0.5
				}
			},
			"scrimFadeEasing": {
				"scrimOpacity": {
					"desktop": 0.5
				}
			}
		},
		"parents": [
			{
				"name": "sgs/site-header",
				"attributes": {
					"headerSticky": {
						"desktop": "on"
					},
					"scrolledOffset": 40
				}
			},
			{
				"name": "sgs/site-header-row",
				"attributes": {
					"rowSlot": "middle",
					"rowShrink": {
						"desktop": "on"
					},
					"rowShrinkEasingCustom": "cubic-bezier(0.2, 0.7, 0.2, 1)"
				}
			}
		],
		"companionClass": "is-detached",
		"harness": {
			"attachmentsFile": "fixtures/attachments.json",
			"postFile": "fixtures/menu-post.json"
		},
		"post": [
			{
				"select": ".sgs-nav-bar-menu__sublink[data-sgs-nav-path=\"/shop/cases/\"]",
				"set": {
					"aria-current": "page"
				},
				"why": "src/blocks/nav-bar-menu/view.js::markCurrentPage"
			}
		],
		"notes": [
			"The menu post (fixtures/menu-post.json, ID 9101) holds the Shop submenu (9104) with three sub-links: Sunglasses 9105 featured, Frames 9106 disabled, Cases 9109 current, Lenses 9110 plain (each special sub-link has its own colour rule, so a setting that colours ordinary sub-links shows only on a plain one). Home and Sunglasses carry a description, which the menu prints as each link's badge (src/blocks/nav-bar-menu/render.php reads `description` as `badge`; includes/nav-menu-markup.php::sgs_nav_shared_badge_html prints `sgs-nav-bar-menu__badge`). A child identifier is path-qualified, `id:<parent>>id:<child>` (src/blocks/nav-bar-menu/render.php::from_link, read by includes/nav-menu-markup.php::sgs_nav_bar_menu_render_items).",
			"Current is set in the browser by view.js::markCurrentPage (aria-current=\"page\" on the link whose data-sgs-nav-path matches the page), so `post` sets it on the Cases sub-link after render.",
			"Variant 1 keeps calibration's featured top-level item (Home) beside the featured sub-link; Home stays disabled in the other variants, as in calibration."
		]
	}
