{
 "name": "sgs/looked",
 "attributes": {
  "padding": {
   "type": "object",
   "default": {
    "desktop": {}
   }
  },
  "look": {
   "type": "string",
   "default": "plain",
   "enum": [
    "plain",
    "big"
   ]
  }
 },
 "supports": {
  "sgs": {
   "elements": {
    "wrapper": {
     "isWrapper": true,
     "attrMap": {
      "css:padding": "padding"
     }
    }
   },
   "spacingDefaults": {
    "padding": {
     "top": "20px",
     "right": "20px",
     "bottom": "20px",
     "left": "20px",
     "when": [
      {
       "attrs": {
        "look": "big"
       },
       "classes": [
        "sgs-looked--look-big"
       ],
       "top": "28px",
       "right": "28px",
       "bottom": "28px",
       "left": "28px",
       "mobile": {
        "top": "18px",
        "right": "18px",
        "bottom": "18px",
        "left": "18px"
       }
      }
     ]
    }
   }
  }
 }
}
