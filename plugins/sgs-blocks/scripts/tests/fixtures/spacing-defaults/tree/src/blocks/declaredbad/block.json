{
 "name": "sgs/declaredbad",
 "attributes": {
  "padding": {
   "type": "object",
   "default": {
    "desktop": {}
   }
  },
  "margin": {
   "type": "object",
   "default": {
    "desktop": {}
   }
  }
 },
 "supports": {
  "sgs": {
   "elements": {
    "wrapper": {
     "isWrapper": true,
     "attrMap": {
      "css:padding": "padding",
      "css:margin": "margin"
     }
    }
   },
   "spacingDefaults": {
    "padding": {
     "top": "var(--wp--preset--spacing--40)",
     "right": "16px",
     "bottom": "var(--wp--preset--spacing--10)",
     "left": "14px"
    },
    "margin": {
     "top": "var(--wp--preset--spacing--30)"
    }
   }
  }
 }
}
