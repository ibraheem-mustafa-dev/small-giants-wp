{
 "name": "sgs/whenbad",
 "attributes": {
  "padding": {
   "type": "object",
   "default": {
    "desktop": {}
   }
  },
  "look": {
   "type": "string",
   "default": "plain",
   "enum": [
    "plain",
    "big",
    "wide"
   ]
  }
 },
 "supports": {
  "sgs": {
   "elements": {
    "wrapper": {
     "isWrapper": true,
     "attrMap": {
      "css:padding": "padding"
     }
    }
   },
   "spacingDefaults": {
    "padding": {
     "top": "20px",
     "right": "20px",
     "bottom": "20px",
     "left": "20px",
     "when": [
      {
       "attrs": {
        "look": "huge"
       },
       "classes": [
        "sgs-whenbad--look-big"
       ],
       "top": "28px"
      },
      {
       "attrs": {
        "nope": "big"
       },
       "classes": [
        "sgs-whenbad--look-big"
       ],
       "right": "28px"
      },
      {
       "attrs": {
        "look": "plain"
       },
       "classes": [
        "sgs-whenbad--look-zzz"
       ],
       "bottom": "20px"
      }
     ]
    }
   }
  }
 }
}
