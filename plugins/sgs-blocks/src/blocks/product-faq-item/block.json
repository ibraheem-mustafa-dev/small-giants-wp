{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/product-faq-item",
	"version": "0.1.0",
	"title": "SGS Product FAQ Item",
	"category": "sgs-content",
	"description": "A single question and answer pair inside a Product FAQ block. The visible content is read by search engines to improve AI search citation and Bing visibility.",
	"keywords": [
		"faq",
		"question",
		"answer",
		"item",
		"product"
	],
	"textdomain": "sgs-blocks",
	"icon": "arrow-down-alt2",
	"parent": [
		"sgs/product-faq"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"elements": {
				"item": {
					"label": "FAQ item",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:border-color-gradient": "borderColourGradient",
						"css:background-image": "textColourGradient"
					},
					"_note": "No `text` cluster declared — this block declares no `typography` support at all and no per-element font attrs (question/isOpen are content-only), so a text cluster would resolve zero members and violate ROLLOUT REQUIREMENT 1. Similarly no `spacing` support exists (padding/margin absent) — those layout members are honest gaps. textColourGradient is the text-colour gradient sibling to textColour, same background-clip:text mechanism as sgs/counter's labelColour/labelColourGradient (D636 gap-closure)."
				}
			},
			"hideExtensions": [
				"fx"
			],
			"boxFamilies": {
				"borderRadius": [
					"borderRadius"
				]
			}
		}
	},
	"usesContext": [
		"sgs/productFaqIconPosition"
	],
	"attributes": {
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"question": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"isOpen": {
			"type": "boolean",
			"default": false
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"example": {
		"attributes": {
			"question": "What are the ingredients?",
			"isOpen": true
		}
	}
}
