{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/whatsapp-cta",
	"version": "0.2.0",
	"title": "SGS WhatsApp CTA",
	"category": "sgs-content",
	"description": "WhatsApp integration with floating button, inline CTA, or banner variants.",
	"keywords": [
		"whatsapp",
		"chat",
		"cta",
		"contact",
		"message",
		"button"
	],
	"textdomain": "sgs-blocks",
	"icon": "phone",
	"supports": {
		"sgs": {
			"enabledExtensions": [
				"hover"
			],
			"hoverDefaults": {
				"scalePreset": "1.02",
				"shadow": "raised",
				"imageZoom": false,
				"focusRing": true
			},
			"hoverExcludeControls": [
				"imageZoom",
				"grayscale"
			],
			"scalarStylingLift": true,
			"boxFamilies": {
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				],
				"borderRadius": [
					"borderRadiusTablet",
					"borderRadiusMobile"
				]
			},
			"elements": {
				"button": {
					"label": "Button",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"prefix": "label",
					"_note": "Contract §B3 single-semantic-element block — the <a> IS the block root (no wrapper div); it plays both the wrapper and the button/label element. labelColour/labelFontSize/labelFontWeight/labelFontStyle resolve via the default {prefix}{suffix} convention (prefix: 'label').",
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:color": "labelColour",
						"css:background-image": "labelColourGradient",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-radius": "native:__experimentalBorder.radius"
					}
				}
			}
		},
		"align": false,
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"__experimentalSkipSerialization": true
		}
	},
	"selectors": {
		"root": ".sgs-whatsapp-cta",
		"typography": ".sgs-whatsapp-cta__label"
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"phoneNumber": {
			"type": "string"
		},
		"message": {
			"type": "string",
			"default": "Hi, I'd like to know more about your services."
		},
		"variant": {
			"type": "string",
			"default": "floating"
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"showOn": {
			"type": "object",
			"default": {
				"desktop": true,
				"mobile": true
			}
		},
		"labelColour": {
			"type": "string",
			"default": "text"
		},
		"labelColourGradient": {
			"type": "string",
			"default": ""
		},
		"labelFontSize": {
			"type": "object",
			"default": {}
		},
		"labelFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"labelFontWeight": {
			"type": "string",
			"default": ""
		},
		"labelFontStyle": {
			"type": "string",
			"default": ""
		},
		"backgroundColour": {
			"type": "string",
			"default": "whatsapp"
		},
		"borderRadiusTablet": {
			"type": "object",
			"default": {}
		},
		"borderRadiusMobile": {
			"type": "object",
			"default": {}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"variant": "floating",
			"label": "Chat on WhatsApp",
			"message": "Hi, I'd like to know more about your services."
		}
	},
	"render": "file:./render.php"
}
