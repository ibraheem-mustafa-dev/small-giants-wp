{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/multi-button",
	"version": "1.4.0",
	"title": "SGS Button Group",
	"category": "sgs-content",
	"description": "A flexible container for one or more SGS Buttons. Provides per-breakpoint layout, gap, alignment, and wrap controls.",
	"keywords": [
		"button group",
		"cta",
		"buttons",
		"multi button"
	],
	"icon": "button",
	"textdomain": "sgs-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php",
	"allowedBlocks": [
		"sgs/button"
	],
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "layout",
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				]
			},
			"elements": {
				"group": {
					"label": "Button group",
					"layer": "OUTER",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:border-width": "native:__experimentalBorder.width",
						"css:border-style": "native:__experimentalBorder.style",
						"css:border-color": "native:__experimentalBorder.color",
						"css:border-radius": "native:__experimentalBorder.radius",
						"css:padding": "native:spacing.padding",
						"css:background-image": "backgroundImage",
						"css:max-width": "maxWidth",
						"css:gap": "gap",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap",
						"css:justify-content": "justifyContent",
						"css:align-items": "alignItems"
					},
					"_note": "The root IS the flex arranger (own scoped CSS in render.php, not the shared wrapper's grid layer) — layer OUTER is correct per the MF-3 guard, same reasoning as sgs/card-grid's `grid` element. `spacing.margin`/`spacing.padding` are declared (2026-08-13/2026-08-16). `typography` remains an honest gap. `display` is hardcoded to flex in render.php — not attribute-controlled, an honest gap. Background media (image/video/SVG) + overlay colour/gradient render through the shared SGS_Container_Wrapper (D6, universal regardless of kind) — mapped by convention, not every bg sub-attr individually. Attribute names diverge from the default suffix convention (`direction`/`wrap`, not `flexDirection`/`flexWrap`) — every arrangement member is explicitly mapped per ROLLOUT REQUIREMENT 1."
				},
				"button": {
					"label": "Button",
					"order": 2,
					"clusters": [],
					"_note": "Buttons are native InnerBlocks children (`sgs/button`, the only entry in allowedBlocks), each with its own full text/fill/layout controls — this element documents that ownership; multi-button itself controls only the group's own arrangement (see `group`)."
				}
			}
		}
	},
	"attributes": {
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"backgroundImage": {
			"type": "object",
			"default": null
		},
		"backgroundImageTablet": {
			"type": "object"
		},
		"backgroundImageMobile": {
			"type": "object"
		},
		"backgroundSize": {
			"type": "string",
			"default": "cover",
			"enum": [
				"cover",
				"contain",
				"auto"
			]
		},
		"backgroundPosition": {
			"type": "string",
			"default": "center center"
		},
		"backgroundRepeat": {
			"type": "string",
			"default": "no-repeat",
			"enum": [
				"no-repeat",
				"repeat",
				"repeat-x",
				"repeat-y"
			]
		},
		"backgroundAttachment": {
			"type": "string",
			"default": "scroll",
			"enum": [
				"scroll",
				"fixed"
			]
		},
		"backgroundOverlayColour": {
			"type": "string"
		},
		"backgroundOverlayOpacity": {
			"type": "number",
			"default": 30
		},
		"backgroundOverlayOpacityTablet": {
			"type": "number"
		},
		"backgroundOverlayOpacityMobile": {
			"type": "number"
		},
		"overlayGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundOverlayColourHover": {
			"type": "string",
			"default": ""
		},
		"overlayGradientHover": {
			"type": "string",
			"default": ""
		},
		"backgroundOverlayBlendMode": {
			"type": "string",
			"default": "normal",
			"enum": [
				"normal",
				"multiply",
				"screen",
				"overlay",
				"darken",
				"lighten",
				"color-dodge",
				"color-burn",
				"soft-light",
				"hard-light",
				"difference",
				"exclusion"
			]
		},
		"bgVideo": {
			"type": "object"
		},
		"bgVideoTablet": {
			"type": "object"
		},
		"bgVideoMobile": {
			"type": "object"
		},
		"bgParallax": {
			"type": "boolean",
			"default": false
		},
		"bgKenBurns": {
			"type": "boolean",
			"default": false
		},
		"bgAnimationDuration": {
			"type": "number",
			"default": 20
		},
		"bgSvgContent": {
			"type": "string",
			"default": ""
		},
		"bgSvgPosition": {
			"type": "string",
			"default": "background",
			"enum": [
				"background",
				"foreground"
			]
		},
		"bgSvgAnimation": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"pulse",
				"float",
				"wave"
			]
		},
		"bgSvgAnimationSpeed": {
			"type": "string",
			"default": "medium",
			"enum": [
				"slow",
				"medium",
				"fast"
			]
		},
		"bgSvgOpacity": {
			"type": "number",
			"default": 100
		},
		"bgSvgMinHeight": {
			"type": "string",
			"default": ""
		},
		"bgSvgTextShadow": {
			"type": "boolean",
			"default": false
		},
		"childBtnBackground": {
			"type": "string",
			"default": "",
			"_comment": "A2 (D638 SS4/5) -- CSS custom-property GROUP DEFAULT for child sgs/button instances. Emitted as --sgs-mb-btn-bg-default on this block's own wrapper; button/style.css reads it as the second fallback tier of --sgs-btn-bg. Empty = no group default; buttons behave exactly as before."
		},
		"childBtnTextColour": {
			"type": "string",
			"default": ""
		},
		"childBtnBorderColour": {
			"type": "string",
			"default": ""
		},
		"childBtnBorderRadius": {
			"type": "string",
			"default": ""
		},
		"childBtnFontSize": {
			"type": "string",
			"default": ""
		},
		"childBtnFontWeight": {
			"type": "string",
			"default": ""
		},
		"flexDirection": {
			"type": "object",
			"default": {"desktop": "row", "mobile": "column"}
		},
		"gap": {
			"type": "object",
			"default": {"desktop": "12px", "mobile": "8px"}
		},
		"justifyContent": {
			"type": "object",
			"default": {"desktop": "flex-start"}
		},
		"flexWrap": {
			"type": "object",
			"default": {"desktop": "nowrap", "mobile": "nowrap"}
		},
		"alignItems": {
			"type": "object",
			"default": {"desktop": "center", "mobile": "stretch"}
		},
		"contentWidth": {
			"type": "object",
			"default": {}
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"alignContent": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end",
				"space-between",
				"space-around",
				"space-evenly"
			]
		},
		"columns": {
			"type": "object",
			"default": {"desktop": 2, "tablet": 2, "mobile": 1}
		},
		"gridAutoRows": {
			"type": "string",
			"default": ""
		},
		"gridTemplateColumns": {
			"type": "object",
			"default": {}
		},
		"gridTemplateRows": {
			"type": "object",
			"default": {}
		},
		"justifyItems": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end"
			]
		},
		"layout": {
			"type": "string",
			"default": ""
		},
		"templateMode": {
			"type": "string",
			"default": "free",
			"enum": [
				"free",
				"grid-section",
				"card-grid"
			]
		}
	},
	"example": {
		"attributes": {
			"direction": "row",
			"gap": "12px",
			"justifyContent": "flex-start"
		}
	}
}
