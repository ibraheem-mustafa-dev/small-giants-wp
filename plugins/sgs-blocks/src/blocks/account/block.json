{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/account",
	"version": "0.1.0",
	"title": "SGS Account",
	"category": "sgs-interactive",
	"description": "Wraps WooCommerce's My Account page: styled sidebar/tabs menu, a dashboard with a latest-order status card and quick-links, and side-by-side, stacked or tabbed logged-out log-in and register cards, and an optional signed-out card (Spec 27 Part 3, FR-30-14, FR-30-25).",
	"keywords": [
		"account",
		"my account",
		"woocommerce",
		"dashboard"
	],
	"textdomain": "sgs-blocks",
	"icon": "admin-users",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false
		},
		"sgs": {
			"motion": true,
			"specRef": "30",
			"elements": {
				"fieldInput": {
					"selector": ".sgs-account__wc form input.input-text",
					"motion": false,
					"label": "Account form fields",
					"order": 20,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"prefix": "field",
					"attrMap": {
						"css:background-color": "fieldBackground",
						"css:color": "fieldTextColour",
						"css:border-width": "fieldBorderWidth",
						"css:border-style": "fieldBorderStyle",
						"css:border-color": "fieldBorderColour",
						"css:border-radius": "fieldBorderRadius",
						"css:padding": "fieldPadding",
						"css:min-height": "fieldMinHeight",
						"css:font-size": "fieldFontSize",
						"css:line-height": "fieldLineHeight",
						"css:box-shadow": "fieldShadow",
						"css:box-shadow-color": "fieldShadowColour"
					},
					"_note": "WooCommerce's own log-in, register, lost-password, address and account-details inputs, selects and textareas, painted through includes/forms/field-own-style.php::field_own_style_css (the form's field* names) plus includes/account/helpers-account-field-css.php for padding, height, text colour and type."
				},
				"fieldPlaceholder": {
					"selector": ".sgs-account__wc form input.input-text::placeholder",
					"motion": false,
					"label": "Account field placeholder",
					"order": 21,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "fieldPlaceholderColour"
					}
				},
				"fieldLabel": {
					"selector": ".sgs-account__wc form label",
					"motion": false,
					"label": "Account field labels",
					"layer": "OUTER",
					"order": 22,
					"clusters": [
						"text",
						"layout"
					],
					"prefix": "label",
					"attrMap": {
						"css:color": "labelColour",
						"css:margin-bottom": "labelGap",
						"css:display": "labelPosition"
					},
					"_note": "The labels of WooCommerce's account forms. labelPosition above prints display:block and the label gap as margin-bottom; unset keeps WooCommerce's placement."
				},
				"order-thumbs": {
					"selector": ".sgs-account__order-thumbs",
					"motion": false,
					"label": "Latest-order thumbnails row",
					"order": 11,
					"clusters": [
						"layout"
					],
					"layer": "OUTER",
					"attrMap": {
						"css:flex-wrap": "orderThumbsFlexWrap"
					},
					"_note": "The latest-order thumbnails row: a flex row; the wrap setting chooses between one line and wrapping onto further rows."
				},
				"order-actions": {
					"selector": ".sgs-account__order-actions",
					"motion": false,
					"label": "Latest-order links row",
					"order": 12,
					"clusters": [
						"layout"
					],
					"layer": "OUTER",
					"attrMap": {
						"css:flex-wrap": "orderActionsFlexWrap"
					},
					"_note": "The latest-order links row: a flex row; the wrap setting chooses between one line and wrapping onto further rows."
				},
				"menuLink": {
					"selector": ".woocommerce-MyAccount-navigation-link:not(.is-active) > a",
					"_note": "WooCommerce's own menu markup: the links menuTextColour paints. The active link takes the menuActive colours, which beat hover, so the hoverable links are the others.",
					"motion": false,
					"label": "Menu links",
					"order": 1,
					"clusters": [
						"text"
					],
					"prefix": "menu",
					"attrMap": {
						"css:color": "menuTextColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "menuTextColourHover"
							}
						}
					}
				},
				"menuActive": {
					"state": "current",
					"motion": false,
					"label": "Active menu item",
					"order": 2,
					"clusters": [
						"text",
						"fill"
					],
					"attrMap": {
						"css:color": "menuActiveTextColour",
						"css:background-color": "menuActiveBackgroundColour",
						"css:background-image": "menuActiveBackgroundColourGradient"
					}
				},
				"menuIndicator": {
					"state": "current",
					"motion": false,
					"label": "Active menu item bar",
					"order": 3,
					"clusters": [
						"fill"
					],
					"attrMap": {
						"css:background-color": "menuActiveIndicatorColour",
						"css:background-image": "menuActiveIndicatorColourGradient"
					}
				},
				"heading": {
					"text": true,
					"label": "Headings",
					"order": 4,
					"clusters": [
						"text"
					],
					"prefix": "heading",
					"attrMap": {
						"css:color": "headingColour",
						"css:color-gradient": "headingColourGradient"
					}
				},
				"cardBox": {
					"selector": ".sgs-account__card",
					"label": "Cards",
					"order": 5,
					"clusters": [
						"fill",
						"layout"
					],
					"attrMap": {
						"css:background-color": "cardBackgroundColour",
						"css:background-image": "cardBackgroundColourGradient",
						"css:border-color": "cardBorderColour",
						"css:border-width": "cardBorderWidth",
						"css:border-style": "cardBorderStyle"
					}
				},
				"signed-out-actions": {
					"selector": ".sgs-account__signed-out-actions",
					"motion": false,
					"label": "Signed-out card buttons row",
					"order": 14,
					"clusters": [
						"layout"
					],
					"layer": "OUTER",
					"attrMap": {
						"css:flex-wrap": "signedOutActionsFlexWrap"
					},
					"_note": "The signed-out card's buttons row: a flex row; the wrap setting chooses between one line and wrapping onto further rows."
				},
				"auth-tabs": {
					"selector": ".sgs-account__auth-tabs",
					"motion": false,
					"label": "Sign-in tab list",
					"order": 17,
					"clusters": [
						"layout"
					],
					"layer": "OUTER",
					"attrMap": {
						"css:gap": "authTabGap",
						"css:margin-bottom": "authTabsSpaceBelow"
					},
					"_note": "The Sign in / Create account tab list (authLayout tabs): the space between the tabs and below them."
				},
				"auth-tab": {
					"selector": ".sgs-account__auth-tab",
					"motion": false,
					"label": "Sign-in tabs",
					"order": 18,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:min-height": "authTabMinHeight",
						"css:box-shadow": "authTabShadow",
						"css:box-shadow-color": "authTabShadowColour"
					},
					"_note": "Each tab takes the site's button presets for colour, radius, border and type; these are the height and the open tab's shadow."
				},
				"signed-out-button": {
					"selector": ".sgs-account__signed-out-actions .sgs-button",
					"motion": false,
					"label": "Signed-out card buttons",
					"order": 16,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:gap": "signedOutButtonGap",
						"css:min-height": "signedOutButtonMinHeight",
						"css:box-shadow": "signedOutButtonShadow",
						"css:box-shadow-color": "signedOutButtonShadowColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:box-shadow": "signedOutButtonShadowHover",
								"css:box-shadow-color": "signedOutButtonShadowColourHover"
							}
						}
					},
					"_note": "The card's two buttons are rendered by sgs/button, which paints these three values; their colours, radius, type and hover come from the site's button presets."
				},
				"signed-out-heading": {
					"selector": ".sgs-account__signed-out .sgs-account__signed-out-heading",
					"motion": false,
					"label": "Signed-out card heading",
					"order": 19,
					"clusters": [
						"text"
					],
					"prefix": "signedOutHeading",
					"_note": "The card's own heading type settings; unset, the heading takes the block's shared heading look."
				},
				"signedOutCopy": {
					"motion": false,
					"prefix": "signedOutCopy",
					"selector": ".sgs-account__signed-out .sgs-account__signed-out-copy",
					"label": "Signed-out card text",
					"order": 15,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "signedOutCopyColour"
					},
					"_note": "The signed-out card's paragraph. Its own type settings (signedOutCopy); unset, it takes the shared card-description look."
				},
				"signedOutCard": {
					"motion": false,
					"selector": ".sgs-account__auth-card",
					"label": "Sign-in card",
					"order": 13,
					"clusters": [
						"fill",
						"layout"
					],
					"attrMap": {
						"css:background-color": "signedOutCardBackgroundColour",
						"css:background-image": "signedOutCardBackgroundColourGradient",
						"css:border-color": "signedOutCardBorderColour",
						"css:border-width": "signedOutCardBorderWidth",
						"css:border-style": "signedOutCardBorderStyle",
						"css:border-radius": "signedOutCardBorderRadius",
						"css:box-shadow": "signedOutCardShadow",
						"css:box-shadow-color": "signedOutCardShadowColour",
						"css:padding": "signedOutCardPadding",
						"css:max-width": "signedOutCardMaxWidth",
						"css:gap": "signedOutCardGap"
					},
					"_note": "The card a signed-out visitor sees when signedOutView is card, and the card holding the sign-in tabs when authLayout is tabs. Its shadow is the signedOutCardShadow family (ShadowControl)."
				},
				"cardTitle": {
					"selector": ".sgs-account__card-title",
					"label": "Card titles",
					"order": 6,
					"clusters": [
						"text"
					],
					"prefix": "cardTitle",
					"_note": "Card titles share the headings colour (headingColour); only their typography is separate.",
					"absentIn": [ "logged-out" ],
					"absentWhy": "The card titles, status chip and order progress track print only on the logged-in dashboard (includes/account/templates/dashboard.php); a visitor sees the login form and the tracking card."
				},
				"chip": {
					"text": true,
					"label": "Status chip",
					"order": 7,
					"clusters": [
						"text",
						"fill"
					],
					"prefix": "chip",
					"attrMap": {
						"css:color": "chipTextColour",
						"css:background-color": "chipBackgroundColour",
						"css:background-image": "chipBackgroundColourGradient"
					},
					"absentIn": [ "logged-out" ],
					"absentWhy": "The card titles, status chip and order progress track print only on the logged-in dashboard (includes/account/templates/dashboard.php); a visitor sees the login form and the tracking card."
				},
				"track": {
					"selector": ".sgs-account__progress-step",
					"label": "Progress track",
					"order": 8,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:border-color": "trackColour"
					},
					"absentIn": [ "logged-out" ],
					"absentWhy": "The card titles, status chip and order progress track print only on the logged-in dashboard (includes/account/templates/dashboard.php); a visitor sees the login form and the tracking card."
				},
				"trackDone": {
					"motion": false,
					"label": "Progress track (completed)",
					"order": 9,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:border-color": "trackDoneColour"
					}
				},
				"contentLink": {
					"selector": ".sgs-account__wc a:not(nav *, .button, .wp-element-button, .sgs-account__quick-card)",
					"_note": "The links contentLinkColour paints: the account content's plain links, never the menu, buttons or quick cards.",
					"motion": false,
					"label": "Content links",
					"order": 10,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "contentLinkColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "contentLinkColourHover"
							}
						}
					}
				}
			}
		}
	},
	"attributes": {
		"fieldBackground": {
			"type": "string",
			"description": "Ground of the account forms' text inputs, selects and textareas: a palette slug or colour. Unset = the stylesheet's surface colour."
		},
		"fieldTextColour": {
			"type": "string",
			"description": "Text colour typed into the account forms' fields. Unset = the stylesheet's text colour."
		},
		"fieldPlaceholderColour": {
			"type": "string",
			"description": "Placeholder colour of the account forms' fields. Unset = the browser's placeholder colour."
		},
		"fieldBorderColour": {
			"type": "string",
			"description": "Resting border colour of the account forms' fields, via --sgs-field-edge-colour so the focus ring still wins. Unset = the stylesheet's border colour."
		},
		"fieldBorderWidth": {
			"type": "object",
			"description": "Field border width as a box {top,right,bottom,left}. Unset = the stylesheet's 1px."
		},
		"fieldBorderStyle": {
			"type": "string",
			"enum": [
				"",
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"description": "Field border style. Unset = solid when a width is set."
		},
		"fieldBorderRadius": {
			"type": "object",
			"description": "Field corner radius per device: {desktop,tablet,mobile}, each {topLeft,topRight,bottomRight,bottomLeft}. Unset = the stylesheet's 6px."
		},
		"fieldPadding": {
			"type": "object",
			"description": "Field padding per device: {desktop,tablet,mobile}, each a box {top,right,bottom,left}. Unset = the stylesheet's 0.5rem 0.75rem."
		},
		"fieldMinHeight": {
			"type": "object",
			"description": "Minimum height of the account forms' single-line fields (inputs and selects), per device: {desktop,tablet,mobile}, each a CSS length or a bare number of px. The value is the height, even below 44px. Unset = 44px."
		},
		"fieldShadow": {
			"type": "string",
			"description": "Field shadow: a preset slug or a CSS box-shadow value. Unset = none."
		},
		"fieldShadowColour": {
			"type": "string",
			"description": "Field shadow colour. Unset = the preset's own colour."
		},
		"labelColour": {
			"type": "string",
			"description": "Colour of the account forms' field labels. Unset = the stylesheet's text colour."
		},
		"labelPosition": {
			"type": "string",
			"enum": [
				"",
				"above"
			],
			"description": "Where a field's label sits. above = a block above the field with the label gap beneath it; unset = WooCommerce's own label placement."
		},
		"labelGap": {
			"type": "object",
			"description": "Space between a label and its field when the label sits above, per device: {desktop,tablet,mobile}, each a CSS length or a spacing preset. Unset = WooCommerce's own spacing."
		},
		"fieldFontSize": {
			"type": "object",
			"description": "Font size of the field text per device: {desktop,tablet,mobile}."
		},
		"fieldFontSizeUnit": {
			"type": "string",
			"description": "Unit of the field font size."
		},
		"fieldFontFamily": {
			"type": "string",
			"description": "Font family of the field text."
		},
		"fieldFontWeight": {
			"type": "string",
			"description": "Font weight of the field text."
		},
		"fieldFontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"description": "Font style of the field text."
		},
		"fieldLineHeight": {
			"type": "object",
			"description": "Line height of the field text per device: {desktop,tablet,mobile}."
		},
		"fieldLineHeightUnit": {
			"type": "string",
			"description": "Unit of the field line height ('' = unitless)."
		},
		"fieldLetterSpacing": {
			"type": "object",
			"description": "Letter spacing of the field text per device: {desktop,tablet,mobile}."
		},
		"fieldLetterSpacingUnit": {
			"type": "string",
			"description": "Unit of the field letter spacing."
		},
		"fieldTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"description": "Text transform of the field text."
		},
		"fieldTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"description": "Text decoration of the field text."
		},
		"labelFontSize": {
			"type": "object",
			"description": "Font size of the label text per device: {desktop,tablet,mobile}."
		},
		"labelFontSizeUnit": {
			"type": "string",
			"description": "Unit of the label font size."
		},
		"labelFontFamily": {
			"type": "string",
			"description": "Font family of the label text."
		},
		"labelFontWeight": {
			"type": "string",
			"description": "Font weight of the label text."
		},
		"labelFontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"description": "Font style of the label text."
		},
		"labelLineHeight": {
			"type": "object",
			"description": "Line height of the label text per device: {desktop,tablet,mobile}."
		},
		"labelLineHeightUnit": {
			"type": "string",
			"description": "Unit of the label line height ('' = unitless)."
		},
		"labelLetterSpacing": {
			"type": "object",
			"description": "Letter spacing of the label text per device: {desktop,tablet,mobile}."
		},
		"labelLetterSpacingUnit": {
			"type": "string",
			"description": "Unit of the label letter spacing."
		},
		"labelTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"description": "Text transform of the label text."
		},
		"labelTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"description": "Text decoration of the label text."
		},
		"orderThumbsFlexWrap": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"nowrap",
				"wrap"
			],
			"description": "Whether the product thumbnails on the latest-order card wrap onto further rows when they overrun the row. Empty keeps the stylesheet's own behaviour."
		},
		"orderActionsFlexWrap": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"nowrap",
				"wrap"
			],
			"description": "Whether the View order and Track parcel links on the latest-order card wrap onto further rows when they overrun the row. Empty keeps the stylesheet's own behaviour."
		},
		"navLayout": {
			"type": "object",
			"default": {}
		},
		"showMenuIcons": {
			"type": "boolean",
			"default": true
		},
		"navIcons": {
			"type": "object",
			"default": {}
		},
		"hiddenEndpoints": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string"
			}
		},
		"greeting": {
			"type": "string",
			"default": "Hello, {name}"
		},
		"showLatestOrder": {
			"type": "boolean",
			"default": true
		},
		"showQuickCards": {
			"type": "boolean",
			"default": true
		},
		"cardDescriptions": {
			"type": "object",
			"default": {}
		},
		"latestOrderHeading": {
			"type": "string",
			"default": "Your latest order"
		},
		"viewOrderLabel": {
			"type": "string",
			"default": "View order"
		},
		"parcelTrackingLabel": {
			"type": "string",
			"default": "Track parcel"
		},
		"noOrdersText": {
			"type": "string",
			"default": "You haven't placed an order yet."
		},
		"shopLinkLabel": {
			"type": "string",
			"default": "Start shopping"
		},
		"authLayout": {
			"type": "string",
			"default": "side-by-side"
		},
		"showOrderTracking": {
			"type": "boolean",
			"default": false
		},
		"orderTrackingHeading": {
			"type": "string",
			"default": "Track an order"
		},
		"showGuestLine": {
			"type": "boolean",
			"default": true
		},
		"guestLineText": {
			"type": "string",
			"default": "No account? You can check out as a guest."
		},
		"signedOutView": {
			"type": "string"
		},
		"signedOutHeading": {
			"type": "string",
			"role": "content"
		},
		"signedOutCopy": {
			"type": "string",
			"role": "content"
		},
		"signedOutSignInLabel": {
			"type": "string",
			"role": "content"
		},
		"signedOutSignInUrl": {
			"type": "string",
			"role": "content"
		},
		"signedOutSignInUrlSource": {
			"type": "string"
		},
		"signedOutRegisterLabel": {
			"type": "string",
			"role": "content"
		},
		"signedOutRegisterUrl": {
			"type": "string",
			"role": "content"
		},
		"signedOutRegisterUrlSource": {
			"type": "string"
		},
		"authTabSignInLabel": {
			"type": "string",
			"role": "content"
		},
		"authTabRegisterLabel": {
			"type": "string",
			"role": "content"
		},
		"signedOutHeadingFontSize": {
			"type": "number"
		},
		"signedOutHeadingFontSizeUnit": {
			"type": "string"
		},
