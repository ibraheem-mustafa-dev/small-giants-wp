{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/account",
	"version": "0.1.0",
	"title": "SGS Account",
	"category": "sgs-interactive",
	"description": "Wraps WooCommerce's My Account page: styled sidebar/tabs menu, a dashboard with a latest-order status card and quick-links, and side-by-side/stacked logged-out log-in and register cards (Spec 27 Part 3, FR-30-14).",
	"keywords": [
		"account",
		"my account",
		"woocommerce",
		"dashboard"
	],
	"textdomain": "sgs-blocks",
	"icon": "admin-users",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false
		},
		"sgs": {
			"specRef": "30",
			"elements": {
				"menuLink": {
					"label": "Menu links",
					"order": 1,
					"clusters": [
						"text"
					],
					"prefix": "menu",
					"attrMap": {
						"css:color": "menuTextColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "menuTextColourHover"
							}
						}
					}
				},
				"menuActive": {
					"label": "Active menu item",
					"order": 2,
					"clusters": [
						"text",
						"fill"
					],
					"attrMap": {
						"css:color": "menuActiveTextColour",
						"css:background-color": "menuActiveBackgroundColour",
						"css:background-image": "menuActiveBackgroundColourGradient"
					}
				},
				"menuIndicator": {
					"label": "Active menu item bar",
					"order": 3,
					"clusters": [
						"fill"
					],
					"attrMap": {
						"css:background-color": "menuActiveIndicatorColour",
						"css:background-image": "menuActiveIndicatorColourGradient"
					}
				},
				"heading": {
					"label": "Headings",
					"order": 4,
					"clusters": [
						"text"
					],
					"prefix": "heading",
					"attrMap": {
						"css:color": "headingColour",
						"css:color-gradient": "headingColourGradient"
					}
				},
				"cardBox": {
					"label": "Cards",
					"order": 5,
					"clusters": [
						"fill",
						"layout"
					],
					"attrMap": {
						"css:background-color": "cardBackgroundColour",
						"css:background-image": "cardBackgroundColourGradient",
						"css:border-color": "cardBorderColour",
						"css:border-width": "cardBorderWidth",
						"css:border-style": "cardBorderStyle"
					}
				},
				"cardTitle": {
					"label": "Card titles",
					"order": 6,
					"clusters": [
						"text"
					],
					"prefix": "cardTitle",
					"_note": "Card titles share the headings colour (headingColour); only their typography is separate."
				},
				"chip": {
					"label": "Status chip",
					"order": 7,
					"clusters": [
						"text",
						"fill"
					],
					"prefix": "chip",
					"attrMap": {
						"css:color": "chipTextColour",
						"css:background-color": "chipBackgroundColour",
						"css:background-image": "chipBackgroundColourGradient"
					}
				},
				"track": {
					"label": "Progress track",
					"order": 8,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:border-color": "trackColour"
					}
				},
				"trackDone": {
					"label": "Progress track (completed)",
					"order": 9,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:border-color": "trackDoneColour"
					}
				},
				"contentLink": {
					"label": "Content links",
					"order": 10,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "contentLinkColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "contentLinkColourHover"
							}
						}
					}
				}
			}
		}
	},
	"attributes": {
		"navLayout": {
			"type": "object",
			"default": {}
		},
		"showMenuIcons": {
			"type": "boolean",
			"default": true
		},
		"navIcons": {
			"type": "object",
			"default": {}
		},
		"hiddenEndpoints": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string"
			}
		},
		"greeting": {
			"type": "string",
			"default": "Hello, {name}"
		},
		"showLatestOrder": {
			"type": "boolean",
			"default": true
		},
		"showQuickCards": {
			"type": "boolean",
			"default": true
		},
		"cardDescriptions": {
			"type": "object",
			"default": {}
		},
		"latestOrderHeading": {
			"type": "string",
			"default": "Your latest order"
		},
		"viewOrderLabel": {
			"type": "string",
			"default": "View order"
		},
		"parcelTrackingLabel": {
			"type": "string",
			"default": "Track parcel"
		},
		"noOrdersText": {
			"type": "string",
			"default": "You haven't placed an order yet."
		},
		"shopLinkLabel": {
			"type": "string",
			"default": "Start shopping"
		},
		"authLayout": {
			"type": "string",
			"default": "side-by-side"
		},
		"showOrderTracking": {
			"type": "boolean",
			"default": false
		},
		"orderTrackingHeading": {
			"type": "string",
			"default": "Track an order"
		},
		"showGuestLine": {
			"type": "boolean",
			"default": true
		},
		"guestLineText": {
			"type": "string",
			"default": "No account? You can check out as a guest."
		},
		"statusStepLabels": {
			"type": "object",
			"default": {}
		},
		"menuTextColour": {
			"type": "string",
			"default": ""
		},
		"menuTextColourHover": {
			"type": "string",
			"default": ""
		},
		"menuActiveTextColour": {
			"type": "string",
			"default": ""
		},
		"menuActiveIndicatorColour": {
			"type": "string",
			"default": ""
		},
		"menuActiveIndicatorColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the active menu item bar instead of a flat colour. Non-empty wins over menuActiveIndicatorColour at render time."
		},
		"menuActiveBackgroundColour": {
			"type": "string",
			"default": ""
		},
		"menuActiveBackgroundColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the active menu item background instead of a flat colour. Non-empty wins over menuActiveBackgroundColour at render time."
		},
		"cardBackgroundColour": {
			"type": "string",
			"default": ""
		},
		"cardBackgroundColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the card background instead of a flat colour. Non-empty wins over cardBackgroundColour at render time."
		},
		"cardBorderColour": {
			"type": "string",
			"default": ""
		},
		"cardBorderWidth": {
			"type": "object",
			"default": {}
		},
		"cardBorderStyle": {
			"type": "string",
			"default": "solid"
		},
		"headingColour": {
			"type": "string",
			"default": ""
		},
		"headingColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the heading and card title text instead of a flat colour. Non-empty wins over headingColour at render time."
		},
		"contentLinkColour": {
			"type": "string",
			"default": ""
