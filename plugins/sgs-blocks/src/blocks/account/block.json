		"cardTitleTextDecoration": {
			"type": "string",
			"default": ""
		},
		"cardTitleTextAlign": {
			"type": "string",
			"default": ""
		},
		"cardTitleTextWrap": {
			"type": "string",
			"default": ""
		},
		"navWidth": {
			"type": "object",
			"default": {}
		},
		"gap": {
			"type": "object",
			"default": {}
		},
		"contentMaxWidth": {
			"type": "object",
			"default": {}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
