{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/quote",
	"version": "0.3.0",
	"title": "Quote",
	"category": "sgs-content",
	"description": "Attributed blockquote — body paragraphs are native InnerBlocks children (mirrors core/quote) and attribution is an optional footer/cite/div string. Emits semantic <blockquote> so converter-pipeline outputs preserve the correct HTML5 structure.",
	"keywords": [
		"quote",
		"blockquote",
		"attribution",
		"pullquote",
		"testimonial"
	],
	"textdomain": "sgs-blocks",
	"icon": "format-quote",
	"render": "file:./render.php",
	"supports": {
		"sgs": {
			"scalarStylingLift": true,
			"elements": {
				"box": {
					"label": "Quote box",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:background-image": "backgroundColourGradient",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:max-width": "maxWidth",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:box-shadow": "boxShadow",
						"css:border-color-gradient": "borderColourGradient",
						"css:box-shadow-color": "boxShadowColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:background-color": "backgroundColourHover",
								"css:background-image": "backgroundColourHoverGradient",
								"css:box-shadow": "boxShadowHover",
								"css:box-shadow-color": "boxShadowHoverColour",
								"css:border-color": "borderColourHover",
								"css:color": "textColourHover",
								"css:color-gradient": "textColourHoverGradient"
							}
						}
					}
				},
				"quote-body": {
					"label": "Quote text",
					"order": 2,
					"clusters": [],
					"_note": "Body paragraphs are native InnerBlocks children (mirrors core/quote) — each child carries its own typography inspector, so this block declares no text cluster for them. The root's native typography.fontSize/lineHeight are wrapper-level inherited defaults, not a per-element control set."
				},
				"attribution": {
					"label": "Attribution",
					"order": 3,
					"clusters": [
						"text",
						"layout"
					],
					"prefix": "attribution",
					"attrMap": {
						"css:color": "attributionColour",
						"css:color-gradient": "attributionColourGradient",
						"css:margin-top": "attributionMarginTop"
					},
					"_note": "attributionMarginTop/attributionMarginTopTablet/attributionMarginTopMobile (render.php:290-313, `'css' => 'margin-top'`) resolve via the new css:margin-top layout member (Spec 35 vocabulary fix). attributionMarginUnit is a companion unit-selector for the margin-top value (not an independent CSS property) — left unmapped; its literal name does not reduce to the attributionMarginTop base under the checker's Unit-suffix-stripping convention, a naming-shape mismatch outside this fix's scope."
				}
			},
			"boxFamilies": {
				"borderWidth": [
					"borderWidth"
				],
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				],
				"borderRadius": [
					"borderRadius"
				]
			}
		},
		"anchor": true,
		"className": true,
		"html": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalSkipSerialization": true
		}
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"attribution": {
			"type": "string",
			"default": ""
		},
		"attributionTag": {
			"type": "string",
			"enum": [
				"footer",
				"div",
				"cite"
			],
			"default": "footer"
		},
		"attributionEnabled": {
			"type": "boolean",
			"default": true
		},
		"attributionColour": {
			"type": "string",
			"default": ""
		},
		"attributionColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the attribution element's text via background-clip:text (D636 text builder). Non-empty wins over attributionColour."
		},
		"attributionFontSize": {
			"type": "object",
			"default": {}
		},
		"attributionFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"attributionFontWeight": {
			"type": "string",
			"default": ""
		},
		"attributionFontFamily": {
			"type": "string",
			"default": ""
		},
		"attributionFontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"default": ""
		},
		"attributionTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through",
				"overline"
			],
			"default": ""
		},
		"attributionTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"attributionLineHeight": {
			"type": "number"
		},
		"attributionLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"attributionMarginTop": {
			"type": "object",
			"default": {}
		},
		"attributionMarginUnit": {
			"type": "string",
			"default": "px"
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the quote box's border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"boxShadow": {
			"type": "string",
			"default": ""
		},
		"boxShadowHover": {
			"type": "string",
			"default": ""
		},
		"boxShadowColour": {
			"type": "string",
			"default": ""
		},
		"boxShadowHoverColour": {
			"type": "string",
			"default": ""
		},
		"scaleHover": {
			"type": "number"
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the quote box's hover-state text with a background-clip:text mechanism instead of a flat colour (D636 text-colour gradient rollout). Non-empty wins over textColourHover. Safe on this selector because the root's background paint is routed onto a `::after` layer (D936)."
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"inheritStyle": {
			"type": "boolean",
			"default": false
		},
		"transitionDuration": {
			"type": "string",
			"default": "300"
		},
		"transitionEasing": {
			"type": "string",
			"default": "ease-in-out"
		},
		"borderColourHover": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"example": {
		"attributes": {
			"attribution": "â€” Jane Smith, Customer",
			"attributionColour": "primary",
			"style": {
				"spacing": {
					"padding": {
						"top": "24px",
						"right": "24px",
						"bottom": "24px",
						"left": "24px"
					}
				}
			}
		},
		"innerBlocks": [
			{
				"name": "sgs/text",
				"attributes": {
					"text": "A great quotation block lets your content speak for itself."
				}
			},
			{
				"name": "sgs/text",
				"attributes": {
					"text": "Place the source's words here for emphasis and credibility."
				}
			}
		]
	}
}
