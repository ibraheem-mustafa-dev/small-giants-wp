{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/counter",
	"version": "0.2.1",
	"title": "SGS Counter",
	"category": "sgs-content",
	"description": "Animated number counter with prefix, suffix, and label.",
	"keywords": [
		"counter",
		"number",
		"stat",
		"animated",
		"count"
	],
	"textdomain": "sgs-blocks",
	"icon": "chart-bar",
	"supports": {
		"sgs": {
			"iconPicker": true,
			"scalarStylingLift": true,
			"boxFamilies": {
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				],
				"borderRadius": [
					"borderRadius"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Counter box",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:background-color": "native:color.background",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:border-color-gradient": "borderColourGradient"
					}
				},
				"number": {
					"label": "Number",
					"order": 2,
					"clusters": [
						"text",
						"fill"
					],
					"prefix": "number",
					"attrMap": {
						"css:font-size": "native:typography.fontSize",
						"css:line-height": "native:typography.lineHeight",
						"css:background-image": "numberColourGradient"
					},
					"_note": "selectors.typography targets .sgs-counter__number, so the block-level typography.fontSize/lineHeight supports serialise onto this element specifically, not the wrapper — unlike quote's root-level inherited-default case. numberColourGradient (D636 Task 1b) is the text-colour gradient sibling to numberColour — background-clip:text mechanism."
				},
				"label": {
					"label": "Label",
					"order": 3,
					"clusters": [
						"text"
					],
					"prefix": "label",
					"attrMap": {
						"css:background-image": "labelColourGradient"
					},
					"_note": "labelColourGradient is the text-colour gradient sibling to labelColour, same background-clip:text mechanism as the number element's numberColourGradient (D636 Task 1b). Finishes the text-colour gradient rollout 778879732 started and explicitly left open."
				},
				"icon": {
					"label": "Icon",
					"order": 4,
					"clusters": [],
					"_note": "The icon attribute is a bare slug with no colour/size control of its own — no Text/Fill/Layout member applies. accentStroke was adjudicated 2026-07-19 as a decoration toggle (an accent underline), not a paint/stroke style property, so it maps to no cluster member either."
				}
			}
		},
		"align": false,
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"link": false,
			"__experimentalSkipSerialization": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalSkipSerialization": true
		},
		"interactivity": true
	},
	"selectors": {
		"root": ".sgs-counter",
		"typography": ".sgs-counter__number"
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"number": {
			"type": "number",
			"default": 0
		},
		"prefix": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"suffix": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"duration": {
			"type": "number",
			"default": 2000
		},
		"separator": {
			"type": "boolean",
			"default": true
		},
		"numberColour": {
			"type": "string",
			"default": "primary"
		},
		"numberColourGradient": {
			"type": "string",
			"default": ""
		},
		"labelColour": {
			"type": "string",
			"default": "text-muted"
		},
		"labelColourGradient": {
			"type": "string",
			"default": ""
		},
		"labelFontSize": {
			"type": "object",
			"default": {}
		},
		"labelFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"labelFontWeight": {
			"type": "string",
			"default": ""
		},
		"labelFontStyle": {
			"type": "string",
			"default": ""
		},
		"labelLineHeight": {
			"type": "number"
		},
		"labelLineHeightUnit": {
			"type": "string",
			"default": ""
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"accentStroke": {
			"type": "boolean",
			"default": false
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"number": 5000,
			"prefix": "",
			"suffix": "+",
			"label": "Happy Customers"
		}
	}
}
