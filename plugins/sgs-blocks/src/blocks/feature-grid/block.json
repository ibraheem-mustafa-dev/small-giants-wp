{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/feature-grid",
	"version": "0.3.0",
	"title": "SGS Feature Grid",
	"category": "sgs-layout",
	"description": "A responsive grid container for SGS Info Boxes. Default: fixed responsive columns (4-up on desktop) rendered by the shared container grid engine. Auto-flex (auto-fill wrap by min item width) is an opt-in layout mode.",
	"keywords": [
		"feature grid",
		"info box grid",
		"card grid",
		"ingredients"
	],
	"textdomain": "sgs-blocks",
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": false,
			"text": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "layout",
			"elements": {
				"grid": {
					"label": "Grid",
					"layer": "OUTER",
					"_layer_note": "This element is both the block root and the grid definition (child sgs/info-box items). layer_detect.py's MF-3 guard makes the root OUTER regardless of its own display:grid.",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:color": "textColour",
						"css:padding": "native:spacing.padding",
						"css:margin": "native:spacing.margin",
						"css:max-width": "maxWidth",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:gap": "gap",
						"css:grid-template-columns": "gridTemplateColumns",
						"css:grid-template-rows": "gridTemplateRows",
						"css:grid-auto-rows": "gridAutoRows",
						"css:justify-items": "justifyItems",
						"css:justify-content": "justifyContent",
						"css:align-content": "alignContent",
						"css:align-items": "alignItems",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap",
						"css:border-color-gradient": "borderColourGradient",
						"css:background-image": "textColourGradient"
					},
					"_note": "No `display`/`order`/`overflow` attribute exists on this block — honest GAPs. Children are sgs/info-box InnerBlocks (allowedBlocks) which own their own typography/fill — this block declares no per-item element."
				}
			},
			"boxFamilies": {
				"borderRadius": [
					"borderRadius"
				]
			}
		}
	},
	"allowedBlocks": [
		"sgs/info-box"
	],
	"attributes": {
		"layoutMode": {
			"type": "string",
			"default": "fixed-columns"
		},
		"minItemWidth": {
			"type": "number",
			"default": 240
		},
		"minItemWidthUnit": {
			"type": "string",
			"default": "px"
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": "24px",
				"mobile": "16px"
			}
		},
		"_comment_gap_unit": "gapUnit retired 2026-06-07 — gap now stores a full CSS value (e.g. '24px') resolved by sgs_container_gap_value(). No migration path for existing posts — deprecations were deleted plugin-wide at D271/D293 (pre-production policy).",
		"alignItems": {
			"type": "string",
			"default": "stretch"
		},
		"justifyItems": {
			"type": "string",
			"default": "stretch"
		},
		"contentWidth": {
			"type": "object",
			"default": {}
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"layout": {
			"type": "string",
			"enum": [
				"",
				"flex",
				"stack",
				"grid"
			],
			"default": ""
		},
		"gridTemplateColumns": {
			"type": "object",
			"default": {}
		},
		"gridTemplateRows": {
			"type": "object",
			"default": {}
		},
		"gridAutoRows": {
			"type": "string",
			"default": ""
		},
		"flexDirection": {
			"type": "string",
			"default": ""
		},
		"flexWrap": {
			"type": "string",
			"default": "wrap"
		},
		"justifyContent": {
			"type": "string",
			"default": ""
		},
		"alignContent": {
			"type": "string",
			"default": ""
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 2,
				"tablet": 2,
				"mobile": 1
			}
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"example": {
		"attributes": {
			"layoutMode": "fixed-columns",
			"columns": {
				"desktop": 4
			},
			"gap": 24
		}
	}
}
