{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/wishlist-panel",
	"version": "0.1.0",
	"title": "SGS Wishlist Panel",
	"category": "sgs-interactive",
	"description": "The saved-items panel: every product on the visitor's wishlist, with Move to basket / Notify me / Remove. Lives on the cart page by default (Wave 3C U-12 §E, the two-tier wishlist).",
	"keywords": [
		"wishlist",
		"saved for later",
		"favourites"
	],
	"textdomain": "sgs-blocks",
	"icon": "heart",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"sgs": {
			"elements": {
				"heading": {
					"label": "Heading",
					"order": 1,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "headingColour"
					}
				},
				"itemName": {
					"label": "Item name",
					"order": 2,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "itemNameColour"
					}
				},
				"price": {
					"label": "Price",
					"order": 3,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "priceColour"
					}
				},
				"button": {
					"label": "Move to basket button",
					"order": 4,
					"clusters": [
						"fill",
						"text"
					],
					"attrMap": {
						"css:background-color": "buttonBackgroundColour",
						"css:color": "buttonTextColour"
					}
				},
				"link": {
					"label": "Remove / notify link",
					"order": 5,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "linkColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "linkColourHover"
							}
						}
					}
				},
				"priceDrop": {
					"label": "Price drop text",
					"order": 6,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "priceDropColour"
					}
				},
				"stockChip": {
					"label": "Stock chip",
					"order": 7,
					"clusters": [
						"fill",
						"text"
					],
					"attrMap": {
						"css:background-color": "stockChipBackgroundColour",
						"css:color": "stockChipTextColour"
					}
				},
				"bar": {
					"label": "Guest prompt / alerts bar background",
					"order": 8,
					"clusters": [
						"fill"
					],
					"attrMap": {
						"css:background-color": "barBackgroundColour"
					}
				},
				"shareField": {
					"label": "Share link field",
					"order": 9,
					"clusters": [
						"fill",
						"text"
					],
					"attrMap": {
						"css:background-color": "shareFieldBackgroundColour",
						"css:color": "shareFieldTextColour"
					}
				}
			}
		}
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Saved for later"
		},
		"emptyText": {
			"type": "string",
			"default": "Your wishlist is empty."
		},
		"emptyLinkLabel": {
			"type": "string",
			"default": "Continue shopping"
		},
		"showWhenEmpty": {
			"type": "boolean",
			"default": false
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"showStock": {
			"type": "boolean",
			"default": true
		},
		"columns": {
			"type": "object",
			"default": {}
		},
		"gap": {
			"type": "object",
			"default": {}
		},
		"layout": {
			"type": "string",
			"enum": [ "grid", "list", "strip" ],
			"default": "grid"
		},
		"maxItems": {
			"type": "number",
			"default": 0
		},
		"viewAllLabel": {
			"type": "string",
			"default": "View all saved items"
		},
		"viewAllUrl": {
			"type": "string",
			"default": ""
		},
		"showCount": {
			"type": "boolean",
			"default": true
		},
		"showSort": {
			"type": "boolean",
			"default": true
		},
		"sortLabel": {
			"type": "string",
			"default": "Sort"
		},
		"sortRecentLabel": {
			"type": "string",
			"default": "Recently saved"
		},
		"sortPriceAscLabel": {
			"type": "string",
			"default": "Price, low to high"
		},
		"sortPriceDescLabel": {
			"type": "string",
			"default": "Price, high to low"
		},
		"sortStockLabel": {
			"type": "string",
			"default": "In stock first"
		},
		"showDateSaved": {
			"type": "boolean",
			"default": true
		},
		"dateSavedText": {
			"type": "string",
			"default": "Saved {date}"
		},
		"showPriceDrop": {
			"type": "boolean",
			"default": true
		},
		"priceDropText": {
			"type": "string",
			"default": "Price drop: now {now} ({saved} when you saved it)"
		},
		"moveLabel": {
			"type": "string",
			"default": "Move to basket"
		},
		"removeLabel": {
			"type": "string",
			"default": "Remove"
		},
		"notifyLabel": {
			"type": "string",
			"default": "Notify me"
		},
		"outOfStockLabel": {
			"type": "string",
			"default": "Out of stock"
		},
		"notifyEmailLabel": {
			"type": "string",
			"default": "Your email"
		},
		"notifyConsentText": {
			"type": "string",
			"default": "Email me when this item is back in stock."
		},
		"notifySuccessText": {
			"type": "string",
			"default": "We'll email you when this is back in stock."
		},
		"errorText": {
			"type": "string",
			"default": "Something went wrong. Please try again."
		},
		"showGuestPrompt": {
			"type": "boolean",
			"default": true
		},
		"guestPromptText": {
			"type": "string",
			"default": "Sign in to keep your saved items on every device and get price alerts."
		},
		"signInLabel": {
			"type": "string",
			"default": "Sign in"
		},
		"alertsPriceLabel": {
			"type": "string",
			"default": "Email me when a saved item drops in price"
		},
		"alertsStockLabel": {
			"type": "string",
			"default": "Email me when a saved item is back in stock"
		},
		"shareLabel": {
			"type": "string",
			"default": "Share my list"
		},
		"shareCopyLabel": {
			"type": "string",
			"default": "Copy link"
		},
		"shareCopiedText": {
			"type": "string",
			"default": "Link copied"
		},
		"shareNewLinkLabel": {
			"type": "string",
			"default": "Make a new link"
		},
		"sharedHeading": {
			"type": "string",
			"default": "A saved list"
		},
		"addToMineLabel": {
			"type": "string",
			"default": "Save to my list"
		},
		"sharedGoneText": {
			"type": "string",
			"default": "This saved list is no longer shared."
		},
		"privacyLinkLabel": {
			"type": "string",
			"default": "Privacy policy"
		},
		"headingColour": {
			"type": "string",
			"default": ""
		},
		"itemNameColour": {
			"type": "string",
			"default": ""
		},
		"priceColour": {
			"type": "string",
			"default": ""
		},
		"buttonBackgroundColour": {
			"type": "string",
			"default": ""
		},
		"buttonTextColour": {
			"type": "string",
			"default": ""
		},
		"linkColour": {
			"type": "string",
			"default": ""
		},
		"linkColourHover": {
			"type": "string",
			"default": ""
		},
		"priceDropColour": {
			"type": "string",
			"default": ""
		},
		"stockChipBackgroundColour": {
			"type": "string",
			"default": ""
		},
		"stockChipTextColour": {
			"type": "string",
			"default": ""
		},
		"barBackgroundColour": {
			"type": "string",
			"default": ""
		},
		"shareFieldBackgroundColour": {
			"type": "string",
			"default": ""
		},
		"shareFieldTextColour": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
