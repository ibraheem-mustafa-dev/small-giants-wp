{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/wishlist-panel",
	"version": "0.1.0",
	"title": "SGS Wishlist Panel",
	"category": "sgs-interactive",
	"description": "The saved-items panel: every product on the visitor's wishlist, with Move to basket / Notify me / Remove. Lives on the cart page by default (Wave 3C U-12 §E, the two-tier wishlist).",
	"keywords": [
		"wishlist",
		"saved for later",
		"favourites"
	],
	"textdomain": "sgs-blocks",
	"icon": "heart",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"sgs": {
			"boxFamilies": {
				"margin": [
					"margin"
				]
			},
			"elements": {
				"heading": {
					"label": "Heading",
					"order": 1,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "headingColour"
					}
				},
				"itemName": {
					"label": "Item name",
					"order": 2,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "itemNameColour"
					}
				},
				"price": {
					"label": "Price",
					"order": 3,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "priceColour"
					}
				},
				"stock": {
					"label": "Stock status",
					"order": 4,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "stockColour"
					}
				},
				"button": {
					"label": "Move to basket button",
					"order": 5,
					"clusters": [
						"fill",
						"text"
					],
					"attrMap": {
						"css:background-color": "buttonBackgroundColour",
						"css:color": "buttonTextColour"
					}
				},
				"link": {
					"label": "Remove / notify link",
					"order": 6,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:color": "linkColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "linkColourHover"
							}
						}
					}
				}
			}
		}
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Saved for later"
		},
		"emptyText": {
			"type": "string",
			"default": "Your wishlist is empty."
		},
		"emptyLinkLabel": {
			"type": "string",
			"default": "Continue shopping"
		},
		"showWhenEmpty": {
			"type": "boolean",
			"default": false
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"showStock": {
			"type": "boolean",
			"default": true
		},
		"columns": {
			"type": "object",
			"default": {}
		},
		"gap": {
			"type": "object",
			"default": {}
		},
		"headingColour": {
			"type": "string",
			"default": ""
		},
		"itemNameColour": {
			"type": "string",
			"default": ""
		},
		"priceColour": {
			"type": "string",
			"default": ""
		},
		"stockColour": {
			"type": "string",
			"default": ""
		},
		"buttonBackgroundColour": {
			"type": "string",
			"default": ""
		},
		"buttonTextColour": {
			"type": "string",
			"default": ""
		},
		"linkColour": {
			"type": "string",
			"default": ""
		},
		"linkColourHover": {
			"type": "string",
			"default": ""
		},
		"margin": {
			"type": "object",
			"default": {}
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
