{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/site-footer",
	"version": "0.1.0",
	"title": "SGS Site Footer",
	"category": "sgs-layout",
	"icon": "align-full-width",
	"description": "The site footer shell — stacked optional rows (top / columns / bottom bar) of footer elements. Each row is an intrinsic never-overflow cluster or column grid, so the footer never overflows the viewport at any width. Lives inside the footer template part.",
	"keywords": [
		"site footer",
		"footer",
		"colophon",
		"contentinfo"
	],
	"textdomain": "sgs-blocks",
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"reusable": false,
		"align": [
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "section",
			"hideExtensions": [
				"fx"
			],
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				]
			}
		}
	},
	"allowedBlocks": [
		"sgs/site-footer-row"
	],
	"attributes": {
		"maxWidth": {
			"type": "string",
			"default": ""
		},
		"maxWidthTablet": {
			"type": "string",
			"default": ""
		},
		"maxWidthMobile": {
			"type": "string",
			"default": ""
		},
		"contentWidth": {
			"type": "string",
			"default": "full"
		},
		"contentWidthTablet": {
			"type": "string",
			"default": ""
		},
		"contentWidthMobile": {
			"type": "string",
			"default": ""
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
