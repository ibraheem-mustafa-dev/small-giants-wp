{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/site-footer",
	"version": "0.1.0",
	"title": "SGS Site Footer",
	"category": "sgs-layout",
	"icon": "align-full-width",
	"description": "The site footer shell — stacked optional rows (top / columns / bottom bar) of footer elements. Each row is an intrinsic never-overflow cluster or column grid, so the footer never overflows the viewport at any width. Lives inside the footer template part.",
	"keywords": [
		"site footer",
		"footer",
		"colophon",
		"contentinfo"
	],
	"textdomain": "sgs-blocks",
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"reusable": false,
		"align": [
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "section",
			"hideExtensions": [
				"fx"
			],
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Section wrapper",
					"layer": "OUTER",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout",
						"animation"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "native:color.text",
						"css:background-color": "native:color.background",
						"css:padding": "native:spacing.padding",
						"css:margin": "native:spacing.margin",
						"css:border-width": "native:__experimentalBorder.width",
						"css:border-style": "native:__experimentalBorder.style",
						"css:border-color": "native:__experimentalBorder.color",
						"css:border-radius": "native:__experimentalBorder.radius",
						"css:max-width": "maxWidth",
						"css:min-height": "minHeight",
						"css:box-shadow": "shadow",
						"css:background-attachment": "backgroundAttachment",
						"css:background-position": "backgroundPosition",
						"css:background-repeat": "backgroundRepeat",
						"css:background-size": "backgroundSize",
						"anim:parallax": "bgParallax",
						"anim:duration": "bgAnimationDuration"
					},
					"_note": "The rendered <footer>/<div> element (containerKind=section, rendered through SGS_Container_Wrapper per the composite-mirror rule R-31-9). Colour/spacing/border ride the native supports, all serialised SCOPED via __experimentalSkipSerialization (Spec 32). The typography members are honest GAPs: this block declares no `supports.typography` and no font-* attributes. anim:preset/easing/stagger/trigger are honest GAPs too (no sgsAnimation*/stagger attributes); bgKenBurns is a Ken-Burns preset toggle with no animation-cluster member, so it stays unmapped exactly as on sgs/container."
				},
				"grid": {
					"label": "Grid / flex layout",
					"layer": "GRID",
					"order": 2,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:gap": "gap",
						"css:grid-template-columns": "columns",
						"css:justify-content": "justifyContent",
						"css:align-content": "alignContent",
						"css:align-items": "verticalAlign",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap"
					},
					"_note": "Arrangement members map explicitly because this element declares no `prefix`. css:grid-template-columns maps to the `columns` COUNT attribute (SGS_Container_Wrapper expands it to repeat(N,1fr)) — this block has no explicit gridTemplateColumns ratio attribute, unlike sgs/container. css:align-items maps to `verticalAlign` (class-sgs-container-wrapper.php:247 reads verticalAlign||alignItems). display / justify-items / order / overflow / grid-template-rows / grid-auto-rows have no attribute on this block and remain honest GAPs."
				},
				"content-band": {
					"label": "Content band",
					"layer": "CONTENT",
					"order": 3,
					"clusters": [
						"fill",
						"layout"
					],
					"prefix": "contentBand",
					"attrMap": {
						"css:background-color": "contentBandBackground",
						"css:width": "contentWidth"
					}
				},
				"decorative": {
					"label": "Decorative background",
					"order": 4,
					"clusters": [],
					"_note": "Background image/video (backgroundImage*/bgVideo*), background SVG (bgSvg*), overlay gradient (overlayGradient*/backgroundOverlay*), Ken Burns, and shape dividers (shapeDivider*) are governed by dedicated controls outside the Text/Fill/Layout style clusters, so this element declares none. Mirrors sgs/container's `decorative` element."
				}
			}
		}
	},
	"allowedBlocks": [
		"sgs/site-footer-row"
	],
	"attributes": {
		"maxWidth": {
			"type": "string",
			"default": ""
		},
		"maxWidthTablet": {
			"type": "string",
			"default": ""
		},
		"maxWidthMobile": {
			"type": "string",
			"default": ""
		},
		"contentWidth": {
			"type": "string",
			"default": "full"
		},
		"contentWidthTablet": {
			"type": "string",
			"default": ""
		},
		"contentWidthMobile": {
			"type": "string",
			"default": ""
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		},
		"alignContent": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end",
				"space-between",
				"space-around",
				"space-evenly"
			]
		},
		"backgroundAttachment": {
			"type": "string",
			"default": "scroll",
			"enum": [
				"scroll",
				"fixed"
			]
		},
		"backgroundImage": {
			"type": "object"
		},
		"backgroundImageMobile": {
			"type": "object"
		},
		"backgroundImageTablet": {
			"type": "object"
		},
		"backgroundOverlayColour": {
			"type": "string"
		},
		"backgroundOverlayOpacity": {
			"type": "number",
			"default": 50
		},
		"backgroundPosition": {
			"type": "string",
			"default": "center center"
		},
		"backgroundRepeat": {
			"type": "string",
			"default": "no-repeat",
			"enum": [
				"no-repeat",
				"repeat",
				"repeat-x",
				"repeat-y"
			]
		},
		"backgroundSize": {
			"type": "string",
			"default": "cover",
			"enum": [
				"cover",
				"contain",
				"auto"
			]
		},
		"bgAnimationDuration": {
			"type": "number",
			"default": 20
		},
		"bgKenBurns": {
			"type": "boolean",
			"default": false
		},
		"bgParallax": {
			"type": "boolean",
			"default": false
		},
		"bgSvgAnimation": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"pulse",
				"float",
				"wave"
			]
		},
		"bgSvgAnimationSpeed": {
			"type": "string",
			"default": "medium",
			"enum": [
				"slow",
				"medium",
				"fast"
			]
		},
		"bgSvgContent": {
			"type": "string",
			"default": ""
		},
		"bgSvgMinHeight": {
			"type": "string",
			"default": ""
		},
		"bgSvgOpacity": {
			"type": "number",
			"default": 100
		},
		"bgSvgPosition": {
			"type": "string",
			"default": "background",
			"enum": [
				"background",
				"foreground"
			]
		},
		"bgSvgTextShadow": {
			"type": "boolean",
			"default": false
		},
		"bgVideo": {
			"type": "object"
		},
		"bgVideoTablet": {
			"type": "object"
		},
		"bgVideoMobile": {
			"type": "object"
		},
		"columns": {
			"type": "number",
			"default": 2
		},
		"columnsMobile": {
			"type": "number",
			"default": 1
		},
		"columnsTablet": {
			"type": "number",
			"default": 2
		},
		"contentBandBackground": {
			"type": "string",
			"default": ""
		},
		"contentBandPadding": {
			"type": "object",
			"default": {}
		},
		"contentBandPaddingMobile": {
			"type": "object",
			"default": {}
		},
		"contentBandPaddingTablet": {
			"type": "object",
			"default": {}
		},
		"flexDirection": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"row",
				"row-reverse",
				"column",
				"column-reverse"
			]
		},
		"flexWrap": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"wrap-reverse"
			]
		},
		"gap": {
			"type": "string",
			"default": ""
		},
		"gapMobile": {
			"type": "string",
			"default": ""
		},
		"gapTablet": {
			"type": "string",
			"default": ""
		},
		"justifyContent": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"flex-start",
				"center",
				"flex-end",
				"space-between",
				"space-around",
				"space-evenly"
			]
		},
		"minHeight": {
			"type": "string"
		},
		"minHeightMobile": {
			"type": "string",
			"default": ""
		},
		"minHeightTablet": {
			"type": "string",
			"default": ""
		},
		"overlayGradient": {
			"type": "boolean",
			"default": false
		},
		"overlayGradientAngle": {
			"type": "number",
			"default": 180
		},
		"overlayGradientFrom": {
			"type": "string",
			"default": ""
		},
		"overlayGradientTo": {
			"type": "string",
			"default": ""
		},
		"shadow": {
			"type": "string"
		},
		"shapeDividerBottom": {
			"type": "string",
			"default": ""
		},
		"shapeDividerBottomColour": {
			"type": "string",
			"default": ""
		},
		"shapeDividerBottomFlip": {
			"type": "boolean",
			"default": false
		},
		"shapeDividerBottomHeight": {
			"type": "number",
			"default": 80
		},
		"shapeDividerBottomInvert": {
			"type": "boolean",
			"default": false
		},
		"shapeDividerTop": {
			"type": "string",
			"default": ""
		},
		"shapeDividerTopColour": {
			"type": "string",
			"default": ""
		},
		"shapeDividerTopFlip": {
			"type": "boolean",
			"default": false
		},
		"shapeDividerTopHeight": {
			"type": "number",
			"default": 80
		},
		"shapeDividerTopInvert": {
			"type": "boolean",
			"default": false
		},
		"tagName": {
			"type": "string",
			"enum": [
				"footer",
				"div",
				"section"
			],
			"default": "footer"
		},
		"templateMode": {
			"type": "string",
			"default": "free",
			"enum": [
				"free",
				"grid-section",
				"card-grid"
			]
		},
		"verticalAlign": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
