{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/form-field-tiles",
	"version": "0.2.0",
	"title": "SGS Tiles Field",
	"category": "sgs-forms",
	"description": "Visual tile selection with icons.",
	"keywords": [
		"tiles",
		"choice",
		"visual",
		"icon"
	],
	"textdomain": "sgs-blocks",
	"icon": "grid-view",
	"parent": [
		"sgs/form",
		"sgs/form-step"
	],
	"usesContext": [
		"sgs/formId"
	],
	"supports": {
		"sgs": {
			"iconPicker": true,
			"imageControls": false,
			"hideExtensions": [
				"animation"
			],
			"elements": {
				"wrapper": {
					"label": "Wrapper",
					"layer": "OUTER",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:max-width": "maxWidth",
						"css:width": "contentWidth",
						"css:border-color-gradient": "borderColourGradient",
						"css:background-image": "textColourGradient"
					},
					"_note": "block.json declares no typography/spacing support on this block — the wrapper's font/padding/margin members are honest gaps. color+border are skip-serialised and emitted into a scoped style keyed to the field's uid class (render.php:59-114), mirroring sgs/container."
				},
				"inner": {
					"label": "Inner (grid / flex layout)",
					"layer": "GRID",
					"order": 2,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:gap": "gap",
						"css:grid-template-columns": "gridTemplateColumns",
						"css:grid-template-rows": "gridTemplateRows",
						"css:grid-auto-rows": "gridAutoRows",
						"css:align-items": "alignItems",
						"css:justify-items": "justifyItems",
						"css:justify-content": "justifyContent",
						"css:align-content": "alignContent",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap"
					},
					"_note": "WS-4: the tile grid delegates to SGS_Container_Wrapper (kind='layout', render.php:231-242) so it mirrors sgs/container's grid/flex capabilities. Maps explicitly — no `prefix` declared, so the default convention cannot resolve bare camelCase attrs (ROLLOUT REQUIREMENT 1). display/order/overflow/align-items remain honest gaps (no attribute on this block)."
				}
			},
			"boxFamilies": {
				"borderRadius": [
					"borderRadius"
				]
			}
		},
		"html": false,
		"anchor": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		}
	},
	"attributes": {
		"fieldName": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"placeholder": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"helpText": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"width": {
			"type": "string",
			"default": "full"
		},
		"tiles": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"label": {
						"type": "string"
					},
					"value": {
						"type": "string"
					},
					"icon": {
						"type": "string",
						"role": "icon"
					},
					"iconSource": {
						"type": "string"
					},
					"image": {
						"type": "string",
						"role": "image-object"
					}
				}
			}
		},
		"multiSelect": {
			"type": "boolean",
			"default": false
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"conditionalField": {
			"type": "string",
			"default": ""
		},
		"conditionalOperator": {
			"type": "string",
			"default": "equals"
		},
		"conditionalValue": {
			"type": "string",
			"default": ""
		},
		"selectedStyle": {
			"type": "string",
			"default": "checkmark"
		},
		"contentWidth": {
			"type": "object",
			"default": {}
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"layout": {
			"type": "string",
			"enum": [
				"",
				"flex",
				"stack",
				"grid"
			],
			"default": ""
		},
		"alignItems": {
			"type": "string",
			"default": ""
		},
		"gap": {
			"type": "object",
			"default": {}
		},
		"gridTemplateColumns": {
			"type": "object",
			"default": {}
		},
		"gridTemplateRows": {
			"type": "object",
			"default": {}
		},
		"gridAutoRows": {
			"type": "string",
			"default": ""
		},
		"justifyItems": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end"
			]
		},
		"alignContent": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end",
				"space-between",
				"space-around",
				"space-evenly"
			]
		},
		"flexDirection": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"row",
				"column"
			]
		},
		"flexWrap": {
			"type": "string",
			"default": "wrap",
			"enum": [
				"wrap",
				"nowrap"
			]
		},
		"justifyContent": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"flex-start",
				"center",
				"flex-end",
				"space-between",
				"space-around"
			]
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"example": {
		"attributes": {
			"label": "What type of business are you?",
			"tiles": [
				{
					"label": "Restaurant",
					"icon": "utensils",
					"iconSource": "lucide"
				},
				{
					"label": "Hotel",
					"icon": "building",
					"iconSource": "lucide"
				},
				{
					"label": "Retailer",
					"icon": "shopping-bag",
					"iconSource": "lucide"
				},
				{
					"label": "Caterer",
					"icon": "chef-hat",
					"iconSource": "lucide"
				}
			]
		}
	}
}
