{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/form-field-tiles",
	"version": "0.2.0",
	"title": "SGS Tiles Field",
	"category": "sgs-forms",
	"description": "Visual tile selection with icons.",
	"keywords": [
		"tiles",
		"choice",
		"visual",
		"icon"
	],
	"textdomain": "sgs-blocks",
	"icon": "grid-view",
	"parent": [
		"sgs/form",
		"sgs/form-step"
	],
	"supports": {
		"sgs": {
			"motionItems": "tile",
			"motion": true,
			"iconPicker": true,
			"imageControls": false,
			"elements": {
				"tile": {
					"label": "Each tile",
					"layer": "CONTENT",
					"order": 1,
					"selector": ".sgs-form-tile",
					"clusters": []
				},
				"tile-label": {
					"selector": ".sgs-form-tile__label",
					"label": "Tile label",
					"order": 3,
					"clusters": [
						"text"
					],
					"prefix": "tileLabel",
					"attrMap": {
						"css:font-size": "tileLabelFontSize",
						"css:font-weight": "tileLabelFontWeight",
						"css:line-height": "tileLabelLineHeight",
						"css:color": "tileLabelColour",
						"css:-webkit-text-stroke-width": "tileLabelTextStrokeWidth",
						"css:-webkit-text-stroke-color": "tileLabelTextStrokeColour"
					},
					"_note": "Each tile's label text (render.php); typography and colour from the Tile text panel and the tileLabelColour row.",
					"states": {
						"hover": {
							"attrMap": {
								"css:-webkit-text-stroke-color": "tileLabelTextStrokeColourHover"
							}
						}
					}
				},
				"tile-description": {
					"selector": ".sgs-form-tile__description",
					"label": "Tile description",
					"order": 4,
					"clusters": [
						"text"
					],
					"prefix": "tileDescription",
					"attrMap": {
						"css:font-size": "tileDescriptionFontSize",
						"css:font-weight": "tileDescriptionFontWeight",
						"css:line-height": "tileDescriptionLineHeight",
						"css:color": "tileDescriptionColour",
						"css:-webkit-text-stroke-width": "tileDescriptionTextStrokeWidth",
						"css:-webkit-text-stroke-color": "tileDescriptionTextStrokeColour"
					},
					"_note": "The optional line under a tile's label (render.php, printed only when the tile has a description).",
					"states": {
						"hover": {
							"attrMap": {
								"css:-webkit-text-stroke-color": "tileDescriptionTextStrokeColourHover"
							}
						}
					}
				},
				"wrapper": {
					"label": "Wrapper",
					"layer": "OUTER",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:max-width": "maxWidth",
						"css:border-color-gradient": "borderColourGradient",
						"css:background-image": "textColourGradient",
						"css:color-gradient": "textColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "textColourHover",
								"css:color-gradient": "textColourHoverGradient"
							}
						}
					},
					"_note": "block.json declares no typography/spacing support on this block — the wrapper's font/padding/margin members are honest gaps. color+border are skip-serialised and emitted into a scoped style keyed to the field's uid class (render.php:59-114), mirroring sgs/container. textColourHover/textColourHoverGradient (2026-09-07, colour-conformance): textColour and backgroundColour share this SAME element, so render.php conditionally moves the background onto its own ::after layer via sgs_block_background_layer_css() whenever the resolved hover text value is a gradient (CLAUDE.md's text+background-on-one-selector precondition)."
				},
				"inner": {
					"selector": ".sgs-form-tiles",
					"label": "Inner (grid / flex layout)",
					"layer": "GRID",
					"order": 2,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:gap": "gap",
						"css:grid-template-columns": "gridTemplateColumns",
						"css:grid-template-rows": "gridTemplateRows",
						"css:grid-auto-rows": "gridAutoRows",
						"css:align-items": "alignItems",
						"css:justify-items": "justifyItems",
						"css:justify-content": "justifyContent",
						"css:align-content": "alignContent",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap"
					},
					"_note": "WS-4: the tile grid delegates to SGS_Container_Wrapper (kind='layout', render.php:231-242) so it mirrors sgs/container's grid/flex capabilities. Maps explicitly — no `prefix` declared, so the default convention cannot resolve bare camelCase attrs (ROLLOUT REQUIREMENT 1). display/order/overflow/align-items remain honest gaps (no attribute on this block)."
				},
				"content-band": {
					"label": "Content band",
					"layer": "CONTENT",
					"order": 5,
					"clusters": [
						"layout"
					],
					"prefix": "contentBand",
					"motion": false,
					"_note": "The wrapper prints its band inside the field's fieldset, so the band is the root's grandchild, not its direct child; a motion layer cannot resolve it (the tiles container is the motion part `inner`).",
					"attrMap": {
						"css:max-width": "contentWidth"
					}
				}
			},
			"boxFamilies": {
				"borderRadius": [
					"borderRadius"
				],
				"borderWidth": [
					"borderWidth"
				]
			}
		},
		"html": false,
		"anchor": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		}
	},
	"attributes": {
		"fieldName": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"helpText": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"width": {
			"type": "string",
			"default": "full"
		},
		"tiles": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"label": {
						"type": "string"
					},
					"value": {
						"type": "string"
					},
					"icon": {
						"type": "string",
						"role": "icon"
					},
					"iconSource": {
						"type": "string"
					},
					"image": {
						"type": "string",
						"role": "image-object"
					},
					"description": {
						"type": "string",
						"default": ""
					}
				}
			}
		},
		"multiSelect": {
			"type": "boolean",
			"default": false
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"conditionalField": {
			"type": "string",
			"default": ""
		},
		"conditionalOperator": {
			"type": "string",
			"default": "equals"
		},
		"conditionalValue": {
			"type": "string",
			"default": ""
		},
		"selectedStyle": {
			"type": "string",
			"default": "checkmark"
		},
		"contentWidth": {
			"type": "object",
			"default": {}
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"layout": {
			"type": "string",
			"enum": [
				"",
				"flex",
				"stack",
				"grid"
			],
			"default": ""
		},
		"alignItems": {
			"type": "string",
			"default": ""
		},
		"gap": {
			"type": "object",
			"default": {}
		},
		"gridTemplateColumns": {
			"type": "object",
			"default": {}
		},
		"gridTemplateRows": {
			"type": "object",
			"default": {}
		},
		"gridAutoRows": {
			"type": "string",
			"default": ""
		},
		"justifyItems": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end"
			]
		},
		"alignContent": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end",
				"space-between",
				"space-around",
				"space-evenly"
			]
		},
		"flexDirection": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"row",
				"column"
			]
		},
		"flexWrap": {
			"type": "string",
			"default": "wrap",
			"enum": [
				"wrap",
				"nowrap"
			]
		},
		"justifyContent": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"flex-start",
				"center",
				"flex-end",
				"space-between",
				"space-around"
			]
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state gradient sibling of textColourHover. Non-empty wins over textColourHover on :hover/:focus-visible."
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"tileLabelFontSize": {
			"type": "object",
			"default": {}
		},
		"tileLabelFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"tileLabelFontFamily": {
			"type": "string",
			"default": ""
		},
		"tileLabelFontWeight": {
			"type": "string",
			"default": ""
		},
		"tileLabelFontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"default": ""
		},
		"tileLabelLineHeight": {
			"type": "object",
			"default": {}
		},
		"tileLabelLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"tileLabelLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"tileLabelLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"tileLabelTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"tileLabelTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"tileLabelTextAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"tileLabelTextWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"tileLabelTextStrokeWidth": {
			"type": "object",
			"default": {}
		},
		"tileLabelTextStrokeColour": {
			"type": "string",
			"default": ""
		},
		"tileLabelTextStrokeColourHover": {
			"type": "string",
			"default": ""
		},
		"tileDescriptionFontSize": {
			"type": "object",
			"default": {}
		},
		"tileDescriptionFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"tileDescriptionFontFamily": {
			"type": "string",
			"default": ""
		},
		"tileDescriptionFontWeight": {
			"type": "string",
			"default": ""
		},
		"tileDescriptionFontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"default": ""
		},
		"tileDescriptionLineHeight": {
			"type": "object",
			"default": {}
		},
		"tileDescriptionLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"tileDescriptionLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"tileDescriptionLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"tileDescriptionTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"tileDescriptionTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"tileDescriptionTextAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"tileDescriptionTextWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"tileDescriptionTextStrokeWidth": {
			"type": "object",
			"default": {}
		},
		"tileDescriptionTextStrokeColour": {
			"type": "string",
			"default": ""
		},
		"tileDescriptionTextStrokeColourHover": {
			"type": "string",
			"default": ""
		},
		"tileLabelColour": {
			"type": "string",
			"default": ""
		},
		"tileDescriptionColour": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"example": {
		"attributes": {
			"label": "What type of business are you?",
			"tiles": [
				{
					"label": "Restaurant",
					"icon": "utensils",
					"iconSource": "lucide"
				},
				{
					"label": "Hotel",
					"icon": "building",
					"iconSource": "lucide"
				},
				{
					"label": "Retailer",
					"icon": "shopping-bag",
					"iconSource": "lucide"
				},
				{
					"label": "Caterer",
					"icon": "chef-hat",
					"iconSource": "lucide"
				}
			]
		}
	}
}
