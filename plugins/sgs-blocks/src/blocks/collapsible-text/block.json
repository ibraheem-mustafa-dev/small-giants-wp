{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/collapsible-text",
	"version": "1.0.0",
	"title": "Collapsible Text",
	"category": "sgs-content",
	"description": "Operator-editable body copy that optionally collapses behind a Read more / Read less toggle. The full text is always emitted into the page HTML so it stays accessible to crawlers and assistive technology in every state.",
	"keywords": [
		"text",
		"copy",
		"collapsible",
		"expandable",
		"read more",
		"collapse",
		"archive",
		"category",
		"shop"
	],
	"textdomain": "sgs-blocks",
	"icon": "editor-alignleft",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"text": false,
			"background": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"boxFamilies": {
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Text box",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:padding": "padding",
						"css:margin": "margin"
					}
				},
				"body": {
					"label": "Body text",
					"order": 2,
					"clusters": [
						"text"
					],
					"prefix": "",
					"attrMap": {
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:font-style": "fontStyle",
						"css:line-height": "lineHeight",
						"css:color": "textColour",
						"css:text-align": "native:typography.textAlign",
						"css:background-image": "textColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "textColourHover",
								"css:color-gradient": "textColourHoverGradient"
							}
						}
					},
					"_note": "typography.fontSize is deliberately disabled at block level (supports.typography.fontSize:false) — this block's own bare fontSize/fontWeight/fontStyle/lineHeight attrs are the real, non-native control set for the body text. An empty-string prefix does NOT trigger the default-convention resolver (it's checked with `if (element.prefix)`, and '' is falsy), so every member here needs an explicit attrMap entry rather than relying on bare-attribute matching. textColourHover/textColourHoverGradient (2026-09-07, colour-conformance) paint at $root_sel in render.php (same as the base textColour, not the body-specific selector) — the wrapper's backgroundColour ALSO paints at $root_sel via sgs_fill_states_css(), a genuine same-selector text+background conflict, so render.php conditionally moves the background onto its own ::after layer via sgs_block_background_layer_css() whenever the resolved hover text value is a gradient (CLAUDE.md's text+background-on-one-selector precondition)."
				}
			}
		}
	},
	"selectors": {
		"root": ".sgs-collapsible-text"
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"text": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"collapsible": {
			"type": "boolean",
			"default": false
		},
		"collapsedLines": {
			"type": "integer",
			"default": 4,
			"minimum": 1
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"fontStyle": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "number"
		},
		"lineHeightUnit": {
			"type": "string",
			"default": ""
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state gradient sibling of textColourHover. Non-empty wins over textColourHover on :hover/:focus-visible."
		},
		"linkColour": {
			"type": "string",
			"default": ""
		},
		"linkColourHover": {
			"type": "string",
			"default": ""
		},
		"fontFamily": {
			"type": "string",
			"default": ""
		},
		"textTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"textDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"letterSpacing": {
			"type": "object",
			"default": {}
		},
		"letterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"textAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"textWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"textColumns": {
			"type": "number"
		},
		"textIndent": {
			"type": "string",
			"default": ""
		},
		"writingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"text": "<p>Discover our full range of premium products, carefully curated for quality and value.</p><p>From everyday essentials to speciality items, we source directly from trusted suppliers to bring you the best selection at competitive prices. Our range is updated regularly with new arrivals and seasonal favourites, so there is always something new to explore.</p>",
			"collapsible": true,
			"collapsedLines": 3
		}
	}
}
