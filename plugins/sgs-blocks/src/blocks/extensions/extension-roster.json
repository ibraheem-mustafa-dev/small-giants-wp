{
	"_meta": {
		"purpose": "Declared roster of every sgs* editor-extension attribute: which blocks receive it (opt-in rule), its shape, and the CSS its PHP emitter produces. Read by sgs-update-v2.py::_seed_extension_attr_rows, which writes block_attributes rows with source='sgs-ext'. scripts/check-extension-roster.js fails the build when this file drifts from the extension JS attribute names or from check-universal-fit.js's per-block gating.",
		"rule_modes": {
			"allowlist": "block lists `enabledSlug` in supports.sgs.enabledExtensions (and, when `requiresClassName`, does not set supports.className=false)",
			"universal": "every block unless supports.className=false (when `requiresClassName`) or supports.sgs.hideExtensions lists `hideSlug`",
			"denylist": "every sgs/* block unless supports.sgs.hideExtensions lists `hideSlug` (core blocks named in `coreBlocks` also receive it in the editor but have no sgs-owned DB rows)",
			"flag": "block sets supports.sgs.<flag> truthy",
			"named": "only the blocks named in `blocks`; none of them is an sgs/* block, so no rows are seeded unless the rule sets `seedRows` (then the seeder adds a blocks row for each named block and an sgs-ext row for each attribute)"
		},
		"fields": "type, default (omitted = no default), enum, tier_shape, is_responsive, role (an existing roles.role_name), css_property/css_element/css_state/css_tier (omitted = NULL: no single CSS property to route, or a discovered enum), requires (companion attributes a calibration marker must also carry before the setting paints anything)",
		"canvas_source": "An extension entry may set canvasSource: \"rest\" when its editor canvas is drawn from a server route its editor component fetches (no editor.BlockListBlock read). scripts/wiring-fingerprint/wf_extensions.py then counts a sgs/v1 route named in the entry's files as the canvas read of every attribute of the entry.",
		"css_slots": "db-consistency check_routing allows one attribute per (css_property, css_element, css_state, css_tier) on a block, so a CSS slot is declared once. Controls that paint a slot a block can already own (width) keep css_property NULL.",
		"css_element": "wrapper = the block root; image = the img/video inside it (assets/css/extensions.css .sgs-has-image-controls rules)"
	},
