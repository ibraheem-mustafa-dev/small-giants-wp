				"sgsChildWidth": { "type": "object", "default": {}, "tier_shape": "tier_object", "is_responsive": 1, "role": "layout", "requires": { "sgsChildSizing": { "desktop": "fixed", "tablet": "fixed", "mobile": "fixed" } } }
