{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/notice-banner",
	"version": "0.9.0",
	"title": "SGS Notice Banner",
	"category": "sgs-content",
	"description": "Inline informational banner for contextual messages like minimum order values, delivery terms, or promotional notices.",
	"keywords": [
		"notice",
		"banner",
		"alert",
		"info",
		"message",
		"announcement"
	],
	"textdomain": "sgs-blocks",
	"icon": "megaphone",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"iconPicker": true,
			"is_section_root": true,
			"enabledExtensions": [
				"blockLink"
			],
			"boxFamilies": {
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				],
				"borderRadius": [
					"borderRadius"
				],
				"borderWidth": [
					"borderWidth"
				]
			},
			"elements": {
				"banner": {
					"label": "Banner",
					"layer": "CONTENT",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:font-style": "fontStyle",
						"css:line-height": "lineHeight",
						"css:text-align": "textAlign",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:max-width": "maxWidth",
						"css:background-color-gradient": "backgroundColourGradient",
						"css:color-gradient": "textColourGradient",
						"css:border-color-gradient": "borderColourGradient"
					},
					"_note": "NO-WRAPPER, content-KIND (D294, render.php:9-21) — dropped SGS_Container_Wrapper, block-private; every declaration scoped to the block's own `.{uid}` style (render.php:200-278). Layer CONTENT names the structural role (this block has no GRID layer).",
					"states": {
						"hover": {
							"attrMap": {
								"css:background-color": "backgroundColourHover",
								"css:background-color-gradient": "backgroundColourHoverGradient",
								"css:color": "textColourHover",
								"css:color-gradient": "textColourHoverGradient"
							}
						}
					}
				},
				"icon": {
					"label": "Icon",
					"order": 2,
					"clusters": [
						"text",
						"fill"
					],
					"prefix": "icon",
					"attrMap": {
						"css:color": "iconColour",
						"css:stroke": "iconColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "iconColourHover",
								"css:stroke": "iconColourHoverGradient"
							}
						}
					},
					"_note": "iconColour/iconColourHover explicitly mapped (base + states.hover) since 2026-09-04 (D956) -- both used to resolve via the default {prefix}{suffix} convention, which routed them to the SAME (css:color, element=icon, state=NULL) slot with no way to tell them apart, a real routing-determinism ambiguity (F6 Check #1/#8). Emitted as scoped rules (`.{uid} .sgs-notice-banner__icon{color:...}` base, a touch-guarded :hover + unguarded :focus-visible pair for the Hover attr via sgs_hover_state_rules()), not inline -- gated on iconColour being set. `css:stroke` (D636/D644 icon/SVG gradient mechanism) explicit-mapped to iconColourGradient, added 2026-08-16 (Builder 4) — non-empty wins over iconColour's flat currentColor paint at render time (helpers-svg-gradient.php)."
					},
					"arrows": {
						"label": "Rotation arrows",
						"order": 3,
						"clusters": [
							"fill"
						],
						"attrMap": {
							"css:color": "arrowColour"
						},
						"states": {
							"hover": {
								"attrMap": {
									"css:color": "arrowColourHover"
								}
							}
						},
						"_note": "U-15 — rotate mode's previous/next controls only (block.json::messageMode). Explicit attrMap (not the default {prefix}{suffix} convention) because the block has no `arrow` PREFIX declared. Emitted scoped on `.sgs-notice-banner__prev`/`.sgs-notice-banner__next` via sgs_hover_state_rules(), gated on arrowColour being set."
					}
				}
			}
		},
	"selectors": {
		"root": ".sgs-notice-banner",
		"typography": ".sgs-notice-banner"
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"icon": {
			"type": "string",
			"default": "info"
		},
		"iconSource": {
			"type": "string",
			"default": ""
		},
		"iconName": {
			"type": "string",
			"default": ""
		},
		"showIcon": {
			"type": "boolean",
			"default": true
		},
		"text": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"variant": {
			"type": "string",
			"default": "info"
		},
		"maxWidth": {
			"type": "string",
			"default": ""
		},
		"iconColour": {
			"type": "string",
			"default": ""
		},
		"iconColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the icon's stroke instead of a flat colour. Non-empty wins over iconColour at render time (D636/D644)."
		},
		"iconColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state gradient sibling of iconColourGradient. Non-empty wins over iconColourHover at render time."
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"displayMode": {
			"type": "string",
			"default": "inline",
			"enum": [
				"inline",
				"announcement"
			]
		},
		"stickyPosition": {
			"type": "string",
			"default": "top",
			"enum": [
				"top",
				"bottom"
			]
		},
		"dismissible": {
			"type": "boolean",
			"default": false
		},
		"dismissBehaviour": {
			"type": "string",
			"default": "session",
			"enum": [
				"session",
				"permanent"
			]
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"iconColourHover": {
			"type": "string",
			"default": ""
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"fontStyle": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"textAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"fontFamily": {
			"type": "string",
			"default": ""
		},
		"textTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"textDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"letterSpacing": {
			"type": "object",
			"default": {}
		},
		"letterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"textWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"textColumns": {
			"type": "number"
		},
		"textIndent": {
			"type": "string",
			"default": ""
		},
		"writingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		},
		"messageMode": {
			"type": "string",
			"enum": [
				"static",
				"rotate",
				"random"
			],
			"default": "static",
			"description": "U-15: static shows every sgs/notice-message child stacked (or the single child). rotate/random need at least two sgs/notice-message children to take effect — with fewer, the banner renders exactly as static."
		},
		"rotateInterval": {
			"type": "number",
			"default": 5,
			"description": "Seconds between automatic rotations (2 to 30). rotate mode only."
		},
		"messageTransition": {
			"type": "string",
			"enum": [
				"none",
				"fade",
				"slide-up",
				"slide-left"
			],
			"default": "fade"
		},
		"showMessageArrows": {
			"type": "boolean",
			"default": false,
			"description": "rotate mode only — previous/next controls that also pause auto-rotation."
		},
		"pauseOnHover": {
			"type": "boolean",
			"default": true,
			"description": "rotate mode only — hover or focus within the banner pauses rotation."
		},
		"arrowColour": {
			"type": "string",
			"default": ""
		},
		"arrowColourHover": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"variant": "info",
			"icon": "info",
			"text": "A brief supporting statement that explains your value proposition."
		}
	}
}
