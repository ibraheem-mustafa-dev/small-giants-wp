{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "sgs/form-review",
    "version": "0.1.0",
    "title": "SGS Form Review",
    "category": "sgs-forms",
    "description": "Displays one card per form section with the answers given and an Edit button back to that section.",
    "keywords": [
        "review",
        "summary",
        "preview",
        "confirmation"
    ],
    "textdomain": "sgs-blocks",
    "icon": "clipboard",
    "parent": [
        "sgs/form",
        "sgs/form-step"
    ],
    "supports": {
        "html": false,
        "anchor": false,
        "sgs": {
            "elements": {
                "heading": {
                    "label": "Review heading",
                    "order": 1,
                    "clusters": [],
                    "prefix": "",
                    "attrMap": {
                        "tag": "headingLevel"
                    },
                    "_note": "Renders as <h3 class=\"sgs-form-review__heading\"> (dynamic tag driven by the block-wide headingLevel attr since the WCAG 1.3.1 fix — was a hardcoded <h3>) — no per-instance colour/font-size/weight attribute exists on this block; the heading is styled entirely by shared framework CSS. clusters: [] is a genuine gap, not hidden. `prefix: \"\"` opts this element OUT of orphan-scanning's default-to-elementKey fallback (check-element-manifest-conformance.js) — without it, the element key 'heading' string-prefix-matches the unrelated top-level `headingLevel` attr and misreports it as an unclaimed orphan of THIS element, exactly the 'help' element + 'helpText' false-positive the script's own header documents and fixes the same way. `attrMap.tag` added (D-pending, E12 scoping fix, check-hardcoded-render-defaults.js) — a DIFFERENT script from the orphan-scan one above; its resolver reads `attrMap` values regardless of the `prefix: \"\"` opt-out, so this entry is safe alongside it and is the only way `headingLevel` resolves to an element for that gate (there is genuinely no other styleable attribute on this block to collide with it, but the mapping keeps the gate's resolution honest rather than silent)."
                },
                "intro": {
                    "label": "Intro text",
                    "order": 2,
                    "clusters": [],
                    "_note": "Renders as <p class=\"sgs-form-review__intro\"> from the intro attribute, styled entirely by shared framework CSS. clusters: [] is a genuine gap."
                },
                "list": {
                    "label": "Review summary list",
                    "order": 3,
                    "clusters": [],
                    "_note": "Renders as an empty cards mount <div class=\"sgs-form-review__cards\"> — populated client-side by view.js (review-cards.js) with one card per section, each holding a <dl class=\"sgs-form-review__list\"> of the answered field rows. No per-instance style attribute exists on this block for the list or its rows; styling is shared framework CSS. clusters: [] is a genuine gap."
                },
                "card": {
                    "label": "Review card",
                    "order": 4,
                    "clusters": [],
                    "prefix": "card",
                    "attrMap": {
                        "css:background-color": "cardBackgroundColour",
                        "css:border-color": "cardBorderColour",
                        "css:border-style": "cardBorderStyle",
                        "css:border-width": "cardBorderWidth",
                        "css:border-radius": "cardBorderRadius",
                        "css:padding": "cardPadding"
                    },
                    "_note": "Each section's card, built client-side by review-cards.js as <section class=\"sgs-form-review__card\">. Painted by render.php under a scoped uid class."
                },
                "card-title": {
                    "label": "Card title",
                    "order": 5,
                    "clusters": [
                        "text"
                    ],
                    "prefix": "cardTitle",
                    "attrMap": {
                        "css:font-size": "cardTitleFontSize",
                        "css:font-weight": "cardTitleFontWeight",
                        "css:font-style": "cardTitleFontStyle",
                        "css:font-family": "cardTitleFontFamily",
                        "css:text-transform": "cardTitleTextTransform",
                        "css:line-height": "cardTitleLineHeight",
                        "css:letter-spacing": "cardTitleLetterSpacing"
                    },
                    "_note": "The card's title line, <p class=\"sgs-form-review__card-title\">, typography through sgs_typography_css_rule()."
                },
                "term": {
                    "label": "Row label",
                    "order": 6,
                    "clusters": [
                        "text"
                    ],
                    "prefix": "term",
                    "attrMap": {
                        "css:color": "termColour"
                    },
                    "_note": "The <dt class=\"sgs-form-review__term\"> label in each card row; typography is the parent form's reviewTerm family."
                },
                "value": {
                    "label": "Row value",
                    "order": 7,
                    "clusters": [
                        "text"
                    ],
                    "prefix": "value",
                    "attrMap": {
                        "css:color": "valueColour"
                    },
                    "_note": "The <dd class=\"sgs-form-review__detail\"> answer in each card row; typography is the parent form's reviewDetail family."
                }
            }
        }
    },
    "attributes": {
        "heading": {
            "type": "string",
            "default": "Review your information",
            "role": "content"
        },
        "headingLevel": {
            "type": "string",
            "enum": [
                "h2",
                "h3",
                "h4",
                "h5",
                "h6",
                "p"
            ],
            "default": "h3"
        },
        "intro": {
            "type": "string",
            "default": "Please check your details below before submitting.",
            "role": "content"
        },
        "showEditLinks": {
            "type": "boolean",
            "default": true
        },
        "editLabel": {
            "type": "string",
            "default": "Edit",
            "role": "content"
        },
        "cardBackgroundColour": {
            "type": "string",
            "default": ""
        },
        "cardBorderColour": {
            "type": "string",
            "default": ""
        },
        "cardBorderStyle": {
            "type": "string",
            "enum": [
                "none",
                "solid",
                "dashed",
                "dotted"
            ],
            "default": "solid"
        },
        "cardBorderWidth": {
            "type": "object",
            "default": {}
        },
        "cardBorderRadius": {
            "type": "object",
            "default": {
                "desktop": {}
            }
        },
        "cardPadding": {
            "type": "string",
            "default": ""
        },
        "termColour": {
            "type": "string",
            "default": ""
        },
        "valueColour": {
            "type": "string",
            "default": ""
        },
        "cardTitleFontSize": {
            "type": "object",
            "default": {}
        },
        "cardTitleFontSizeUnit": {
            "type": "string",
            "default": "px"
        },
        "cardTitleFontWeight": {
            "type": "string",
            "default": ""
        },
        "cardTitleFontStyle": {
            "type": "string",
            "default": ""
        },
        "cardTitleFontFamily": {
            "type": "string",
            "default": ""
        },
        "cardTitleTextTransform": {
            "type": "string",
            "enum": [
                "",
                "none",
                "uppercase",
                "lowercase",
                "capitalize"
            ],
            "default": ""
        },
        "cardTitleLineHeight": {
            "type": "object",
            "default": {}
        },
        "cardTitleLineHeightUnit": {
            "type": "string",
            "default": "em"
        },
        "cardTitleLetterSpacing": {
            "type": "object",
            "default": {}
        },
        "cardTitleLetterSpacingUnit": {
            "type": "string",
            "default": "em"
        }
    },
    "render": "file:./render.php",
    "editorScript": "file:./index.js",
    "example": {
        "attributes": {
            "heading": "Review your information"
        }
    }
}
