{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "sgs/form-review",
    "version": "0.1.0",
    "title": "SGS Form Review",
    "category": "sgs-forms",
    "description": "Displays one card per form section with the answers given and an Edit button back to that section.",
    "keywords": [
        "review",
        "summary",
        "preview",
        "confirmation"
    ],
    "textdomain": "sgs-blocks",
    "icon": "clipboard",
    "parent": [
        "sgs/form",
        "sgs/form-step"
    ],
    "supports": {
        "html": false,
        "anchor": false,
        "sgs": {
            "elements": {
                "heading": {
                    "label": "Review heading",
                    "order": 1,
                    "clusters": [],
                    "prefix": "",
                    "attrMap": {
                        "tag": "headingLevel"
                    },
                    "_note": "Renders as <h3 class=\"sgs-form-review__heading\"> (dynamic tag driven by the block-wide headingLevel attr since the WCAG 1.3.1 fix — was a hardcoded <h3>) — no per-instance colour/font-size/weight attribute exists on this block; the heading is styled entirely by shared framework CSS. clusters: [] is a genuine gap, not hidden. `prefix: \"\"` opts this element OUT of orphan-scanning's default-to-elementKey fallback (check-element-manifest-conformance.js) — without it, the element key 'heading' string-prefix-matches the unrelated top-level `headingLevel` attr and misreports it as an unclaimed orphan of THIS element, exactly the 'help' element + 'helpText' false-positive the script's own header documents and fixes the same way. `attrMap.tag` added (D-pending, E12 scoping fix, check-hardcoded-render-defaults.js) — a DIFFERENT script from the orphan-scan one above; its resolver reads `attrMap` values regardless of the `prefix: \"\"` opt-out, so this entry is safe alongside it and is the only way `headingLevel` resolves to an element for that gate (there is genuinely no other styleable attribute on this block to collide with it, but the mapping keeps the gate's resolution honest rather than silent)."
                },
                "intro": {
                    "label": "Intro text",
                    "order": 2,
                    "clusters": [],
                    "_note": "Renders as <p class=\"sgs-form-review__intro\"> from the intro attribute, styled entirely by shared framework CSS. clusters: [] is a genuine gap."
                },
                "list": {
                    "label": "Review summary list",
                    "order": 3,
                    "layer": "GRID",
                    "clusters": [
                        "layout"
                    ],
                    "prefix": "list",
                    "attrMap": {
                        "css:grid-template-columns": "listColumns",
                        "css:row-gap": "listRowGap",
                        "css:column-gap": "listColumnGap"
                    },
                    "_note": "The <dl class=\"sgs-form-review__list\"> inside each card, built client-side by view.js (review-cards.js): one row per answered field. listColumns is how many rows sit side by side per device; the gaps are per device. Painted by render.php under the scoped uid class."
                },
                "row": {
                    "label": "Review row",
                    "order": 9,
                    "layer": "GRID",
                    "clusters": [
                        "layout"
                    ],
                    "prefix": "row",
                    "attrMap": {
                        "css:grid-template-columns": "rowLayout"
                    },
                    "_note": "One answered field, <div class=\"sgs-form-review__row\"> holding the label (dt) and the answer (dd). rowLayout 'side' sets them side by side, 'stacked' puts the answer under the label."
                },
                "cards": {
                    "label": "Review cards",
                    "order": 10,
                    "clusters": [
                        "layout"
                    ],
                    "prefix": "cards",
                    "attrMap": {
                        "css:gap": "cardsGap",
                        "css:margin-top": "cardsMarginTop"
                    },
                    "_note": "The <div class=\"sgs-form-review__cards\"> mount that holds one card per section: the space between cards and above the first."
                },
                "card": {
                    "label": "Review card",
                    "order": 4,
                    "clusters": [
                        "fill",
                        "layout"
                    ],
                    "prefix": "card",
                    "attrMap": {
                        "css:background-color": "cardBackgroundColour",
                        "css:background-image": "cardBackgroundColourGradient",
                        "css:border-color": "cardBorderColour",
                        "css:border-style": "cardBorderStyle",
                        "css:border-width": "cardBorderWidth",
                        "css:border-radius": "cardBorderRadius",
                        "css:padding": "cardPadding"
                    },
                    "_note": "Each section's card, built client-side by review-cards.js as <section class=\"sgs-form-review__card\">. Painted by render.php under a scoped uid class."
                },
                "card-title": {
                    "label": "Card title",
                    "order": 5,
                    "clusters": [
                        "text"
                    ],
                    "prefix": "cardTitle",
                    "attrMap": {
                        "css:font-size": "cardTitleFontSize",
                        "css:font-weight": "cardTitleFontWeight",
                        "css:font-style": "cardTitleFontStyle",
                        "css:font-family": "cardTitleFontFamily",
                        "css:text-transform": "cardTitleTextTransform",
                        "css:line-height": "cardTitleLineHeight",
                        "css:letter-spacing": "cardTitleLetterSpacing"
                    },
                    "_note": "The card's title line, <p class=\"sgs-form-review__card-title\">, typography through sgs_typography_css_rule()."
                },
                "term": {
                    "label": "Row label",
                    "order": 6,
                    "clusters": [
                        "text"
                    ],
                    "prefix": "term",
                    "attrMap": {
                        "css:color": "termColour",
                        "css:color-gradient": "termColourGradient"
                    },
                    "_note": "The <dt class=\"sgs-form-review__term\"> label in each card row; typography is the parent form's reviewTerm family."
                },
                "value": {
                    "label": "Row value",
                    "order": 7,
                    "clusters": [
                        "text"
                    ],
                    "prefix": "value",
                    "attrMap": {
                        "css:color": "valueColour",
                        "css:color-gradient": "valueColourGradient"
                    },
                    "_note": "The <dd class=\"sgs-form-review__detail\"> answer in each card row; typography is the parent form's reviewDetail family."
                },
                "edit-button": {
                    "label": "Edit button",
                    "order": 8,
                    "clusters": [
                        "text",
                        "fill",
                        "layout"
                    ],
                    "prefix": "editButton",
                    "attrMap": {
                        "css:color": "editButtonColour",
                        "css:background-color": "editButtonBackgroundColour",
                        "css:border-color": "editButtonBorderColour",
                        "css:border-style": "editButtonBorderStyle",
                        "css:border-width": "editButtonBorderWidth",
                        "css:border-radius": "editButtonBorderRadius",
                        "css:padding": "editButtonPadding",
                        "css:min-height": "editButtonMinHeight",
                        "css:font-size": "editButtonFontSize",
                        "css:font-weight": "editButtonFontWeight",
                        "css:font-style": "editButtonFontStyle",
                        "css:font-family": "editButtonFontFamily",
                        "css:text-transform": "editButtonTextTransform",
                        "css:line-height": "editButtonLineHeight",
                        "css:letter-spacing": "editButtonLetterSpacing"
                    },
                    "states": {
                        "hover": {
                            "attrMap": {
                                "css:color": "editButtonColourHover",
                                "css:background-color": "editButtonBackgroundColourHover",
                                "css:border-color": "editButtonBorderColourHover"
                            }
                        }
                    },
                    "_note": "The section's Edit button, <button class=\"sgs-form-review__edit\">, built client-side by review-cards.js. Its text is editLabel."
                }
            }
        }
    },
    "attributes": {
        "heading": {
            "type": "string",
            "default": "Review your information",
            "role": "content"
        },
        "headingLevel": {
            "type": "string",
            "enum": [
                "h2",
                "h3",
                "h4",
                "h5",
                "h6",
                "p"
            ],
            "default": "h3"
        },
        "intro": {
            "type": "string",
            "default": "Please check your details below before submitting.",
            "role": "content"
        },
        "showEditLinks": {
            "type": "boolean",
            "default": true
        },
        "editLabel": {
            "type": "string",
            "default": "Edit",
            "role": "content"
        },
        "cardBackgroundColour": {
            "type": "string",
            "default": ""
        },
        "cardBackgroundColourGradient": {
            "type": "string",
            "default": ""
        },
        "cardBorderColour": {
            "type": "string",
            "default": ""
        },
        "cardBorderStyle": {
            "type": "string",
            "enum": [
                "none",
                "solid",
                "dashed",
                "dotted"
            ],
            "default": "solid"
        },
        "cardBorderWidth": {
            "type": "object",
            "default": {}
        },
        "cardBorderRadius": {
            "type": "object",
            "default": {
                "desktop": {}
            }
        },
        "cardPadding": {
            "type": "string",
            "default": ""
        },
        "termColour": {
            "type": "string",
            "default": ""
        },
        "termColourGradient": {
            "type": "string",
            "default": ""
        },
        "valueColour": {
            "type": "string",
            "default": ""
        },
        "valueColourGradient": {
            "type": "string",
            "default": ""
        },
        "cardTitleFontSize": {
            "type": "object",
            "default": {}
        },
        "cardTitleFontSizeUnit": {
            "type": "string",
            "default": "px"
        },
        "cardTitleFontWeight": {
            "type": "string",
            "default": ""
        },
        "cardTitleFontStyle": {
            "type": "string",
            "default": ""
        },
        "cardTitleFontFamily": {
            "type": "string",
            "default": ""
        },
        "cardTitleTextTransform": {
            "type": "string",
            "enum": [
                "",
                "none",
                "uppercase",
                "lowercase",
                "capitalize"
            ],
            "default": ""
        },
        "cardTitleLineHeight": {
            "type": "object",
            "default": {}
        },
        "cardTitleLineHeightUnit": {
            "type": "string",
            "default": "em"
        },
        "cardTitleLetterSpacing": {
            "type": "object",
            "default": {}
        },
        "cardTitleLetterSpacingUnit": {
            "type": "string",
            "default": "em"
        },
        "listColumns": {
            "type": "object",
            "default": {}
        },
        "listRowGap": {
            "type": "object",
            "default": {}
        },
        "listColumnGap": {
            "type": "object",
            "default": {}
        },
        "rowLayout": {
            "type": "string",
            "enum": [
                "side",
                "stacked"
            ],
            "default": "side"
        },
        "cardsGap": {
            "type": "object",
            "default": {}
        },
        "cardsMarginTop": {
            "type": "object",
            "default": {}
        },
        "editButtonColour": {
            "type": "string",
            "default": ""
        },
        "editButtonColourHover": {
            "type": "string",
            "default": ""
        },
        "editButtonBackgroundColour": {
            "type": "string",
            "default": ""
        },
        "editButtonBackgroundColourHover": {
            "type": "string",
            "default": ""
        },
        "editButtonBorderColour": {
            "type": "string",
            "default": ""
        },
        "editButtonBorderColourHover": {
            "type": "string",
            "default": ""
        },
        "editButtonBorderStyle": {
            "type": "string",
            "enum": [
                "none",
                "solid",
                "dashed",
                "dotted"
            ],
            "default": "solid"
        },
        "editButtonBorderWidth": {
            "type": "object",
            "default": {}
        },
        "editButtonBorderRadius": {
            "type": "object",
            "default": {
                "desktop": {}
            }
        },
        "editButtonPadding": {
            "type": "object",
            "default": {}
        },
        "editButtonMinHeight": {
            "type": "object",
            "default": {},
            "description": "Minimum height of the Edit button, per device: {desktop,tablet,mobile}, each a CSS length ('37px', '2.3rem') or a bare number of px. The value is the height, even below 44px. Empty = the stylesheet's 44px."
        },
        "editButtonFontSize": {
            "type": "object",
            "default": {}
        },
        "editButtonFontSizeUnit": {
            "type": "string",
            "default": "px"
        },
        "editButtonFontWeight": {
            "type": "string",
            "default": ""
        },
        "editButtonFontStyle": {
            "type": "string",
            "default": ""
        },
        "editButtonFontFamily": {
            "type": "string",
            "default": ""
        },
        "editButtonTextTransform": {
            "type": "string",
            "enum": [
                "",
                "none",
                "uppercase",
                "lowercase",
                "capitalize"
            ],
            "default": ""
        },
        "editButtonLineHeight": {
            "type": "object",
            "default": {}
        },
        "editButtonLineHeightUnit": {
            "type": "string",
            "default": "em"
        },
        "editButtonLetterSpacing": {
            "type": "object",
            "default": {}
        },
        "editButtonLetterSpacingUnit": {
            "type": "string",
            "default": "em"
        }
    },
    "render": "file:./render.php",
    "editorScript": "file:./index.js",
    "example": {
        "attributes": {
            "heading": "Review your information"
        }
    }
}
