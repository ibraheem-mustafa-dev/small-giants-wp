{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/text",
	"version": "0.1.1",
	"title": "Text",
	"category": "sgs-content",
	"description": "Single-element body text block. Renders a <p> with full SGS typography, spacing, colour, border, shadow, and hover controls.",
	"keywords": [
		"text",
		"paragraph",
		"body",
		"copy"
	],
	"textdomain": "sgs-blocks",
	"icon": "editor-paragraph",
	"render": "file:./render.php",
	"supports": {
		"anchor": true,
		"className": true,
		"interactivity": {
			"clientNavigation": true
		},
		"html": false,
		"color": false,
		"sgs": {
			"boxFamilies": {
				"borderWidth": [
					"borderWidth"
				],
				"borderRadius": [
					"borderRadius"
				],
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				]
			},
			"elements": {
				"text": {
					"label": "Text",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout",
						"motion"
					],
					"isWrapper": true,
					"attrMap": {
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:line-height": "lineHeight",
						"css:letter-spacing": "letterSpacing",
						"css:font-style": "fontStyle",
						"css:text-transform": "textTransform",
						"css:text-decoration": "textDecoration",
						"css:color": "textColour",
						"css:text-align": "textAlign",
						"css:font-family": "fontFamily",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-color-gradient": "borderColourGradient",
						"css:border-radius": "borderRadius",
						"css:box-shadow": "boxShadow",
						"css:box-shadow-color": "boxShadowColour",
						"css:width": "customWidth",
						"css:max-width": "maxWidth",
						"css:transition-duration": "transitionDuration",
						"css:transition-timing-function": "transitionEasing",
						"css:color-gradient": "textColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "textColourHover",
								"css:box-shadow": "boxShadowHover",
								"css:box-shadow-color": "boxShadowHoverColour",
								"css:color-gradient": "textColourHoverGradient",
								"css:border-color": "borderColourHover"
							}
						}
					},
					"_note": "Single-semantic-element block — the <p> root IS the wrapper. `color` support is `false` in this block's supports (no native color path), so css:color maps to the SGS custom textColour attr directly, not native:. No `layer` — no children to arrange. scaleHover has no Spec 35 vocabulary member and is left unclaimed. `css:background-color`/`css:background-image` (+ their Hover siblings) moved OFF this element onto the new `background` element below (2026-08-22, text/background pseudo-element split) — this element's `css:color-gradient` paints via `background-clip:text`, which would otherwise overwrite/clip a background painted on the SAME node."
				},
				"background": {
					"label": "Background",
					"order": 3,
					"clusters": [
						"fill"
					],
					"isWrapper": false,
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:background-image": "backgroundColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:background-color": "backgroundColourHover",
								"css:background-image": "backgroundColourHoverGradient"
							}
						}
					},
					"_note": "The block's own background paint, moved off the `text` element onto a `::after` pseudo-element layer (render.php) so a text gradient on the SAME root node (`text` element's `css:color-gradient`) cannot clip or overwrite it via `background-clip:text`."
				},
				"first-letter": {
					"label": "Drop cap (first letter)",
					"order": 2,
					"clusters": [
						"text"
					],
					"attrMap": {
						"css:font-size": "firstLetterFontSize",
						"css:font-weight": "firstLetterFontWeight",
						"css:color": "firstLetterColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "firstLetterColourHover"
							}
						}
					},
					"_note": "Opt-in via the `dropCap` boolean (render.php:463-480) — emits a scoped `::first-letter` pseudo-element rule, a genuinely distinct visual element from the body text. line-height/letter-spacing/font-style/text-transform/text-decoration/text-align/font-family have no first-letter-specific attribute — honest gaps, the drop-cap render hardcodes float:left/line-height:0.8/margins rather than exposing them as controls."
				}
			}
		}
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"text": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"letterSpacing": {
			"type": "object",
			"default": {}
		},
		"letterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"fontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"default": ""
		},
		"textDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"textTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"fontFamily": {
			"type": "string",
			"default": ""
		},
		"textAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"maxWidth": {
			"type": "number"
		},
		"maxWidthUnit": {
			"type": "string",
			"default": "px"
		},
		"dropCap": {
			"type": "boolean",
			"default": false
		},
		"firstLetterColour": {
			"type": "string",
			"default": ""
		},
		"firstLetterColourGradient": {
			"type": "string",
			"default": ""
		},
		"firstLetterFontSize": {
			"type": "number"
		},
		"firstLetterFontSizeUnit": {
			"type": "string",
			"default": "em"
		},
		"firstLetterFontWeight": {
			"type": "string",
			"default": ""
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ::before ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour at render time."
		},
		"boxShadow": {
			"type": "string",
			"default": ""
		},
		"boxShadowHover": {
			"type": "string",
			"default": ""
		},
		"boxShadowColour": {
			"type": "string",
			"default": ""
		},
		"boxShadowHoverColour": {
			"type": "string",
			"default": ""
		},
		"scaleHover": {
			"type": "number"
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"customWidth": {
			"type": "string",
			"default": ""
		},
		"customWidthUnit": {
			"type": "string",
			"default": "px"
		},
		"inheritStyle": {
			"type": "boolean",
			"default": false
		},
		"transitionDuration": {
			"type": "number",
			"default": 300
		},
		"transitionEasing": {
			"type": "string",
			"enum": [
				"ease",
				"ease-in",
				"ease-out",
				"ease-in-out",
				"linear"
			],
			"default": "ease"
		},
		"borderColourHover": {
			"type": "string",
			"default": ""
		},
		"firstLetterColourHover": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"example": {
		"attributes": {
			"text": "This is a sample paragraph demonstrating the SGS Text block with full typography controls.",
			"fontSize": 16,
			"textColour": "text"
		}
	}
}
