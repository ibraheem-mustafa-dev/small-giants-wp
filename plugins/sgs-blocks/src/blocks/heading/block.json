{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/heading",
	"version": "0.5.1",
	"title": "Heading",
	"category": "sgs-content",
	"description": "Single-element heading block. Use headingRole to switch between a primary heading (h1–h6) and a subheading paragraph (p or div). Pair with sgs/label and a second sgs/heading{headingRole:'subheading'} via the label-heading-subheading-cluster pattern for the full three-element visual cluster.",
	"keywords": [
		"heading",
		"section heading",
		"title",
		"subheading",
		"subtitle"
	],
	"textdomain": "sgs-blocks",
	"icon": "heading",
	"supports": {
		"align": true,
		"html": false,
		"anchor": true,
		"color": {
			"text": false,
			"background": false,
			"gradients": false,
			"link": false,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"boxFamilies": {
				"borderWidth": [
					"borderWidth"
				],
				"borderRadius": [
					"borderRadius"
				],
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				]
			},
			"elements": {
				"heading": {
					"label": "Heading",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout",
						"motion"
					],
					"isWrapper": true,
					"attrMap": {
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:line-height": "lineHeight",
						"css:letter-spacing": "letterSpacing",
						"css:font-style": "fontStyle",
						"css:text-transform": "textTransform",
						"css:text-decoration": "textDecoration",
						"css:color": "textColour",
						"css:text-align": "textAlign",
						"css:text-wrap": "textWrap",
						"css:writing-mode": "writingMode",
						"css:font-family": "fontFamily",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:box-shadow": "boxShadow",
						"css:box-shadow-color": "boxShadowColour",
						"css:width": "customWidth",
						"css:transition-duration": "transitionDuration",
						"css:transition-timing-function": "transitionEasing",
						"css:color-gradient": "textColourGradient",
						"css:border-color-gradient": "borderColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "textColourHover",
								"css:box-shadow": "boxShadowHover",
								"css:box-shadow-color": "boxShadowHoverColour",
								"css:color-gradient": "textColourHoverGradient"
							}
						}
					},
					"_note": "Single-semantic-element block (D293) — the h1-h6/p/div root IS the wrapper, no separate box element. No `layer` declared: heading has no children to arrange, so the 12 ARRANGEMENT members are correctly never asked. maxWidth/height/max-height/min-height/gap/aspect-ratio/opacity/overlay/background-* image members have no attribute on this block — honest gaps (heading has no image surface). scaleHover has no cluster member in the Spec 35 vocabulary (no `transform`/`scale` member exists) so it is left unclaimed rather than force-mapped. `css:background-color`/`css:background-image` (+ their Hover siblings) moved OFF this element onto the new `background` element below (2026-08-22, text/background pseudo-element split) — this element's `css:color-gradient` paints via `background-clip:text`, which would otherwise overwrite/clip a background painted on the SAME node."
				},
				"background": {
					"label": "Background",
					"order": 2,
					"clusters": [
						"fill"
					],
					"isWrapper": false,
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:background-image": "backgroundColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:background-color": "backgroundColourHover",
								"css:background-image": "backgroundColourHoverGradient"
							}
						}
					},
					"_note": "The block's own background paint, moved off the `heading` element onto a `::after` pseudo-element layer (render.php) so a text gradient on the SAME root node (`heading` element's `css:color-gradient`) cannot clip or overwrite it via `background-clip:text`."
				}
			}
		}
	},
	"render": "file:./render.php",
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"headingRole": {
			"type": "string",
			"enum": [
				"heading",
				"subheading"
			],
			"default": "heading",
			"role": "content"
		},
		"content": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"level": {
			"type": "string",
			"enum": [
				"h1",
				"h2",
				"h3",
				"h4",
				"h5",
				"h6"
			],
			"default": "h2"
		},
		"subTag": {
			"type": "string",
			"enum": [
				"p",
				"div"
			],
			"default": "p"
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"fontFamily": {
			"type": "string",
			"default": ""
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"letterSpacing": {
			"type": "object",
			"default": {}
		},
		"letterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"textTransform": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"fontStyle": {
			"type": "string",
			"enum": [
				"normal",
				"italic"
			],
			"default": ""
		},
		"textDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through",
				"overline"
			],
			"default": ""
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border instead of a flat colour. Non-empty wins over borderColour at render time (D636)."
		},
		"boxShadow": {
			"type": "string",
			"default": ""
		},
		"boxShadowColour": {
			"type": "string",
			"default": ""
		},
		"boxShadowHover": {
			"type": "string",
			"default": ""
		},
		"boxShadowHoverColour": {
			"type": "string",
			"default": ""
		},
		"scaleHover": {
			"type": "number"
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"customWidth": {
			"type": "string",
			"default": ""
		},
		"customWidthUnit": {
			"type": "string",
			"default": "px"
		},
		"textAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify",
				"start",
				"end"
			],
			"default": ""
		},
		"inheritStyle": {
			"type": "boolean",
			"default": false
		},
		"transitionDuration": {
			"type": "number",
			"default": 300
		},
		"transitionEasing": {
			"type": "string",
			"enum": [
				"ease",
				"ease-in",
				"ease-out",
				"ease-in-out",
				"linear"
			],
			"default": "ease"
		},
		"textWrap": {
			"type": "string",
			"default": ""
		},
		"writingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"example": {
		"attributes": {
			"headingRole": "heading",
			"content": "A section heading that converts",
			"level": "h2"
		}
	}
}
