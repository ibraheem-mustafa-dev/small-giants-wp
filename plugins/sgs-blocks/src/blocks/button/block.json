{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/button",
	"version": "1.5.2",
	"title": "SGS Button",
	"category": "sgs-content",
	"description": "A highly-configurable button with a style-preset seed (primary/secondary/outline), icon support, hover states, and per-breakpoint controls.",
	"keywords": [
		"button",
		"cta",
		"link",
		"call to action"
	],
	"textdomain": "sgs-blocks",
	"icon": "button",
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"color": {
			"background": true,
			"gradients": true,
			"text": true,
			"link": false,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"iconPicker": true,
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				],
				"borderWidth": [
					"borderWidth"
				],
				"borderRadius": [
					"borderRadiusTablet",
					"borderRadiusMobile"
				]
			},
			"elements": {
				"button": {
					"label": "Button",
					"order": 1,
					"clusters": [ "text", "fill", "layout" ],
					"isWrapper": true,
					"attrMap": {
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:line-height": "lineHeight",
						"css:letter-spacing": "letterSpacing",
						"css:font-style": "fontStyle",
						"css:text-transform": "textTransform",
						"css:text-decoration": "textDecoration",
						"css:color": "colourText",
						"css:background-color": "colourBackground",
						"css:width": "customWidth",
						"css:min-height": "minHeight",
						"css:padding": "native:spacing.padding",
						"css:margin": "native:spacing.margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "colourBorder",
						"css:border-radius": "native:__experimentalBorder.radius",
						"css:box-shadow": "boxShadow",
						"css:font-family": "fontFamily"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "colourTextHover",
								"css:background-color": "colourBackgroundHover",
								"css:border-color": "colourBorderHover"
							}
						}
					}
				},
				"icon": {
					"label": "Icon",
					"order": 2,
					"clusters": [ "text" ],
					"attrMap": {
						"css:color": "iconColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "iconColourHover"
							}
						}
					},
					"_note": "iconColour/iconColourHover resolve via css:color (render.php:658 `.sgs-button__icon{color:...}`) — mirrors sgs/icon's own icon element, which uses the same css:color base + hover-state attrMap convention (Spec 35 vocabulary fix). iconSize remains an unmapped bespoke icon control, not a Text/Fill/Layout member. iconGap was deleted (D613) -- confirmed dead on both sides, no consumer anywhere in the plugin."
				}
			}
		}
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Click Here",
			"role": "content"
		},
		"url": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkId": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkKind": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkTarget": {
			"type": "string",
			"default": "_self"
		},
		"rel": {
			"type": "string",
			"default": ""
		},
		"download": {
			"type": "boolean",
			"default": false
		},
		"isSubmit": {
			"type": "boolean",
			"default": false
		},
		"inheritStyle": {
			"type": "string",
			"default": "primary",
			"enum": [
				"primary",
				"secondary",
				"outline",
				"custom"
			]
		},
		"widthType": {
			"type": "object",
			"default": {"desktop": "fit"}
		},
		"customWidth": {
			"type": "object",
			"default": {}
		},
		"customWidthUnit": {
			"type": "object",
			"default": {"desktop": "px", "tablet": "px", "mobile": "px"}
		},



		"minHeight": {
			"type": "object",
			"default": {}
		},
		"minHeightUnit": {
			"type": "string",
			"default": "px"
		},
		"minHeightTabletUnit": {
			"type": "string",
			"default": "px"
		},
		"minHeightMobileUnit": {
			"type": "string",
			"default": "px"
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		},
		"fontFamily": {
			"type": "string",
			"default": ""
		},
		"fontWeight": {
			"type": "string",
			"default": "600"
		},
		"fontStyle": {
			"type": "string",
			"default": "normal"
		},
		"textTransform": {
			"type": "string",
			"default": ""
		},
		"textDecoration": {
			"type": "string",
			"default": ""
		},
		"textDecorationHover": {
			"type": "string",
			"enum": [
				"none",
				"underline"
			],
			"default": "none"
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"letterSpacing": {
			"type": "object",
			"default": {}
		},
		"letterSpacingUnit": {
			"type": "string",
			"default": "px"
		},
		"colourText": {
			"type": "string",
			"default": ""
		},
		"colourTextHover": {
			"type": "string",
			"default": ""
		},
		"colourBackground": {
			"type": "string",
			"default": ""
		},
		"colourBackgroundHover": {
			"type": "string",
			"default": ""
		},
		"colourBorder": {
			"type": "string",
			"default": ""
		},
		"colourBorderHover": {
			"type": "string",
			"default": ""
		},
		"borderStyle": {
			"type": "string",
			"default": "solid"
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderRadiusTablet": {
			"type": "object",
			"default": {}
		},
		"borderRadiusMobile": {
			"type": "object",
			"default": {}
		},
		"boxShadow": {
			"type": "object",
			"default": {
				"colour": "",
				"hOffset": 0,
				"vOffset": 0,
				"blur": 0,
				"spread": 0,
				"inset": false
			}
		},
		"boxShadowHover": {
			"type": "object",
			"default": {
				"colour": "",
				"hOffset": 0,
				"vOffset": 0,
				"blur": 0,
				"spread": 0,
				"inset": false
			}
		},
		"scaleHover": {
			"type": "number",
			"default": 1.0
		},
		"transitionDuration": {
			"type": "number",
			"default": 300
		},
		"transitionEasing": {
			"type": "string",
			"default": "ease"
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"iconPosition": {
			"type": "string",
			"default": "after"
		},
		"labelCollapse": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"mobile",
				"tablet",
				"all"
			]
		},
		"iconSize": {
			"type": "object",
			"default": {}
		},
		"iconColour": {
			"type": "string",
			"default": ""
		},
		"iconColourHover": {
			"type": "string",
			"default": ""
		},
		"iconTitle": {
			"type": "string",
			"default": ""
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"label": "Get In Touch",
			"inheritStyle": "primary",
			"icon": "arrow-right",
			"iconPosition": "after"
		}
	},
	"variations": [
		{
			"name": "primary",
			"title": "Primary",
			"description": "Solid primary-colour button.",
			"isDefault": true,
			"scope": [
				"block",
				"transform"
			],
			"isActive": [
				"inheritStyle"
			],
			"attributes": {
				"inheritStyle": "primary"
			}
		},
		{
			"name": "secondary",
			"title": "Secondary",
			"description": "Outlined button with primary text.",
			"scope": [
				"block",
				"transform"
			],
			"isActive": [
				"inheritStyle"
			],
			"attributes": {
				"inheritStyle": "secondary"
			}
		},
		{
			"name": "outline",
			"title": "Outline",
			"description": "Subtle-bordered neutral button.",
			"scope": [
				"block",
				"transform"
			],
			"isActive": [
				"inheritStyle"
			],
			"attributes": {
				"inheritStyle": "outline"
			}
		}
	]
}
