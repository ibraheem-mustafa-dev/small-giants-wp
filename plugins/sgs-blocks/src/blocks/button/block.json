{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/button",
	"version": "1.5.2",
	"title": "SGS Button",
	"category": "sgs-content",
	"description": "A highly-configurable button with a style-preset seed (primary/secondary/outline), icon support, hover states, and per-breakpoint controls.",
	"keywords": [
		"button",
		"cta",
		"link",
		"call to action"
	],
	"textdomain": "sgs-blocks",
	"icon": "button",
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"link": false,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"iconPicker": true,
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				],
				"borderWidth": [
					"borderWidth"
				],
				"borderRadius": [
					"borderRadius"
				]
			},
			"elements": {
				"button": {
					"label": "Button",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:line-height": "lineHeight",
						"css:letter-spacing": "letterSpacing",
						"css:font-style": "fontStyle",
						"css:text-transform": "textTransform",
						"css:text-decoration": "textDecoration",
						"css:color": "colourText",
						"css:color-gradient": "colourTextGradient",
						"css:background-color": "colourBackground",
						"css:background-image": "colourBackgroundGradient",
						"css:width": "customWidth",
						"css:min-height": "minHeight",
						"css:padding": "native:spacing.padding",
						"css:margin": "native:spacing.margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-color-gradient": "borderColourGradient",
						"css:border-radius": "borderRadius",
						"css:box-shadow": "boxShadow",
						"css:font-family": "fontFamily"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "colourTextHover",
								"css:color-gradient": "colourTextHoverGradient",
								"css:background-color": "colourBackgroundHover",
								"css:background-image": "colourBackgroundHoverGradient",
								"css:border-color": "borderColourHover",
								"css:border-color-gradient": "borderColourHoverGradient",
								"css:box-shadow": "boxShadowHover"
							}
						}
					}
				},
				"icon": {
					"label": "Icon",
					"order": 2,
					"clusters": [
						"text",
						"fill"
					],
					"attrMap": {
						"css:color": "iconColour",
						"css:stroke": "iconColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "iconColourHover",
								"css:stroke": "iconColourHoverGradient"
							}
						}
					},
					"_note": "iconColour/iconColourHover resolve via css:color (render.php:658 `.sgs-button__icon{color:...}`) — mirrors sgs/icon's own icon element, which uses the same css:color base + hover-state attrMap convention (Spec 35 vocabulary fix). iconSize remains an unmapped bespoke icon control, not a Text/Fill/Layout member. iconGap was deleted (D613) -- confirmed dead on both sides, no consumer anywhere in the plugin. `css:stroke` (D636/D644 icon/SVG gradient mechanism) explicit-mapped to iconColourGradient/iconColourHoverGradient, added 2026-08-16 (Builder 4) — non-empty wins over the flat currentColor paint at render time (helpers-svg-gradient.php)."
				}
			}
		}
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Click Here",
			"role": "content"
		},
		"url": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkId": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkKind": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkTarget": {
			"type": "string",
			"default": "_self"
		},
		"rel": {
			"type": "string",
			"default": ""
		},
		"download": {
			"type": "boolean",
			"default": false
		},
		"isSubmit": {
			"type": "boolean",
			"default": false
		},
		"inheritStyle": {
			"type": "string",
			"default": "primary",
			"enum": [
				"primary",
				"secondary",
				"outline",
				"custom"
			]
		},
		"widthType": {
			"type": "object",
			"default": {
				"desktop": "fit"
			}
		},
		"customWidth": {
			"type": "object",
			"default": {}
		},
		"customWidthUnit": {
			"type": "object",
			"default": {
				"desktop": "px",
				"tablet": "px",
				"mobile": "px"
			}
		},
		"minHeight": {
			"type": "object",
			"default": {}
		},
		"minHeightUnit": {
			"type": "string",
			"default": "px"
		},
		"minHeightTabletUnit": {
			"type": "string",
			"default": "px"
		},
		"minHeightMobileUnit": {
			"type": "string",
			"default": "px"
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		},
		"fontFamily": {
			"type": "string",
			"default": ""
		},
		"fontWeight": {
			"type": "string",
			"default": "600"
		},
		"fontStyle": {
			"type": "string",
			"default": "normal"
		},
		"textTransform": {
			"type": "string",
			"default": ""
		},
		"textDecoration": {
			"type": "string",
			"default": ""
		},
		"textDecorationHover": {
			"type": "string",
			"enum": [
				"none",
				"underline"
			],
			"default": "none"
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"letterSpacing": {
			"type": "object",
			"default": {}
		},
		"letterSpacingUnit": {
			"type": "string",
			"default": "px"
		},
		"colourText": {
			"type": "string",
			"default": ""
		},
		"colourTextGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the button's TEXT via background-clip:text instead of a flat colourText. Non-empty (and valid) wins at render time. Precondition: sgs/button paints its own background on the SAME selector as its text, so this instance's background paint moves onto a private `::after` layer only when this (or colourTextHoverGradient) is set — see plugins/sgs-blocks/CLAUDE.md 'Real text gradient'. Every button with no gradient set is unaffected."
		},
		"colourTextHover": {
			"type": "string",
			"default": ""
		},
		"colourTextHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state sibling of colourTextGradient. Non-empty (and valid) wins over colourTextHover on :hover/:focus-visible."
		},
		"colourBackground": {
			"type": "string",
			"default": ""
		},
		"colourBackgroundGradient": {
			"type": "string",
			"default": ""
		},
		"colourBackgroundHover": {
			"type": "string",
			"default": ""
		},
		"colourBackgroundHoverGradient": {
			"type": "string",
			"default": ""
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the button border instead of a flat colour. Non-empty wins over borderColour at render time (D636)."
		},
		"borderColourHover": {
			"type": "string",
			"default": ""
		},
		"borderColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state sibling of borderColourGradient. Non-empty wins over borderColourHover on :hover/:focus-visible."
		},
		"borderStyle": {
			"type": "string",
			"default": "solid"
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"boxShadow": {
			"type": "string",
			"default": ""
		},
		"boxShadowColour": {
			"type": "string",
			"default": ""
		},
		"boxShadowHover": {
			"type": "string",
			"default": ""
		},
		"boxShadowHoverColour": {
			"type": "string",
			"default": ""
		},
		"scaleHover": {
			"type": "number",
			"default": 1.0
		},
		"transitionDuration": {
			"type": "number",
			"default": 300
		},
		"transitionEasing": {
			"type": "string",
			"default": "ease"
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"iconPosition": {
			"type": "string",
			"default": "after"
		},
		"labelCollapse": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"mobile",
				"tablet",
				"all"
			]
		},
		"iconSize": {
			"type": "object",
			"default": {}
		},
		"iconColour": {
			"type": "string",
			"default": ""
		},
		"iconColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the icon's stroke instead of a flat colour. Non-empty wins over iconColour at render time (D636/D644)."
		},
		"iconColourHover": {
			"type": "string",
			"default": ""
		},
		"iconColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state sibling of iconColourGradient. Non-empty wins over iconColourHover on :hover/:focus-visible."
		},
		"iconTitle": {
			"type": "string",
			"default": ""
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"label": "Get In Touch",
			"inheritStyle": "primary",
			"icon": "arrow-right",
			"iconPosition": "after"
		}
	},
	"variations": [
		{
			"name": "primary",
			"title": "Primary",
			"description": "Solid primary-colour button.",
			"isDefault": true,
			"scope": [
				"block",
				"transform"
			],
			"isActive": [
				"inheritStyle"
			],
			"attributes": {
				"inheritStyle": "primary"
			}
		},
		{
			"name": "secondary",
			"title": "Secondary",
			"description": "Outlined button with primary text.",
			"scope": [
				"block",
				"transform"
			],
			"isActive": [
				"inheritStyle"
			],
			"attributes": {
				"inheritStyle": "secondary"
			}
		},
		{
			"name": "outline",
			"title": "Outline",
			"description": "Subtle-bordered neutral button.",
			"scope": [
				"block",
				"transform"
			],
			"isActive": [
				"inheritStyle"
			],
			"attributes": {
				"inheritStyle": "outline"
			}
		}
	]
}
