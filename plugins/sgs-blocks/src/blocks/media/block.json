{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/media",
	"version": "1.7.0",
	"title": "SGS Media",
	"category": "sgs-content",
	"description": "Content media block: one photo, video, embed or inline SVG, per device. Every media setting (source, alt, fit, focal point, size, ratio, shape, border, shadow, overlay, playback, caption and link) is the shared media system's, rendered by SGS_Media_Element::render().",
	"keywords": [
		"image",
		"video",
		"media",
		"photo",
		"picture",
		"figure"
	],
	"textdomain": "sgs-blocks",
	"icon": "format-image",
	"supports": {
		"sgs": {
			"motion": true,
			"scalarStylingLift": true,
			"scalarContentLift": true,
			"_comment_scalarContentLift": "Added 2026-09-08. Without this capability, extraction.py's extract_content() (Case 4: delegates_content==0, no scalar-content-lift, no array-content-lift) emits a loud ContentGap for EVERY sgs/media instance recognised as an atomic leaf (an <img>/<video>/<svg> matched directly via atomic_tag_map, not as a composite-interior column) instead of ever attempting the imageUrl/imageId/videoUrl/thumbnail lift — role='image-object' attrs existed on this block's own schema the whole time with nothing wired to read them for this shape. See resolvers/scalar_content.py's 2026-09-08 fix comment for the companion self-match + flat-trio-explosion changes this capability now reaches.",
			"mediaElements": [
				{
					"prefix": "",
					"context": "content",
					"kinds": [
						"image",
						"video",
						"embed",
						"svg"
					]
				}
			],
			"boxFamilies": {
				"padding": [
					"padding"
				],
				"borderWidth": [
					"borderWidth"
				]
			},
			"elements": {
				"video-time": {
					"motion": false,
					"selector": ".sgs-video__time",
					"label": "Video time readout",
					"order": 3,
					"clusters": [
						"text"
					],
					"prefix": "videoTime",
					"attrMap": {
						"css:-webkit-text-stroke-width": "videoTimeTextStrokeWidth",
						"css:-webkit-text-stroke-color": "videoTimeTextStrokeColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:-webkit-text-stroke-color": "videoTimeTextStrokeColourHover"
							}
						}
					}
				},
				"media": {
					"label": "Media",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"motionSelector": ".sgs-media-el",
					"attrMap": {
						"css:opacity": "opacity",
						"css:height": "height",
						"css:max-width": "maxWidth",
						"css:max-height": "maxHeight",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-color-gradient": "borderColourGradient",
						"css:border-radius": "radius",
						"css:object-fit": "fit",
						"css:object-position": "focal",
						"css:aspect-ratio": "ratio",
						"css:box-shadow": "boxShadow"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:border-color": "borderColourHover",
								"css:border-color-gradient": "borderColourHoverGradient"
							}
						}
					}
				},
				"caption": {
					"text": true,
					"label": "Caption",
					"order": 2,
					"clusters": [
						"text"
					],
					"prefix": "caption",
					"attrMap": {
						"css:color": "captionColour",
						"css:background-image": "captionColourGradient",
						"css:-webkit-text-stroke-width": "captionTextStrokeWidth",
						"css:-webkit-text-stroke-color": "captionTextStrokeColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "captionColourHover",
								"css:color-gradient": "captionColourHoverGradient",
								"css:-webkit-text-stroke-color": "captionTextStrokeColourHover"
							}
						}
					},
					"_note": "captionColourGradient is the text-colour gradient sibling to captionColour, same background-clip:text mechanism as sgs/counter's labelColour/labelColourGradient (D636 gap-closure). css:color was previously undeclared here even though render.php (step 8, `.sgs-media__caption`) already emits it — this attrMap entry documents the existing flat-colour path as well as adding the new gradient one. captionColourHover/captionColourHoverGradient added 2026-09-07 (colour-conformance bg-layer batch): this element has NO real background paint of its own at any state (style.css:75-79 sets only margin/font-size/color, no background-color/-image) — the classifier's bg-layer flag on this row is a FALSE POSITIVE (it reads this element's own `css:background-image` member, which is captionColourGradient's own text-gradient sibling, not a genuine separate background paint), so this is a plain text-gradient hover row with no precondition swap."
				}
			},
			"fx": {
				"motionSurface": true,
				"_comment_motionSurface": "The media part is the motion surface: hover zoom, entrance and effects target the media element, so the Effects panel is offered for this block (Spec 49 section 10.1)."
			}
		},
		"anchor": true,
		"className": true,
		"color": false,
		"html": false,
		"filter": {
			"duotone": true
		}
	},
	"selectors": {
		"filter": {
			"duotone": ".sgs-media-el"
		}
	},
	"attributes": {
		"shadowLiftOnHover": {
			"type": "boolean",
			"default": true
		},
		"maxWidth": {
			"type": "object"
		},
		"maxHeight": {
			"type": "object"
		},
		"height": {
			"type": "object"
		},
		"padding": {
			"type": "object"
		},
		"borderWidth": {
			"type": "object"
		},
		"borderStyle": {
			"type": "string",
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": ""
		},
		"borderColourHover": {
			"type": "string",
			"default": ""
		},
		"borderColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"overlayColour": {
			"type": "string",
			"default": ""
		},
		"overlayColourHover": {
			"type": "string",
			"default": ""
		},
		"overlayGradient": {
			"type": "string",
			"default": ""
		},
		"overlayGradientHover": {
			"type": "string",
			"default": ""
		},
		"boxShadow": {
			"type": "string",
			"default": ""
		},
		"boxShadowColour": {
			"type": "string"
		},
		"boxShadowColourHover": {
			"type": "string",
			"default": ""
		},
		"order": {
			"type": "object"
		},
		"caption": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"captionTag": {
			"type": "string",
			"default": "figcaption",
			"enum": [
				"figcaption",
				"div"
			]
		},
		"captionColour": {
			"type": "string",
			"default": ""
		},
		"captionColourGradient": {
			"type": "string",
			"default": ""
		},
		"captionColourHover": {
			"type": "string",
			"default": ""
		},
		"captionColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state gradient sibling of captionColourHover. Non-empty wins over captionColourHover on :hover/:focus-visible."
		},
		"captionFontSize": {
			"type": "integer"
		},
		"captionFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"linkUrl": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkOpensNewTab": {
			"type": "boolean",
			"default": false
		},
		"linkRel": {
			"type": "string",
			"default": ""
		},
		"linkUrlSource": {
			"type": "string",
			"default": "",
			"description": "Where the image link goes: '' (the typed linkUrl), post:<id> (a page or post, followed by ID), a Site Info link (phone, email, whatsapp, directions, google, facebook, instagram, twitter, linkedin, youtube, tiktok) or top. Resolved by includes/helpers-link-source.php; the typed linkUrl is the fallback."
		},
		"captionFontFamily": {
			"type": "string",
			"default": ""
		},
		"captionFontWeight": {
			"type": "string",
			"default": ""
		},
		"captionFontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"default": ""
		},
		"captionTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"captionTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"captionLineHeight": {
			"type": "object",
			"default": {}
		},
		"captionLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"captionLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"captionLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"captionTextAlign": {
			"type": "object",
			"default": {}
		},
		"captionTextWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"captionTextStrokeWidth": {
			"type": "object",
			"default": {}
		},
		"captionTextStrokeColour": {
			"type": "string",
			"default": ""
		},
		"captionTextStrokeColourHover": {
			"type": "string",
			"default": ""
		},
		"captionTextColumns": {
			"type": "number"
		},
		"captionWritingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		},
		"videoTimeFontSize": {
			"type": "object",
			"default": {}
		},
		"videoTimeFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"videoTimeFontWeight": {
			"type": "string",
			"default": ""
		},
		"videoTimeFontStyle": {
			"type": "string",
			"default": ""
		},
		"videoTimeFontFamily": {
			"type": "string",
			"default": ""
		},
		"videoTimeTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"videoTimeTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"videoTimeLineHeight": {
			"type": "object",
			"default": {}
		},
		"videoTimeLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"videoTimeLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"videoTimeLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"videoTimeTextWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"videoTimeTextStrokeWidth": {
			"type": "object",
			"default": {}
		},
		"videoTimeTextStrokeColour": {
			"type": "string",
			"default": ""
		},
		"videoTimeTextStrokeColourHover": {
			"type": "string",
			"default": ""
		},
		"videoTimeTextColumns": {
			"type": "number"
		},
		"videoTimeWritingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		},
		"source": {"type":"object","_generated":"media-atoms"},
		"loading": {"type":"string","_generated":"media-atoms"},
		"alt": {"type":"string","_generated":"media-atoms"},
		"decorative": {"type":"boolean","_generated":"media-atoms"},
		"fit": {"type":"object","_generated":"media-atoms"},
		"repeat": {"type":"object","_generated":"media-atoms"},
		"tileSize": {"type":"object","_generated":"media-atoms"},
		"focal": {"type":"object","_generated":"media-atoms"},
		"pinned": {"type":"boolean","_generated":"media-atoms"},
		"background": {"type":"string","_generated":"media-atoms"},
		"overlayOpacity": {"type":"object","_generated":"media-atoms"},
		"overlayBlend": {"type":"string","_generated":"media-atoms"},
		"opacity": {"type":"object","_generated":"media-atoms"},
		"blend": {"type":"string","_generated":"media-atoms"},
		"svgLayer": {"type":"string","_generated":"media-atoms"},
		"svgTextShadow": {"type":"boolean","_generated":"media-atoms"},
		"svgParts": {"type":"array","_generated":"media-atoms"},
		"svgPartsTrigger": {"type":"string","_generated":"media-atoms"},
		"playback": {"type":"object","_generated":"media-atoms"},
		"captions": {"type":"object","_generated":"media-atoms"},
		"ratio": {"type":"object","_generated":"media-atoms"},
		"width": {"type":"object","_generated":"media-atoms"},
		"minWidth": {"type":"object","_generated":"media-atoms"},
		"minHeight": {"type":"object","_generated":"media-atoms"},
		"shape": {"type":"object","_generated":"media-atoms"},
		"radius": {"type":"object","_generated":"media-atoms"},
		"colour": {"type":"object","_generated":"media-atoms"},
		"greyscale": {"type":"number","_generated":"media-atoms"},
		"alignment": {"type":"object","_generated":"media-atoms"}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"source": {
				"desktop": {
					"kind": "image",
					"url": "https://via.placeholder.com/800x600",
					"width": 800,
					"height": 600
				}
			},
			"alt": "Example image"
		}
	}
}
