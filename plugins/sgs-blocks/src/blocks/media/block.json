{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/media",
	"version": "1.7.0",
	"title": "SGS Media",
	"category": "sgs-content",
	"description": "Content media block — image or video. Use mediaType to choose image (with imageUrl) or video (with videoUrl for external embeds or videoId for WP-library uploads). Media styling (object-fit, max-width/height + tiers, border-radius, alignment, etc.) is driven entirely by this block's own NATIVE attributes and its Media Styling panel — this block deliberately OPTS OUT of the shared universal image-controls extension (no supports.sgs.imageControls) so there is ONE source of truth the cloning converter writes and the editor edits. supports.filter.duotone (T3.5, D402 ADOPT) is a separate native WP support — WP core renders it as a generated class + <style> tag (not an inline style= attribute), so it needs no render.php involvement and satisfies the no-inline contract as-is. supports.dimensions.aspectRatio (Spec 35 wave-B, D402 ADOPT) replaces the old hand-rolled `aspectRatio` scalar attr + TextControl — UNLIKE duotone, WP core's aspect-ratio support (`wp_render_dimensions_support()` in wp-includes/block-supports/dimensions.php) is a bespoke render_block filter that unconditionally writes an inline `style=\"aspect-ratio:…\"` on the block's ROOT wrapper tag and does NOT consult block.json `selectors` at all — so it both violates the no-inline contract AND targets the wrong element (the <figure> wrapper, not the <img>/<video>). `__experimentalSkipSerialization` on `supports.dimensions` makes WP emit nothing automatically (the render_block filter returns early); render.php then reads `style.dimensions.aspectRatio` itself and emits the CSS via `wp_style_engine_get_styles()` scoped to `.sgs-media__img, .sgs-media__video` — same pattern as the native border group above. The `selectors.dimensions.aspectRatio` entry below is declared for consistency/future-proofing but is currently INERT for this feature (core's aspect-ratio filter never reads it).",
	"keywords": [
		"image",
		"video",
		"media",
		"photo",
		"picture",
		"figure"
	],
	"textdomain": "sgs-blocks",
	"icon": "format-image",
	"supports": {
		"sgs": {
			"scalarStylingLift": true,
			"boxFamilies": {
				"borderRadius": [
					"borderRadiusTablet",
					"borderRadiusMobile"
				]
			},
			"elements": {
				"media": {
					"label": "Media",
					"order": 1,
					"clusters": [ "fill", "layout" ],
					"isWrapper": true,
					"attrMap": {
						"css:opacity": "opacity",
						"css:height": "height",
						"css:max-width": "maxWidth",
						"css:max-height": "maxHeight",
						"css:border-width": "native:__experimentalBorder.width",
						"css:border-style": "native:__experimentalBorder.style",
						"css:border-color": "native:__experimentalBorder.color",
						"css:border-radius": "native:__experimentalBorder.radius",
						"css:box-shadow": "boxShadow",
						"css:object-fit": "objectFit"
					}
				},
				"caption": {
					"label": "Caption",
					"order": 2,
					"clusters": [ "text" ],
					"prefix": "caption"
				}
			}
		},
		"anchor": true,
		"className": true,
		"color": false,
		"html": false,
		"filter": {
			"duotone": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"style": true,
			"color": true,
			"__experimentalSkipSerialization": true
		},
		"dimensions": {
			"aspectRatio": true,
			"__experimentalSkipSerialization": true
		}
	},
	"selectors": {
		"filter": {
			"duotone": ".sgs-media__img, .sgs-media__video"
		},
		"dimensions": {
			"aspectRatio": ".sgs-media__img, .sgs-media__video"
		}
	},
	"attributes": {
		"mediaType": {
			"type": "string",
			"default": "image",
			"enum": [
				"image",
				"video",
				"svg"
			]
		},
		"svgContent": {
			"type": "string",
			"default": ""
		},
		"svgAnimation": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"pulse",
				"float",
				"wave"
			]
		},
		"svgAnimationSpeed": {
			"type": "string",
			"default": "medium",
			"enum": [
				"slow",
				"medium",
				"fast"
			]
		},
		"videoUrl": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"videoSource": {
			"type": "string",
			"default": "external",
			"enum": [
				"external",
				"internal"
			]
		},
		"videoId": {
			"type": "integer",
			"default": null
		},
		"videoMimeType": {
			"type": "string",
			"default": ""
		},
		"videoPoster": {
			"type": "string",
			"default": ""
		},
		"videoPosterId": {
			"type": "integer",
			"default": null
		},
		"videoAutoplay": {
			"type": "boolean",
			"default": false
		},
		"videoLoop": {
			"type": "boolean",
			"default": false
		},
		"videoMuted": {
			"type": "boolean",
			"default": true
		},
		"videoControls": {
			"type": "boolean",
			"default": true
		},
		"videoPlaysInline": {
			"type": "boolean",
			"default": true
		},
		"videoLazyLoad": {
			"type": "boolean",
			"default": true
		},
		"imageId": {
			"type": "integer",
			"default": null
		},
		"imageUrl": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"imageAlt": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"imageIsDecorative": {
			"type": "boolean",
			"default": false,
			"_comment": "Spec 35 T3.4 / Part C 'A11y/SEO as controls' + E6 — WCAG 2.1 AA 1.1.1 (Non-text Content): a purely decorative image must be hidden from assistive tech (empty alt + aria-hidden) rather than forcing the operator to leave alt blank and hope. Narrow v1 scope: sgs/media + sgs/decorative-image only."
		},
		"imageWidth": {
			"type": "integer",
			"default": null
		},
		"imageHeight": {
			"type": "integer",
			"default": null
		},
		"maxWidth": {
			"type": "string",
			"default": null
		},
		"maxWidthUnit": {
			"type": "string",
			"default": "px"
		},
		"maxWidthMobile": {
			"type": "string",
			"default": null
		},
		"maxWidthTablet": {
			"type": "string",
			"default": null
		},
		"maxHeight": {
			"type": "string",
			"default": null
		},
		"maxHeightUnit": {
			"type": "string",
			"default": "px"
		},
		"maxHeightMobile": {
			"type": "string",
			"default": null
		},
		"maxHeightTablet": {
			"type": "string",
			"default": null
		},
		"height": {
			"type": "string",
			"default": null
		},
		"heightUnit": {
			"type": "string",
			"default": "px"
		},
		"heightMobile": {
			"type": "string",
			"default": null
		},
		"heightTablet": {
			"type": "string",
			"default": null
		},
		"objectFit": {
			"type": "string",
			"default": "cover",
			"enum": [
				"cover",
				"contain",
				"fill",
				"none",
				"scale-down"
			]
		},
		"objectPosition": {
			"type": "string",
			"default": "center center"
		},
		"borderRadiusTablet": {
			"type": "object",
			"default": {}
		},
		"borderRadiusMobile": {
			"type": "object",
			"default": {}
		},
		"boxShadow": {
			"type": "string",
			"default": ""
		},
		"opacity": {
			"type": "number",
			"default": 1
		},
		"alignment": {
			"type": "string",
			"default": "left",
			"enum": [
				"left",
				"center",
				"right"
			]
		},
		"order": {
			"type": "integer",
			"default": null
		},
		"orderMobile": {
			"type": "integer",
			"default": null
		},
		"orderTablet": {
			"type": "integer",
			"default": null
		},
		"caption": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"captionTag": {
			"type": "string",
			"default": "figcaption",
			"enum": [
				"figcaption",
				"div"
			]
		},
		"captionColour": {
			"type": "string",
			"default": ""
		},
		"captionFontSize": {
			"type": "integer",
			"default": null
		},
		"captionFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"linkUrl": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"linkOpensNewTab": {
			"type": "boolean",
			"default": false
		},
		"linkRel": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"mediaType": "image",
			"imageUrl": "https://via.placeholder.com/800x600",
			"imageAlt": "Example image",
			"imageWidth": 800,
			"imageHeight": 600,
			"objectFit": "cover",
			"alignment": "center"
		}
	}
}
