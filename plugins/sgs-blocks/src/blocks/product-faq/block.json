{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/product-faq",
	"version": "0.1.0",
	"title": "SGS Product FAQ",
	"category": "sgs-content",
	"description": "A dedicated FAQ section for your product pages. Outputs structured FAQ data that improves AI search citation and Bing visibility by making your Q&A content machine-readable.",
	"keywords": [
		"faq",
		"questions",
		"answers",
		"product",
		"schema",
		"structured data"
	],
	"textdomain": "sgs-blocks",
	"icon": "editor-help",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "content",
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				],
				"borderRadius": [
					"borderRadiusTablet",
					"borderRadiusMobile"
				]
			},
			"elements": {
				"box": {
					"label": "FAQ section",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:font-size": "fontSize",
						"css:line-height": "lineHeight",
						"css:padding": "native:spacing.padding",
						"css:margin": "native:spacing.margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:max-width": "maxWidth",
						"css:border-color-gradient": "borderColourGradient",
						"css:background-image": "textColourGradient"
					},
					"_note": "Content-KIND composite (supports.sgs.containerKind='content', D294 box+width only) — every style control here is a WordPress-native wrapper support (color/spacing/border) plus maxWidth; typography migrated off native WP support onto the shared TypographyControls/sgs_typography_css_rule() mechanism (D971/D972), root prefix '' (fontSize/fontWeight/fontStyle/lineHeight). No per-element (heading/icon) typography attrs exist on this block, so heading/icon text styling is an honest gap inherited from the wrapper, not independently controlled. textColourGradient is the text-colour gradient sibling to textColour, same background-clip:text mechanism as sgs/counter's labelColour/labelColourGradient (D636 gap-closure)."
				}
			}
		}
	},
	"selectors": {
		"root": ".wp-block-sgs-product-faq"
	},
	"attributes": {
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": "Frequently Asked Questions",
			"role": "content"
		},
		"headingLevel": {
			"type": "string",
			"default": "h2",
			"enum": [
				"h2",
				"h3",
				"h4",
				"p"
			]
		},
		"iconPosition": {
			"type": "string",
			"default": "right",
			"enum": [
				"right",
				"left"
			]
		},
		"maxWidth": {
			"type": "string",
			"default": ""
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {}
		},
		"borderRadiusTablet": {
			"type": "object",
			"default": {}
		},
		"borderRadiusMobile": {
			"type": "object",
			"default": {}
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"fontStyle": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		}
	},
	"providesContext": {
		"sgs/productFaqIconPosition": "iconPosition"
	},
	"allowedBlocks": [
		"sgs/product-faq-item"
	],
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"heading": "Frequently Asked Questions",
			"headingLevel": "h2",
			"iconPosition": "right"
		},
		"innerBlocks": [
			{
				"name": "sgs/product-faq-item",
				"attributes": {
					"question": "What are the ingredients?"
				}
			},
			{
				"name": "sgs/product-faq-item",
				"attributes": {
					"question": "How should I store this product?"
				}
			}
		]
	}
}
