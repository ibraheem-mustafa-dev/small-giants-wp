{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/countdown-timer",
	"version": "0.1.0",
	"title": "SGS Countdown Timer",
	"category": "sgs-interactive",
	"description": "Countdown to a target date or an evergreen timer with customisable styling.",
	"keywords": [
		"countdown",
		"timer",
		"date",
		"event",
		"launch"
	],
	"textdomain": "sgs-blocks",
	"icon": "clock",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		},
		"interactivity": true,
		"sgs": {
			"boxFamilies": {
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				],
				"borderRadius": [
					"borderRadius"
				],
				"borderWidth": [
					"borderWidth"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Timer box",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:color-gradient": "textColourGradient",
						"css:background-color": "backgroundColour",
						"css:background-image": "backgroundColourGradient",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:border-color-gradient": "borderColourGradient",
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:font-style": "fontStyle",
						"css:line-height": "lineHeight",
						"css:text-align": "textAlign"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "textColourHover",
								"css:color-gradient": "textColourHoverGradient"
							}
						}
					},
					"_note": "Root typography (fontSize/fontWeight/fontStyle/lineHeight and the extended set) uses the shared TypographyControls/sgs_typography_css_rule() mechanism, root prefix '', and serialises on the wrapper as an inherited default for any text the number, label and expired-message elements do not style themselves. Those three elements each own a typography surface (prefixes number, label, expired), so a per-digit, per-label or per-message size, weight, transform or spacing is set on the element, not the wrapper. textAlign is a plain attribute edited through TypographyControls' own text-align field and emitted by render.php as a scoped declaration on the wrapper. textColourHover/textColourHoverGradient (2026-09-07, colour-conformance) are safe to paint directly on the wrapper's own selector because backgroundColour is ALREADY moved onto its own ::after layer via sgs_block_background_layer_css() (render.php) — background-clip:text on hover can never clip a background that isn't painted on this element."
				},
				"number": {
					"label": "Number",
					"order": 2,
					"clusters": [
						"text",
						"fill"
					],
					"prefix": "number",
					"attrMap": {
						"css:background-image": "numberColourGradient",
						"css:font-size": "numberFontSize",
						"css:font-weight": "numberFontWeight",
						"css:font-style": "numberFontStyle",
						"css:font-family": "numberFontFamily",
						"css:text-transform": "numberTextTransform",
						"css:text-decoration": "numberTextDecoration",
						"css:line-height": "numberLineHeight",
						"css:letter-spacing": "numberLetterSpacing",
						"css:text-align": "numberTextAlign",
						"css:text-wrap": "numberTextWrap",
						"css:column-count": "numberTextColumns",
						"css:writing-mode": "numberWritingMode"
					},
					"_note": "numberColourGradient (D636 Task 1b) is the text-colour gradient sibling to numberColour — background-clip:text mechanism; the 'fill' cluster was added solely to place this member (every other fill member is an honest GAP, this element has no background/border surface). The number* typography family is painted on .sgs-countdown__number by sgs_typography_css_rule( $attributes, 'number', … )."
				},
				"label": {
					"label": "Label",
					"order": 3,
					"clusters": [
						"text"
					],
					"prefix": "label",
					"attrMap": {
						"css:color-gradient": "labelColourGradient",
						"css:font-size": "labelFontSize",
						"css:font-weight": "labelFontWeight",
						"css:font-style": "labelFontStyle",
						"css:font-family": "labelFontFamily",
						"css:text-transform": "labelTextTransform",
						"css:text-decoration": "labelTextDecoration",
						"css:line-height": "labelLineHeight",
						"css:letter-spacing": "labelLetterSpacing",
						"css:text-align": "labelTextAlign",
						"css:text-wrap": "labelTextWrap",
						"css:column-count": "labelTextColumns",
						"css:writing-mode": "labelWritingMode"
					}
				},
				"expired": {
					"label": "Expired message",
					"order": 4,
					"clusters": [
						"text"
					],
					"prefix": "expired",
					"attrMap": {
						"css:font-size": "expiredFontSize",
						"css:font-weight": "expiredFontWeight",
						"css:font-style": "expiredFontStyle",
						"css:font-family": "expiredFontFamily",
						"css:text-transform": "expiredTextTransform",
						"css:text-decoration": "expiredTextDecoration",
						"css:line-height": "expiredLineHeight",
						"css:letter-spacing": "expiredLetterSpacing",
						"css:text-align": "expiredTextAlign",
						"css:text-wrap": "expiredTextWrap",
						"css:column-count": "expiredTextColumns",
						"css:writing-mode": "expiredWritingMode"
					}
				}
			},
			"spacingDefaults": {
				"padding": {
					"top": "var(--wp--preset--spacing--40)",
					"right": "var(--wp--preset--spacing--40)",
					"bottom": "var(--wp--preset--spacing--40)",
					"left": "var(--wp--preset--spacing--40)"
				}
			}
		}
	},
	"selectors": {
		"root": ".wp-block-sgs-countdown-timer"
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"targetDate": {
			"type": "string",
			"default": ""
		},
		"evergreenMode": {
			"type": "boolean",
			"default": false
		},
		"evergreenHours": {
			"type": "number",
			"default": 24
		},
		"evergreenMinutes": {
			"type": "number",
			"default": 0
		},
		"expiredMessage": {
			"type": "string",
			"default": "This offer has expired."
		},
		"showDays": {
			"type": "boolean",
			"default": true
		},
		"showHours": {
			"type": "boolean",
			"default": true
		},
		"showMinutes": {
			"type": "boolean",
			"default": true
		},
		"showSeconds": {
			"type": "boolean",
			"default": true
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": "",
			"description": "Hover-state gradient sibling of textColourHover. Non-empty wins over textColourHover on :hover/:focus-visible."
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"numberColour": {
			"type": "string",
			"default": ""
		},
		"numberColourGradient": {
			"type": "string",
			"default": ""
		},
		"labelColour": {
			"type": "string",
			"default": "text-muted"
		},
		"labelColourGradient": {
			"type": "string",
			"default": ""
		},
		"cardStyle": {
			"type": "string",
			"default": "elevated"
		},
		"digitStyle": {
			"type": "string",
			"default": "simple"
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"fontStyle": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"textAlign": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"description": "Wrapper text alignment — a plain attribute edited by TypographyControls' text-align field, emitted by render.php as a scoped declaration."
		},
		"fontFamily": {
			"type": "string",
			"default": ""
		},
		"textTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"textDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"letterSpacing": {
			"type": "object",
			"default": {}
		},
		"letterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"textWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"textColumns": {
			"type": "number"
		},
		"writingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		},
		"numberFontSize": {
			"type": "object",
			"default": {}
		},
		"numberFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"numberFontWeight": {
			"type": "string",
			"default": ""
		},
		"numberFontStyle": {
			"type": "string",
			"default": ""
		},
		"numberFontFamily": {
			"type": "string",
			"default": ""
		},
		"numberTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"numberTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"numberLineHeight": {
			"type": "object",
			"default": {}
		},
		"numberLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"numberLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"numberLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"numberTextAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"numberTextWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"numberTextColumns": {
			"type": "number"
		},
		"numberWritingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		},
		"labelFontSize": {
			"type": "object",
			"default": {}
		},
		"labelFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"labelFontWeight": {
			"type": "string",
			"default": ""
		},
		"labelFontStyle": {
			"type": "string",
			"default": ""
		},
		"labelFontFamily": {
			"type": "string",
			"default": ""
		},
		"labelTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"labelTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"labelLineHeight": {
			"type": "object",
			"default": {}
		},
		"labelLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"labelLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"labelLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"labelTextAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"labelTextWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"labelTextColumns": {
			"type": "number"
		},
		"labelWritingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		},
		"expiredFontSize": {
			"type": "object",
			"default": {}
		},
		"expiredFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"expiredFontWeight": {
			"type": "string",
			"default": ""
		},
		"expiredFontStyle": {
			"type": "string",
			"default": ""
		},
		"expiredFontFamily": {
			"type": "string",
			"default": ""
		},
		"expiredTextTransform": {
			"type": "string",
			"enum": [
				"",
				"none",
				"uppercase",
				"lowercase",
				"capitalize"
			],
			"default": ""
		},
		"expiredTextDecoration": {
			"type": "string",
			"enum": [
				"",
				"none",
				"underline",
				"line-through"
			],
			"default": ""
		},
		"expiredLineHeight": {
			"type": "object",
			"default": {}
		},
		"expiredLineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"expiredLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"expiredLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"expiredTextAlign": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"default": ""
		},
		"expiredTextWrap": {
			"type": "string",
			"enum": [
				"",
				"wrap",
				"nowrap",
				"balance",
				"pretty",
				"stable"
			],
			"default": ""
		},
		"expiredTextColumns": {
			"type": "number"
		},
		"expiredWritingMode": {
			"type": "string",
			"enum": [
				"",
				"horizontal-tb",
				"vertical-rl",
				"vertical-lr"
			],
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"cardStyle": "elevated",
			"showDays": true,
			"showHours": true,
			"showMinutes": true,
			"showSeconds": true
		}
	}
}
