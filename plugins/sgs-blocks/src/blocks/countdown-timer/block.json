{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/countdown-timer",
	"version": "0.1.0",
	"title": "SGS Countdown Timer",
	"category": "sgs-interactive",
	"description": "Countdown to a target date or an evergreen timer with customisable styling.",
	"keywords": [
		"countdown",
		"timer",
		"date",
		"event",
		"launch"
	],
	"textdomain": "sgs-blocks",
	"icon": "clock",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		},
		"interactivity": true,
		"sgs": {
			"boxFamilies": {
				"padding": [
					"padding"
				],
				"margin": [
					"margin"
				],
				"borderRadius": [
					"borderRadius"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Timer box",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:background-color": "native:color.background",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:border-color-gradient": "borderColourGradient",
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:font-style": "fontStyle",
						"css:line-height": "lineHeight",
						"css:text-align": "textAlign"
					},
					"_note": "Typography migrated off WP-native supports.typography onto the shared TypographyControls/sgs_typography_css_rule() mechanism (D971/D972 full-replacement track), root prefix '' (fontSize/fontWeight/fontStyle/lineHeight). No selectors.typography is declared (only selectors.root), so the root-level typography serialises as an inherited default on the wrapper rather than a per-digit or per-label control — mirrors quote's root-typography-is-inherited-default precedent, so neither child element claims a text cluster for size. textAlign stays a plain (non-supports) attribute with its own SelectControl since TypographyControls does not offer a text-align field."
				},
				"number": {
					"label": "Number",
					"order": 2,
					"clusters": [
						"text",
						"fill"
					],
					"prefix": "number",
					"attrMap": {
						"css:background-image": "numberColourGradient"
					},
					"_note": "numberColourGradient (D636 Task 1b) is the text-colour gradient sibling to numberColour — background-clip:text mechanism; the 'fill' cluster was added solely to place this member (every other fill member is an honest GAP, this element has no background/border surface)."
				},
				"label": {
					"label": "Label",
					"order": 3,
					"clusters": [
						"text"
					],
					"prefix": "label",
					"attrMap": {
						"css:color-gradient": "labelColourGradient"
					}
				}
			}
		}
	},
	"selectors": {
		"root": ".wp-block-sgs-countdown-timer"
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"targetDate": {
			"type": "string",
			"default": ""
		},
		"evergreenMode": {
			"type": "boolean",
			"default": false
		},
		"evergreenHours": {
			"type": "number",
			"default": 24
		},
		"evergreenMinutes": {
			"type": "number",
			"default": 0
		},
		"expiredMessage": {
			"type": "string",
			"default": "This offer has expired."
		},
		"showDays": {
			"type": "boolean",
			"default": true
		},
		"showHours": {
			"type": "boolean",
			"default": true
		},
		"showMinutes": {
			"type": "boolean",
			"default": true
		},
		"showSeconds": {
			"type": "boolean",
			"default": true
		},
		"numberColour": {
			"type": "string",
			"default": "primary"
		},
		"numberColourGradient": {
			"type": "string",
			"default": ""
		},
		"labelColour": {
			"type": "string",
			"default": "text-muted"
		},
		"labelColourGradient": {
			"type": "string",
			"default": ""
		},
		"cardStyle": {
			"type": "string",
			"default": "elevated"
		},
		"digitStyle": {
			"type": "string",
			"default": "simple"
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"fontStyle": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"textAlign": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"justify"
			],
			"description": "Migrated off WP-native supports.typography.textAlign (D971/D972 full-replacement track) — plain attribute + own SelectControl, since typography.fontSize was the only native flag TypographyControls replaces."
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"cardStyle": "elevated",
			"showDays": true,
			"showHours": true,
			"showMinutes": true,
			"showSeconds": true
		}
	}
}
