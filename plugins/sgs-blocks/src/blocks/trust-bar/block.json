{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/trust-bar",
	"version": "0.5.4",
	"title": "SGS Trust Bar",
	"category": "sgs-content",
	"description": "Horizontal strip of trust signals. Three variants: icon-in-circle (default), text-only pill badges, and image-badge (certification logos). Typed mode only: curated items[] repeater. Merged from sgs/certification-bar 2026-05-29 D95.",
	"keywords": [
		"trust",
		"badges",
		"icons",
		"certifications",
		"accreditation",
		"halal",
		"brc",
		"features"
	],
	"textdomain": "sgs-blocks",
	"icon": "awards",
	"supports": {
		"sgs": {
			"_comment_overlayNotAdopted": "backgroundOverlayColour/Opacity/OpacityTablet/OpacityMobile/ColourHover/BlendMode are deliberately NOT routed through supports.sgs.mediaElements' overlay atom (detector rule 37-media-no-handroll) -- same reasoning as sgs/container (see its block.json for the full note): this block's overlay renders through the shared SGS_Container_Wrapper, whose own sgs_overlay_decls()-based emission is already more capable than the atom (until the atom system gains a caller-supplied-selector mode). Tracked as a future atom-layer capability, not a silent gap.",
			"collection": true,
			"iconPicker": true,
			"is_section_root": true,
			"containerKind": "section",
			"enabledExtensions": [
				"width",
				"layout",
				"background",
				"shapeDividers"
			],
			"arrayContentLift": true,
			"scalarStylingLift": true,
			"_comment_mediaElements": "badgeImageObjectFit already matches mediaAttrName('badgeImage','ObjectFit') — wired directly onto the existing attribute, no rename/bridge needed (detector rule 37-media-no-handroll).",
			"mediaElements": [
				{ "prefix": "badgeImage", "context": "element", "atoms": [ "object-fit" ] }
			],
			"variantAttr": "badgeStyle",
			"variants": {
				"icon-circle": [
					"iconCircleSize",
					"iconCircleBackground",
					"iconColour",
					"iconCircleBorderRadius",
					"iconCircleShadow"
				],
				"text-only": [],
				"image-badge": [
					"badgeImageBorderRadius",
					"badgeImageSize",
					"badgeImageShadow",
					"badgeImageObjectFit"
				]
			},
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				],
				"contentBandPadding": [
					"contentBandPadding"
				],
				"borderRadius": [
					"borderRadiusTablet",
					"borderRadiusMobile"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Section wrapper",
					"layer": "OUTER",
					"_layer_note": "section-KIND composite rendered via SGS_Container_Wrapper (D294 — keeps the wrapper, genuine grid/section). This element is both the block root and the grid definition, mirroring sgs/card-grid's grid element.",
					"order": 1,
					"clusters": [
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:color": "textColour",
						"css:background-attachment": "backgroundAttachment",
						"css:background-position": "backgroundPosition",
						"css:background-repeat": "backgroundRepeat",
						"css:background-size": "backgroundSize",
						"css:background-image": "backgroundOverlayColour",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:max-width": "maxWidth",
						"css:min-height": "minHeight",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:box-shadow": "shadow",
						"css:gap": "gap",
						"css:grid-template-columns": "gridTemplateColumns",
						"css:grid-template-rows": "gridTemplateRows",
						"css:grid-auto-rows": "gridAutoRows",
						"css:justify-items": "justifyItems",
						"css:justify-content": "justifyContent",
						"css:align-content": "alignContent",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap",
						"css:border-color-gradient": "borderColourGradient"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:background-color": "backgroundColourHover",
								"css:color": "textColourHover"
							}
						}
					},
					"_note": "gridTemplateColumns/Rows, gap, justify-*/align-content/flex-* are consumed by SGS_Container_Wrapper via the universal wrapper mechanism (render.php:214-220 comment). No alignItems/display/overflow/aspect-ratio/width/height/max-height attrs exist — honest gaps."
				},
				"icon-badge": {
					"label": "Icon badge (icon-circle variant)",
					"order": 2,
					"clusters": [
						"fill",
						"layout",
						"text"
					],
					"prefix": "icon",
					"attrMap": {
						"css:background-color": "iconCircleBackground",
						"css:background-image": "iconCircleBackgroundGradient",
						"css:width": "iconCircleSize",
						"css:height": "iconCircleSize",
						"css:border-radius": "iconCircleBorderRadius",
						"css:box-shadow": "iconCircleShadow",
						"css:color": "iconColour",
						"css:stroke": "iconColourGradient",
						"css:box-shadow-color": "iconCircleShadowColour"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "iconColourHover"
							}
						}
					},
					"_note": "iconColour (the SVG stroke/fill colour, style.css:80 `color: var(--sgs-trust-badge-icon-colour, ...)`) resolves via css:color (text cluster) — mirrors sgs/icon's own icon element + sgs/business-info's icon element, which use the same functional-icon-colour/css:color convention (Spec 35 vocabulary fix). Only applies when badgeStyle='icon-circle' (supports.sgs.variants). `css:stroke` (D636/D644 icon/SVG gradient mechanism) explicit-mapped to iconColourGradient, added 2026-08-16 (Builder 4) — non-empty wins over iconColour's flat currentColor paint at render time (helpers-svg-gradient.php). iconColourHover pairs with the resting iconColour above (2026-09-02) — render.php:255-258 emits it as a `color:` decl scoped to the block ROOT rather than a dedicated icon-badge selector, but the element it semantically belongs to (and the one its resting twin is declared on) is icon-badge, matching check-hover-state-classification.py's resting-twin discriminator."
				},
				"label": {
					"label": "Badge label",
					"order": 3,
					"clusters": [
						"text"
					],
					"prefix": "label",
					"_note": "Typography only (labelFontSize/labelFontWeight/labelFontStyle, render.php:393) — covers both variants via a compound selector. Colour is NOT claimed here: on icon-circle it's the separate textColour attr (render.php:54,111 -> --sgs-trust-badge-text-colour -> style.css:106 .sgs-trust-bar--icon-circle .sgs-trust-bar__label); on text-only/image-badge it's labelColour, claimed by the sibling badge-label element instead — one attrMap slot can't hold two attributes, and the two variants render different class names for what would otherwise be the same conceptual node."
				},
				"badge-label": {
					"label": "Badge label colour (text-only / image-badge variants)",
					"order": 3,
					"clusters": [
						"text"
					],
					"prefix": "",
					"attrMap": {
						"css:color": "labelColour",
						"css:background-image": "labelColourGradient"
					},
					"_note": "Same conceptual node as `label` above, but a DIFFERENT class name (.sgs-trust-bar__badge-label, render.php:281) rendered only by the text-only/image-badge variants — split into its own element because the DB's css_element column holds one name per attribute and the two variants genuinely use two different class names."
				},
				"title": {
					"label": "Title",
					"order": 4,
					"clusters": [
						"text"
					],
					"prefix": "title",
					"attrMap": {
						"css:color": "titleColour",
						"css:background-image": "titleColourGradient"
					}
				},
				"badge-item": {
					"label": "Badge item",
					"order": 5,
					"clusters": [],
					"_note": "Per-item fillStyle/fillColour (image-badge and text-only item content) are repeater-row fields, not independent block-level style controls — no badge-item-specific text/fill/layout attrs exist at the block level."
				},
				"badge-img": {
					"label": "Badge image (image-badge variant)",
					"order": 6,
					"clusters": [
						"fill",
						"layout"
					],
					"prefix": "badgeImage",
					"attrMap": {
						"css:width": "badgeImageSize",
						"css:height": "badgeImageSize",
						"css:object-fit": "badgeImageObjectFit",
						"css:border-radius": "badgeImageBorderRadius",
						"css:box-shadow": "badgeImageShadow"
					},
					"_note": "The <img> in the image-badge variant (render.php:281-297, .sgs-trust-bar__badge-img). Mirrors icon-badge size/border-radius/box-shadow plus an image-specific object-fit; badgeImageSize maps css:width AND css:height (a single square dimension, render.php:284-285). Emitted only when badgeStyle=image-badge."
				}
			}
		},
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"text": false,
			"background": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		}
	},
	"selectors": {
		"root": ".wp-block-sgs-trust-bar",
		"typography": ".sgs-trust-bar__label"
	},
	"attributes": {
		"padding": {
			"type": "object",
			"default": {}
		},
		"margin": {
			"type": "object",
			"default": {}
		},
		"badgeStyle": {
			"type": "string",
			"default": "icon-circle",
			"enum": [
				"icon-circle",
				"text-only",
				"image-badge"
			]
		},
		"items": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"icon": {
						"type": "string"
					},
					"iconSvg": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"url": {
						"type": "string",
						"role": "url-href"
					},
					"linkTarget": {
						"type": "string"
					},
					"linkRel": {
						"type": "string"
					},
					"fillStyle": {
						"type": "string",
						"enum": [
							"outline",
							"filled"
						],
						"default": "outline"
					},
					"fillColour": {
						"type": "string"
					},
					"media": {
						"type": "object",
						"properties": {
							"url": {
								"type": "string"
							},
							"alt": {
								"type": "string"
							}
						}
					},
					"decorative": {
						"type": "boolean",
						"default": false,
						"description": "image-badge variant only. Explicit editorial choice (WCAG 2.1 AA 1.1.1) that this badge's image carries no information — render.php blanks its alt text and adds aria-hidden so assistive tech skips it entirely."
					},
					"_key": {
						"type": "string",
						"_note": "Client-generated stable identity (src/utils/generateItemKey.js), not a client-visible field — no label, no editor control. Scopes this item's own object-fit CSS (image-badge variant only) so a fit value survives reorder/add/remove instead of following array index (Spec 35 Part 4). Backfilled silently on mount for items created before this field existed."
					},
					"objectFit": {
						"type": "string",
						"enum": [ "cover", "contain" ],
						"default": "cover",
						"description": "image-badge variant only. Per-item object-fit override — badges are logos/certification marks, so no focal-point/crop field exists here by design (see sgs/testimonial orgLogo, sgs/brand-strip logoFit)."
					}
				}
			},
			"default": [
				{
					"icon": "truck",
					"label": "Fast delivery"
				},
				{
					"icon": "check",
					"label": "Certified quality"
				},
				{
					"icon": "star",
					"label": "Trusted service"
				},
				{
					"icon": "heart",
					"label": "Loved by customers"
				}
			]
		},
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"titleColour": {
			"type": "string",
			"default": "text-muted"
		},
		"titleColourGradient": {
			"type": "string",
			"default": ""
		},
		"titleFontSize": {
			"type": "object",
			"default": {}
		},
		"titleFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"titleFontWeight": {
			"type": "string",
			"default": ""
		},
		"titleFontStyle": {
			"type": "string",
			"default": ""
		},
		"titleLineHeight": {
			"type": "number"
		},
		"titleLineHeightUnit": {
			"type": "string",
			"default": ""
		},
		"labelColour": {
			"type": "string",
			"default": "text"
		},
		"labelColourGradient": {
			"type": "string",
			"default": ""
		},
		"labelFontSize": {
			"type": "object",
			"default": {}
		},
		"labelFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"labelFontWeight": {
			"type": "string",
			"default": ""
		},
		"labelFontStyle": {
			"type": "string",
			"default": ""
		},
		"badgeSize": {
			"type": "string",
			"default": "medium",
			"enum": [
				"small",
				"medium",
				"large"
			]
		},
		"iconCircleSize": {
			"type": "number",
			"default": 44
		},
		"iconCircleBackground": {
			"type": "string",
			"default": "surface"
		},
		"iconCircleBackgroundGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the icon-circle badge background via a --sgs-trust-badge-circle-bg-gradient custom-property sibling (helpers-tokens.php sgs_custom_property_gradient_decls shape). Non-empty wins over iconCircleBackground (icon-circle variant only)."
		},
		"iconColour": {
			"type": "string",
			"default": "primary-dark"
		},
		"iconColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the badge icon's stroke instead of a flat colour (icon-circle variant only). Non-empty wins over iconColour at render time (D636/D644)."
		},
		"iconCircleBorderRadius": {
			"type": "string",
			"default": "50%"
		},
		"iconCircleShadow": {
			"type": "string",
			"default": "subtle"
		},
		"iconCircleShadowColour": {
			"type": "string"
		},
		"iconCircleShadowColourHover": {
			"type": "string",
			"default": ""
		},
		"badgeImageBorderRadius": {
			"type": "string",
			"default": ""
		},
		"badgeImageSize": {
			"type": "number",
			"default": 60
		},
		"badgeImageShadow": {
			"type": "string",
			"default": ""
		},
		"badgeImageShadowColour": {
			"type": "string"
		},
		"badgeImageShadowColourHover": {
			"type": "string",
			"default": ""
		},
		"badgeImageObjectFit": {
			"type": "string",
			"default": "contain",
			"enum": [
				"cover",
				"contain"
			]
		},
		"textColour": {
			"type": "string",
			"default": "text"
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 4,
				"tablet": 4,
				"mobile": 2
			}
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": "0.5rem"
			},
			"_comment": "Was the bare number \"20\", which the old flat path read as WordPress spacing-scale SLUG 20 = 0.5rem (theme.json settings.spacing.spacingSizes). A bare number now means px (Bean-ruled 2026-08-10), so the value is stated explicitly to render EXACTLY as before rather than jumping to 20px. This block is pure-wrapper (render.php:86 — gap is handled entirely by the shared wrapper), so it had no render.php fallback shielding it."
		},
		"autoScroll": {
			"type": "boolean",
			"default": false
		},
		"autoScrollSpeed": {
			"type": "string",
			"default": "medium",
			"enum": [
				"slow",
				"medium",
				"fast"
			]
		},
		"autoScrollPauseOnHover": {
			"type": "boolean",
			"default": true
		},
		"layout": {
			"type": "string",
			"enum": [
				"",
				"flex",
				"stack",
				"grid"
			],
			"default": "grid"
		},
		"gridTemplateColumns": {
			"type": "object",
			"default": {
				"desktop": "repeat(4, 1fr)",
				"tablet": "repeat(4, 1fr)",
				"mobile": "1fr 1fr"
			}
		},
		"backgroundImage": {
			"type": "object"
		},
		"backgroundImageTablet": {
			"type": "object"
		},
		"backgroundImageMobile": {
			"type": "object"
		},
		"backgroundSize": {
			"type": "string",
			"default": "cover",
			"enum": [
				"cover",
				"contain",
				"auto"
			]
		},
		"backgroundPosition": {
			"type": "string",
			"default": "center center"
		},
		"backgroundRepeat": {
			"type": "string",
			"default": "no-repeat",
			"enum": [
				"no-repeat",
				"repeat",
				"repeat-x",
				"repeat-y"
			]
		},
		"backgroundAttachment": {
			"type": "string",
			"default": "scroll",
			"enum": [
				"scroll",
				"fixed"
			]
		},
		"backgroundOverlayColour": {
			"type": "string"
		},
		"backgroundOverlayOpacity": {
			"type": "object",
			"default": {"desktop": 30}
		},
		"overlayGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundOverlayColourHover": {
			"type": "string",
			"default": ""
		},
		"overlayGradientHover": {
			"type": "string",
			"default": ""
		},
		"backgroundOverlayBlendMode": {
			"type": "string",
			"default": "normal",
			"enum": [
				"normal",
				"multiply",
				"screen",
				"overlay",
				"darken",
				"lighten",
				"color-dodge",
				"color-burn",
				"soft-light",
				"hard-light",
				"difference",
				"exclusion"
			]
		},
		"bgVideo": {
			"type": "object"
		},
		"bgVideoTablet": {
			"type": "object"
		},
		"bgVideoMobile": {
			"type": "object"
		},
		"bgParallax": {
			"type": "boolean",
			"default": false
		},
		"bgKenBurns": {
			"type": "boolean",
			"default": false
		},
		"bgAnimationDuration": {
			"type": "number",
			"default": 20
		},
		"shadow": {
			"type": "string"
		},
		"shadowColour": {
			"type": "string"
		},
		"shadowColourHover": {
			"type": "string",
			"default": ""
		},
