{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/form-step",
	"version": "0.1.1",
	"title": "SGS Form Step",
	"category": "sgs-forms",
	"description": "Groups form fields into a step for multi-step forms.",
	"keywords": [
		"step",
		"page",
		"section"
	],
	"textdomain": "sgs-blocks",
	"icon": "editor-ol",
	"parent": [
		"sgs/form"
	],
	"supports": {
		"html": false,
		"spacing": {
			"padding": true,
			"blockGap": true,
			"__experimentalSkipSerialization": true
		},
		"color": {
			"background": false,
			"gradients": false,
			"text": false,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"hideExtensions": [
				"animation"
			],
			"elements": {
				"wrapper": {
					"label": "Wrapper",
					"layer": "CONTENT",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:padding": "native:spacing.padding",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:max-width": "maxWidth",
						"css:width": "contentWidth",
						"css:border-color-gradient": "borderColourGradient",
						"css:background-image": "textColourGradient"
					},
					"_note": "CONTENT-kind composite (WS-4 composite-mirror, render.php:104-117) — width/spacing layer only via SGS_Container_Wrapper('content'). block.json declares no `margin` spacing support (only padding) and no typography support, so those members are honest gaps. Layer CONTENT names the structural role (naming discipline, FR-35-1) — this block has no GRID layer. textColourGradient is the text-colour gradient sibling to textColour, same background-clip:text mechanism as sgs/counter's labelColour/labelColourGradient (D636 gap-closure)."
				}
			},
			"boxFamilies": {
				"borderRadius": [
					"borderRadius"
				]
			}
		}
	},
	"usesContext": [
		"sgs/formId"
	],
	"attributes": {
		"label": {
			"type": "string",
			"default": "Step",
			"role": "content"
		},
		"contentWidth": {
			"type": "object",
			"default": {}
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHoverGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourGradient": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"example": {
		"attributes": {
			"label": "Your Details"
		}
	}
}
