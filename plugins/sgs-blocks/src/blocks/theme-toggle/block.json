{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/theme-toggle",
	"version": "1.0.0",
	"title": "Theme Toggle",
	"category": "sgs-content",
	"description": "A dark-mode toggle — a switch or a light/dark/auto segmented control — wired to the site's automatic dark palette (theme.json settings.custom.dark).",
	"keywords": [
		"dark mode",
		"theme toggle",
		"light dark",
		"colour scheme",
		"switch"
	],
	"textdomain": "sgs-blocks",
	"icon": "admin-appearance",
	"supports": {
		"align": false,
		"anchor": true,
		"html": false,
		"color": {
			"text": false,
			"background": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"boxFamilies": {
				"padding": [ "padding" ]
			},
			"elements": {
				"label": {
					"label": "Label",
					"order": 1,
					"prefix": "label",
					"clusters": [ "text" ],
					"attrMap": {
						"css:color": "textColour"
					},
					"states": {
						"hover": {
							"attrMap": { "css:color": "textColourHover" }
						},
						"current": {
							"attrMap": { "css:color": "textColourPressed" }
						}
					},
					"_note": "'current' = the toggle's own aria-pressed/aria-checked TRUE state (dark mode active) — Spec 41 FR-41-3's third state, reused here for a genuinely state-driven colour rather than a hover-adjacent one."
				},
				"icon": {
					"label": "Icon",
					"order": 2,
					"clusters": [ "fill" ],
					"attrMap": {
						"css:color": "iconColour"
					},
					"states": {
						"hover": {
							"attrMap": { "css:color": "iconColourHover" }
						}
					}
				},
				"button": {
					"label": "Background",
					"order": 3,
					"isWrapper": true,
					"clusters": [ "fill", "layout" ],
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:padding": "padding",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius"
					},
					"states": {
						"hover": {
							"attrMap": { "css:background-color": "backgroundColourHover" }
						}
					}
				}
			}
		}
	},
	"selectors": {
		"root": ".sgs-theme-toggle",
		"typography": ".sgs-theme-toggle__label"
	},
	"attributes": {
		"toggleStyle": {
			"type": "string",
			"enum": [ "switch", "segmented" ],
			"default": "switch"
		},
		"label": {
			"type": "string",
			"default": "Dark mode",
			"role": "content"
		},
		"labelRoll": {
			"type": "string",
			"enum": [ "", "up", "up-scale" ],
			"default": ""
		},
		"iconOnly": {
			"type": "object",
			"default": {}
		},
		"iconLight": {
			"type": "object",
			"default": { "source": "lucide", "name": "sun" }
		},
		"iconDark": {
			"type": "object",
			"default": { "source": "lucide", "name": "moon" }
		},
		"textColour": {
			"type": "string",
			"default": "text"
		},
		"textColourHover": {
			"type": "string",
			"default": ""
		},
		"textColourPressed": {
			"type": "string",
			"default": ""
		},
		"iconColour": {
			"type": "string",
			"default": "text"
		},
		"iconColourHover": {
			"type": "string",
			"default": ""
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourHover": {
			"type": "string",
			"default": ""
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [ "none", "solid", "dashed", "dotted" ],
			"default": "none"
		},
		"borderRadius": {
			"type": "object",
			"default": { "desktop": {} }
		},
		"padding": {
			"type": "object",
			"default": { "desktop": {} }
		},
		"labelFontSize": {
			"type": "object",
			"default": {}
		},
		"labelFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"labelFontWeight": {
			"type": "string",
			"default": ""
		},
		"labelFontStyle": {
			"type": "string",
			"default": ""
		},
		"labelFontFamily": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"example": {
		"attributes": {
			"toggleStyle": "switch",
			"label": "Dark mode"
		}
	}
}
