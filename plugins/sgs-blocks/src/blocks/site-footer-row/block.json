{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/site-footer-row",
	"version": "0.1.0",
	"title": "SGS Footer Row",
	"category": "sgs-layout",
	"icon": "columns",
	"description": "One row of a site footer — either a never-overflow cluster (top strip / bottom bar) or a column grid (up to 6 columns collapsing to 1 below the mobile tier). Lives inside sgs/site-footer.",
	"keywords": [
		"footer row",
		"site footer",
		"columns",
		"cluster"
	],
	"textdomain": "sgs-blocks",
	"parent": [
		"sgs/site-footer"
	],
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"reusable": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "layout",
			"intrinsicColumns": true,
			"_intrinsicColumnsComment": "D456 — the column count becomes a CEILING that degrades with available width, instead of a fixed count that only changes at a viewport breakpoint. Measured live before this change: all three footer rows dropped 3 tracks to 1 between viewport 768px and 767px, while their content needed just 496px of the 767px available. A @media rule cannot read content size, so that collapse could never be organic. Opt-in per block type, read by sgs_block_wants_intrinsic_columns()."
		}
	},
	"attributes": {
		"rowSlot": {
			"type": "string",
			"default": ""
		},
		"layout": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"columnsTablet": {
			"type": "number",
			"default": 3
		},
		"columnsMobile": {
			"type": "number",
			"default": 1
		},
		"gridTemplateColumns": {
			"type": "object"
		},
		"flexWrap": {
			"type": "string",
			"default": "wrap"
		},
		"justifyContent": {
			"type": "string",
			"default": ""
		},
		"verticalAlign": {
			"type": "string",
			"default": "top"
		},
		"gap": {
			"type": "object",
			"default": { "desktop": "48px", "mobile": "32px" }
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"contentWidth": {
			"type": "object",
			"default": { "desktop": "full" }
		},
		"padding": {
			"type": "object",
			"default": {}
		},
		"margin": {
			"type": "object",
			"default": {}
		},
		"rowTransparent": {
			"type": "object",
			"default": {}
		},
		"rowHideOnScroll": {
			"type": "object",
			"default": {}
		},
		"rowShrink": {
			"type": "object",
			"default": {}
		},
		"rowShrinkHideTarget": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
