{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/accordion",
	"version": "0.2.0",
	"title": "SGS Accordion",
	"category": "sgs-interactive",
	"description": "Expandable content sections â€” ideal for FAQs, product details, and policies. Optional FAQ Schema for SEO.",
	"keywords": [
		"accordion",
		"faq",
		"toggle",
		"collapse",
		"expand",
		"details"
	],
	"textdomain": "sgs-blocks",
	"icon": "list-view",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"collection": true,
			"iconPicker": true,
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				],
				"borderRadius": [
					"borderRadiusTablet",
					"borderRadiusMobile"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Wrapper",
					"layer": "OUTER",
					"order": 1,
					"clusters": [ "text", "fill", "layout" ],
					"isWrapper": true,
					"attrMap": {
						"css:color": "native:color.text",
						"css:background-color": "native:color.background",
						"css:font-size": "fontSize",
						"css:font-weight": "fontWeight",
						"css:font-style": "fontStyle",
						"css:line-height": "lineHeight",
						"css:padding": "native:spacing.padding",
						"css:margin": "native:spacing.margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-color-gradient": "borderColourGradient",
						"css:border-radius": "borderRadius",
						"css:max-width": "maxWidth"
					},
					"_note": "Mirrors sgs/container's wrapper/grid split — typography migrated off native WP support onto the shared TypographyControls/sgs_typography_css_rule() mechanism (D971/D972), root prefix '' (fontSize/fontWeight/fontStyle/lineHeight); no letterSpacing/textTransform/textAlign/fontFamily control is offered, and no width/height/box-shadow/aspect-ratio attrs exist, so those remain honest gaps. The 12 ARRANGEMENT members also apply here (layer OUTER) and are resolved by the sibling `inner` element, not this one — same double-check pattern container's wrapper uses."
				},
				"inner": {
					"label": "Inner (grid / flex layout)",
					"layer": "GRID",
					"order": 2,
					"clusters": [ "layout" ],
					"attrMap": {
						"css:gap": "gap",
						"css:grid-template-columns": "gridTemplateColumns",
						"css:grid-template-rows": "gridTemplateRows",
						"css:grid-auto-rows": "gridAutoRows",
						"css:justify-items": "justifyItems",
						"css:justify-content": "justifyContent",
						"css:align-content": "alignContent",
						"css:align-items": "alignItems",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap"
					},
					"_note": "Same composite-mirror grid capability as sgs/container (rendered via the shared SGS_Container_Wrapper, kind='layout'). Maps explicitly because this element declares no `prefix` — the default {prefix}{Suffix} convention cannot resolve a bare camelCase attribute (ROLLOUT REQUIREMENT 1). Members with no attribute on this block (display, order, overflow) remain honest gaps."
				},
				"header": {
					"label": "Item header",
					"order": 3,
					"clusters": [ "text", "fill" ],
					"attrMap": {
						"css:color": "headerColour",
						"css:background-color": "headerBackground"
					},
					"_note": "headerColour/headerBackground style every accordion-item's header row via block context (providesContext) — no independent header font-size/weight/line-height control exists, so the remaining text-cluster members are honest gaps."
				},
				"icon": {
					"label": "Toggle icon",
					"order": 4,
					"clusters": [ "text", "fill" ],
					"attrMap": {
						"css:color": "iconColour",
						"css:stroke": "iconColourGradient"
					},
					"_note": "iconColour paints the open/close chevron. openIcon/closeIcon (icon slug) and iconPosition are content/variant fields, not independent style controls, so only the colour member is mapped — the rest are honest gaps. `css:stroke` (D636/D644 icon/SVG gradient mechanism) explicit-mapped to iconColourGradient, added 2026-08-16 (Builder 4) — non-empty wins over iconColour's flat currentColor paint at render time (helpers-svg-gradient.php)."
				},
				"item": {
					"label": "Accordion item",
					"order": 5,
					"clusters": [],
					"_note": "Each item's title + body content is rendered by the child `sgs/accordion-item` block, which owns its own typography controls — this element documents that ownership, mirroring sgs/quote's quote-body."
				}
			}
		}
	},
	"selectors": {
		"root": ".wp-block-sgs-accordion"
	},
	"attributes": {
		"allowMultiple": {
			"type": "boolean",
			"default": false
		},
		"defaultOpen": {
			"type": "number",
			"default": -1
		},
		"iconPosition": {
			"type": "string",
			"default": "right"
		},
		"accordionStyle": {
			"type": "string",
			"default": "bordered",
			"description": "Visual preset (bordered | flush | card). Renamed from `style` 2026-08-30 — a block attribute named `style` shadows WP's reserved style object, silently disabling this block's colour, spacing, typography and border supports."
		},
		"faqSchema": {
			"type": "boolean",
			"default": false
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the accordion's border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {}
		},
		"borderRadiusTablet": {
			"type": "object",
			"default": {}
		},
		"borderRadiusMobile": {
			"type": "object",
			"default": {}
		},
		"fontSize": {
			"type": "object",
			"default": {}
		},
		"fontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"fontStyle": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "object",
			"default": {}
		},
		"lineHeightUnit": {
			"type": "string",
			"default": "em"
		},
		"headerColour": {
			"type": "string"
		},
		"headerBackground": {
			"type": "string"
		},
		"iconColour": {
			"type": "string"
		},
		"iconColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the toggle chevron's stroke instead of a flat colour. Non-empty wins over iconColour at render time (D636/D644)."
		},
		"openIcon": {
			"type": "string",
			"default": "chevron-down"
		},
		"closeIcon": {
			"type": "string",
			"default": "chevron-up"
		},
		"contentWidth": {
			"type": "object",
			"default": {}
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"layout": {
			"type": "string",
			"enum": ["", "flex", "stack", "grid"],
			"default": ""
		},
		"gridTemplateColumns": {
			"type": "object",
			"default": {}
		},
		"gridTemplateRows": {
			"type": "object",
			"default": {}
		},
		"gridAutoRows": {
			"type": "string",
			"default": ""
		},
		"gap": {
			"type": "object",
			"default": {}
		},
		"justifyContent": {
			"type": "string",
			"default": ""
		},
		"justifyItems": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end"
			]
		},
		"alignContent": {
			"type": "string",
			"default": "stretch",
			"enum": [
				"stretch",
				"start",
				"center",
				"end",
				"space-between",
				"space-around",
				"space-evenly"
			]
		},
		"alignItems": {
			"type": "string",
			"default": ""
		},
		"columns": {
			"type": "object",
			"default": {"desktop": 2, "tablet": 2, "mobile": 1}
		},
		"flexDirection": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"row",
				"column"
			]
		},
		"flexWrap": {
			"type": "string",
			"default": "wrap",
			"enum": [
				"wrap",
				"nowrap"
			]
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		}
	},
	"providesContext": {
		"sgs/accordionStyle": "accordionStyle",
		"sgs/accordionIconPosition": "iconPosition",
		"sgs/accordionHeaderColour": "headerColour",
		"sgs/accordionHeaderBackground": "headerBackground",
		"sgs/accordionIconColour": "iconColour",
		"sgs/accordionIconColourGradient": "iconColourGradient",
		"sgs/accordionOpenIcon": "openIcon",
		"sgs/accordionCloseIcon": "closeIcon",
		"sgs/accordionDefaultOpen": "defaultOpen"
	},
	"allowedBlocks": [
		"sgs/accordion-item"
	],
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"accordionStyle": "bordered",
			"allowMultiple": false,
			"iconPosition": "right"
		},
		"innerBlocks": [
			{
				"name": "sgs/accordion-item",
				"attributes": {
					"title": "What services do you offer?"
				}
			},
			{
				"name": "sgs/accordion-item",
				"attributes": {
					"title": "How do I get started?"
				}
			}
		]
	}
}
