{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/physics-canvas",
	"version": "0.1.0",
	"title": "SGS Physics Canvas",
	"category": "sgs-layout",
	"description": "A container-equivalent section whose DECORATIVE children become throwable, physics-driven bodies (Spec 38 FR-38-27 / D447). Only non-interactive, non-textual content may be placed inside — nothing operable or must-read, because a thrown object has no discrete single-pointer alternative for WCAG 2.5.7. Physics are disabled under prefers-reduced-motion; children still render, static, in their authored positions.",
	"keywords": [
		"physics",
		"drag",
		"throw",
		"decorative",
		"gsap",
		"canvas"
	],
	"textdomain": "sgs-blocks",
	"icon": "screenoptions",
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"html": false,
		"color": {
			"background": false,
			"text": false,
			"gradients": true,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "section",
			"enabledExtensions": [
				"background"
			],
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				],
				"contentBandPadding": [
					"contentBandPadding"
				]
			},
			"elements": {
				"wrapper": {
					"label": "Wrapper",
					"layer": "OUTER",
					"order": 1,
					"clusters": [ "fill", "layout" ],
					"isWrapper": true,
					"attrMap": {
						"css:background-color": "backgroundColour",
						"css:padding": "native:spacing.padding",
						"css:margin": "native:spacing.margin",
						"css:border-width": "native:__experimentalBorder.width",
						"css:border-style": "native:__experimentalBorder.style",
						"css:border-color": "native:__experimentalBorder.color",
						"css:border-radius": "native:__experimentalBorder.radius",
						"css:max-width": "maxWidth",
						"css:min-height": "minHeight"
					},
					"_note": "Composite-mirror rule (project CLAUDE.md D152): this block MUST mirror sgs/container's wrapper capabilities (padding, max-width, contentWidth, gap, background) rather than diverging — it is a section-KIND composite so it KEEPS SGS_Container_Wrapper rather than going block-private (D294). Background migrated off native color.background onto the flat `backgroundColour` attr (D635-pattern). `supports.color.text` was turned OFF WITHOUT a replacement flat attr — every allowed child (core/image, sgs/media, sgs/icon, sgs/decorative-image) is decorative/non-textual and sgs/icon always sets its own explicit `iconColour`, so inherited `color` never painted anything visible here; adding a `textColour` attr would be a control with no visible effect."
				},
				"content-band": {
					"label": "Content band (throw arena)",
					"layer": "CONTENT",
					"order": 2,
					"clusters": [ "fill", "layout" ],
					"prefix": "contentBand",
					"attrMap": {
						"css:width": "contentWidth"
					},
					"_note": "The __inner band IS the physics arena — its rendered box is what view.js reads as Draggable's bounds and the Physics2D floor/wall geometry."
				}
			}
		}
	},
	"selectors": {
		"root": ".wp-block-sgs-physics-canvas"
	},
	"attributes": {
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"minHeight": {
			"type": "object",
			"default": {"desktop": "480px", "mobile": "320px"}
		},
		"contentWidth": {
			"type": "object",
			"default": {"desktop": "full"}
		},
		"contentBandPadding": { "type": "object", "default": { "desktop": {} } },
		"paddingTablet": { "type": "object", "default": {} },
		"paddingMobile": { "type": "object", "default": {} },
		"marginTablet": { "type": "object", "default": {} },
		"marginMobile": { "type": "object", "default": {} },
		"shadow": { "type": "string" },
		"backgroundAttachment": {
			"type": "string",
			"default": "scroll",
			"enum": [
				"scroll",
				"fixed"
			]
		},
		"backgroundImage": {
			"type": "object"
		},
		"backgroundImageMobile": {
			"type": "object"
		},
		"backgroundImageTablet": {
			"type": "object"
		},
		"backgroundOverlayColour": {
			"type": "string"
		},
		"backgroundPosition": {
			"type": "string",
			"default": "center center"
		},
		"backgroundRepeat": {
			"type": "string",
			"default": "no-repeat",
			"enum": [
				"no-repeat",
				"repeat",
				"repeat-x",
				"repeat-y"
			]
		},
		"backgroundSize": {
			"type": "string",
			"default": "cover",
			"enum": [
				"cover",
				"contain",
				"auto"
			]
		},
		"bgAnimationDuration": {
			"type": "number",
			"default": 20
		},
		"bgKenBurns": {
			"type": "boolean",
			"default": false
		},
		"bgParallax": {
			"type": "boolean",
			"default": false
		},
		"bgSvgAnimation": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"pulse",
				"float",
				"wave"
			]
		},
		"bgSvgAnimationSpeed": {
			"type": "string",
			"default": "medium",
			"enum": [
				"slow",
				"medium",
				"fast"
			]
		},
		"bgSvgContent": {
			"type": "string",
			"default": ""
		},
		"bgSvgMinHeight": {
			"type": "string",
			"default": ""
		},
		"bgSvgOpacity": {
			"type": "number",
			"default": 100
		},
		"bgSvgPosition": {
			"type": "string",
			"default": "background",
			"enum": [
				"background",
				"foreground"
			]
		},
		"bgSvgTextShadow": {
			"type": "boolean",
			"default": false
		},
		"bgVideo": {
			"type": "object"
		},
		"bgVideoTablet": {
			"type": "object"
		},
		"bgVideoMobile": {
			"type": "object"
		},
		"overlayGradient": {
			"type": "string",
			"default": ""
		},
		"physicsGravity": {
			"type": "number",
			"default": 1400,
			"description": "Downward acceleration applied to a thrown body, px/s²."
		},
		"physicsBounce": {
			"type": "number",
			"default": 0.55,
			"description": "Restitution (0-1) applied when a body hits an arena edge."
		},
		"physicsEdgeResistance": {
			"type": "number",
			"default": 0.5,
			"description": "GSAP Draggable edgeResistance (0-1) — higher resists dragging a body past the arena bounds."
		},
		"tagName": {
			"type": "string",
			"enum": [
				"div",
				"section",
				"article",
				"aside",
				"nav",
				"header",
				"footer",
				"figure"
			],
			"default": "section"
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"example": {
		"attributes": {
			"minHeight": "360px"
		}
	}
}
