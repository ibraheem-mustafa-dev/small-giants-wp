{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/site-header",
	"version": "0.1.0",
	"title": "SGS Site Header",
	"category": "sgs-layout",
	"icon": "menu",
	"description": "The site header shell — three optional rows (top / middle / bottom) of header elements. Each row is an intrinsic never-overflow cluster, so the header never overflows the viewport at any width. Lives inside the header template part.",
	"keywords": [
		"site header",
		"header",
		"masthead",
		"navigation"
	],
	"textdomain": "sgs-blocks",
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"reusable": false,
		"align": [
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"__experimentalSkipSerialization": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"containerKind": "section",
			"hideExtensions": [
				"fx"
			],
			"boxFamilies": {
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				]
			}
		}
	},
	"allowedBlocks": [
		"sgs/site-header-row"
	],
	"attributes": {
		"maxWidth": {
			"type": "string",
			"default": ""
		},
		"maxWidthTablet": {
			"type": "string",
			"default": ""
		},
		"maxWidthMobile": {
			"type": "string",
			"default": ""
		},
		"contentWidth": {
			"type": "string",
			"default": "full"
		},
		"contentWidthTablet": {
			"type": "string",
			"default": ""
		},
		"contentWidthMobile": {
			"type": "string",
			"default": ""
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		},
		"headerSticky": {
			"type": "object",
			"default": {}
		},
		"headerTransparent": {
			"type": "object",
			"default": {}
		},
		"headerShrink": {
			"type": "object",
			"default": {}
		},
		"headerHideOnScroll": {
			"type": "object",
			"default": {}
		},
		"contrastSafe": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"scrim",
				"shadow",
				"force-solid"
			]
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
