{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/site-header",
	"version": "0.1.0",
	"title": "SGS Site Header",
	"category": "sgs-layout",
	"icon": "menu",
	"description": "The site header shell — three optional rows (top / middle / bottom) of header elements. Each row is an intrinsic never-overflow cluster, so the header never overflows the viewport at any width. Lives inside the header template part.",
	"keywords": [
		"site header",
		"header",
		"masthead",
		"navigation"
	],
	"textdomain": "sgs-blocks",
	"supports": {
		"anchor": true,
		"customClassName": true,
		"html": false,
		"reusable": false,
		"align": [
			"full"
		],
		"color": {
			"background": false,
			"text": false,
			"gradients": false,
			"__experimentalSkipSerialization": true
		},
		"sgs": {
			"_comment_overlayNotAdopted": "backgroundOverlayColour/Opacity/OpacityTablet/OpacityMobile/ColourHover/BlendMode are the shared whole-block BACKGROUND PANEL (rendered by class-sgs-container-wrapper.php's sgs_overlay_decls()), not media elements -- same settled reasoning as sgs/container (see its block.json for the full note, 2026-09-03, Bean-directed). Detector rule 37-media-no-handroll's bare `background`/`bg`-prefix discriminator excludes this whole family from supports.sgs.mediaElements by design.",
			"containerKind": "section",
			"enabledExtensions": [
				"width",
				"background"
			],
			"hideExtensions": [
				"fx"
			],
			"boxFamilies": {
				"contentBandPadding": [
					"contentBandPadding"
				],
				"padding": [
					"paddingTablet",
					"paddingMobile"
				],
				"margin": [
					"marginTablet",
					"marginMobile"
				],
				"borderRadius": [
					"borderRadiusTablet",
					"borderRadiusMobile"
				]
			},
			"colourExemptions": {
				"text": {
					"rule": "gradient",
					"reason": "A text gradient needs background-clip:text, which hijacks the element's own background box. On the header WRAPPER that would destroy the header background this same block paints. The mechanism is only valid on a leaf text element; this row colours the whole bar."
				}
			},
			"elements": {
				"wrapper": {
					"label": "Section wrapper",
					"layer": "OUTER",
					"order": 1,
					"clusters": [
						"text",
						"fill",
						"layout",
						"animation"
					],
					"isWrapper": true,
					"attrMap": {
						"css:color": "textColour",
						"css:background-color": "backgroundColour",
						"css:background-color-gradient": "backgroundColourGradient",
						"css:padding": "padding",
						"css:margin": "margin",
						"css:border-width": "borderWidth",
						"css:border-style": "borderStyle",
						"css:border-color": "borderColour",
						"css:border-radius": "borderRadius",
						"css:max-width": "maxWidth",
						"css:min-height": "minHeight",
						"css:box-shadow": "shadow",
						"css:box-shadow-color": "shadowColour",
						"css:background-attachment": "backgroundAttachment",
						"css:background-position": "backgroundPosition",
						"css:background-repeat": "backgroundRepeat",
						"css:background-size": "backgroundSize",
						"anim:parallax": "bgParallax",
						"anim:duration": "bgAnimationDuration",
						"css:border-color-gradient": "borderColourGradient"
					},
					"states": {
						"scrolled": {
							"attrMap": {
								"css:color": "textColourScrolled",
								"css:background-color": "backgroundColourScrolled",
								"css:background-color-gradient": "backgroundColourScrolledGradient"
							}
						}
					},
					"_note": "The rendered <header>/<div> element (containerKind=section, rendered through SGS_Container_Wrapper per the composite-mirror rule R-31-9). Colour/spacing/border ride the native supports, all serialised SCOPED via __experimentalSkipSerialization (Spec 32). The typography members are honest GAPs: this block declares no `supports.typography` and no font-* attributes. anim:preset/easing/stagger/trigger are honest GAPs too (no sgsAnimation*/stagger attributes); bgKenBurns is a Ken-Burns preset toggle with no animation-cluster member, so it stays unmapped exactly as on sgs/container."
				},
				"inner": {
					"label": "Inner (grid / flex layout)",
					"layer": "GRID",
					"order": 2,
					"clusters": [
						"layout"
					],
					"attrMap": {
						"css:grid-template-columns": "columns",
						"css:justify-content": "justifyContent",
						"css:align-content": "alignContent",
						"css:align-items": "alignItems",
						"css:flex-direction": "flexDirection",
						"css:flex-wrap": "flexWrap"
					},
					"_note": "Arrangement members map explicitly because this element declares no `prefix`. css:grid-template-columns maps to the `columns` COUNT attribute (SGS_Container_Wrapper expands it to repeat(N,1fr)) — this block has no explicit gridTemplateColumns ratio attribute, unlike sgs/container. css:align-items maps to `alignItems` (class-sgs-container-wrapper.php:247 reads alignItems||alignItems). display / justify-items / order / overflow / grid-template-rows / grid-auto-rows have no attribute on this block and remain honest GAPs."
				},
				"content-band": {
					"label": "Content band",
					"layer": "CONTENT",
					"order": 3,
					"clusters": [
						"fill",
						"layout"
					],
					"prefix": "contentBand",
					"attrMap": {
						"css:width": "contentWidth"
					}
				},
				"decorative": {
					"label": "Decorative background",
					"order": 4,
					"clusters": [],
					"_note": "Background image/video (backgroundImage*/bgVideo*), background SVG (bgSvg*), overlay gradient (overlayGradient*/backgroundOverlay*), Ken Burns, and shape dividers (shapeDivider*) are governed by dedicated controls outside the Text/Fill/Layout style clusters, so this element declares none. Mirrors sgs/container's `decorative` element."
				}
			}
		}
	},
	"allowedBlocks": [
		"sgs/site-header-row"
	],
	"attributes": {
		"padding": {
			"type": "object",
			"default": {}
		},
		"margin": {
			"type": "object",
			"default": {}
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"contentWidth": {
			"type": "object",
			"default": {
				"desktop": "full"
			}
		},
		"paddingTablet": {
			"type": "object",
			"default": {}
		},
		"paddingMobile": {
			"type": "object",
			"default": {}
		},
		"marginTablet": {
			"type": "object",
			"default": {}
		},
		"marginMobile": {
			"type": "object",
			"default": {}
		},
		"headerSticky": {
			"type": "object",
			"default": {}
		},
		"headerTransparent": {
			"type": "object",
			"default": {}
		},
		"headerShrink": {
			"type": "object",
			"default": {}
		},
		"headerHideOnScroll": {
			"type": "object",
			"default": {}
		},
		"contrastSafe": {
			"type": "object",
			"default": {}
		},
		"backgroundColour": {
			"type": "string",
			"default": ""
		},
		"backgroundColourGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundColourScrolled": {
			"type": "string",
			"default": ""
		},
		"backgroundColourScrolledGradient": {
			"type": "string",
			"default": ""
		},
		"textColour": {
			"type": "string",
			"default": ""
		},
		"textColourScrolled": {
			"type": "string",
			"default": ""
		},
		"headerTransparentDirection": {
			"type": "string",
			"default": "transparent-first",
			"enum": [
				"transparent-first",
				"solid-first"
			]
		},
		"backgroundAttachment": {
			"type": "string",
			"default": "scroll",
			"enum": [
				"scroll",
				"fixed"
			]
		},
		"backgroundImage": {
			"type": "object"
		},
		"backgroundImageMobile": {
			"type": "object"
		},
		"backgroundImageTablet": {
			"type": "object"
		},
		"backgroundOverlayColour": {
			"type": "string"
		},
		"backgroundOverlayOpacity": {
			"type": "object",
			"default": {"desktop": 30}
		},
		"backgroundPosition": {
			"type": "string",
			"default": "center center"
		},
		"backgroundRepeat": {
			"type": "string",
			"default": "no-repeat",
			"enum": [
				"no-repeat",
				"repeat",
				"repeat-x",
				"repeat-y"
			]
		},
		"backgroundSize": {
			"type": "string",
			"default": "cover",
			"enum": [
				"cover",
				"contain",
				"auto"
			]
		},
		"bgAnimationDuration": {
			"type": "number",
			"default": 20
		},
		"bgKenBurns": {
			"type": "boolean",
			"default": false
		},
		"bgParallax": {
			"type": "boolean",
			"default": false
		},
		"bgSvgAnimation": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"pulse",
				"float",
				"wave"
			]
		},
		"bgSvgAnimationSpeed": {
			"type": "string",
			"default": "medium",
			"enum": [
				"slow",
				"medium",
				"fast"
			]
		},
		"bgSvgContent": {
			"type": "string",
			"default": ""
		},
		"bgSvgMinHeight": {
			"type": "string",
			"default": ""
		},
		"bgSvgOpacity": {
			"type": "number",
			"default": 100
		},
		"bgSvgPosition": {
			"type": "string",
			"default": "background",
			"enum": [
				"background",
				"foreground"
			]
		},
		"bgSvgTextShadow": {
			"type": "boolean",
			"default": false
		},
		"bgVideo": {
			"type": "object"
		},
		"bgVideoTablet": {
			"type": "object"
		},
		"bgVideoMobile": {
			"type": "object"
		},
		"contentBandPadding": {
			"type": "object",
			"default": {
				"desktop": {}
			}
		},
		"minHeight": {
			"type": "object",
			"default": {}
		},
		"overlayGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundOverlayColourHover": {
			"type": "string",
			"default": ""
		},
		"overlayGradientHover": {
			"type": "string",
			"default": ""
		},
		"backgroundOverlayBlendMode": {
			"type": "string",
			"default": "normal",
			"enum": [
				"normal",
				"multiply",
				"screen",
				"overlay",
				"darken",
				"lighten",
				"color-dodge",
				"color-burn",
				"soft-light",
				"hard-light",
				"difference",
				"exclusion"
			]
		},
		"shadow": {
			"type": "string"
		},
		"shadowColour": {
			"type": "string"
		},
		"shadowColourHover": {
			"type": "string",
			"default": ""
		},
		"borderWidth": {
			"type": "object",
			"default": {}
		},
		"borderStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"borderColour": {
			"type": "string",
			"default": ""
		},
		"borderColourGradient": {
			"type": "string",
			"default": "",
			"description": "CSS gradient string painting the border with a masked ring instead of a flat colour (D636 border-gradient rollout). Non-empty wins over borderColour."
		},
		"borderRadius": {
			"type": "object",
			"default": {}
		},
		"borderRadiusTablet": {
			"type": "object",
			"default": {}
		},
		"borderRadiusMobile": {
			"type": "object",
			"default": {}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
