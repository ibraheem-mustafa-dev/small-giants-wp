{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sgs/commerce-note",
	"version": "0.1.0",
	"title": "Commerce note",
	"category": "sgs-content",
	"description": "A line of text with an optional link inside the Cart and Checkout blocks: an allergen note, a delivery promise, a Keep shopping link.",
	"keywords": [
		"cart",
		"checkout",
		"note",
		"allergen",
		"link"
	],
	"textdomain": "sgs-blocks",
	"icon": "info-outline",
	"parent": [
		"woocommerce/cart-items-block",
		"woocommerce/cart-totals-block",
		"woocommerce/checkout-fields-block",
		"woocommerce/checkout-totals-block"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"inserter": true,
		"sgs": {
			"specRef": "30",
			"elements": {
				"note": {
					"label": "Note text",
					"order": 1,
					"motion": false,
					"clusters": [
						"text"
					],
					"isWrapper": true,
					"prefix": "commerceNote",
					"attrMap": {
						"css:font-size": "commerceNoteFontSize",
						"css:font-family": "commerceNoteFontFamily",
						"css:font-weight": "commerceNoteFontWeight",
						"css:line-height": "commerceNoteLineHeight",
						"css:letter-spacing": "commerceNoteLetterSpacing",
						"css:text-transform": "commerceNoteTextTransform",
						"css:text-align": "commerceNoteTextAlign",
						"css:font-style": "commerceNoteFontStyle"
					}
				},
				"link": {
					"selector": ".sgs-commerce-note__link",
					"label": "Note link",
					"order": 2,
					"motion": false,
					"clusters": [
						"text",
						"layout"
					],
					"prefix": "commerceNoteLink",
					"attrMap": {
						"css:color": "commerceNoteLinkColour",
						"css:font-weight": "commerceNoteLinkFontWeight",
						"css:text-decoration-link": "commerceNoteLinkUnderline",
						"css:text-decoration-thickness-link": "commerceNoteLinkUnderlineThickness",
						"css:text-decoration-color-link": "commerceNoteLinkUnderlineColour",
						"css:text-decoration-offset-link": "commerceNoteLinkUnderlineOffset",
						"css:min-height": "commerceNoteLinkMinHeight"
					},
					"states": {
						"hover": {
							"attrMap": {
								"css:color": "commerceNoteLinkColourHover",
								"css:text-decoration-color-link": "commerceNoteLinkUnderlineColourHover"
							}
						}
					}
				}
			}
		}
	},
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"linkLabel": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"enum": [
				"_self",
				"_blank"
			],
			"default": "_self"
		},
		"linkRel": {
			"type": "string",
			"default": ""
		},
		"linkUrlSource": {
			"type": "string",
			"default": ""
		},
		"commerceNoteFontSize": {
			"type": "object",
			"default": {}
		},
		"commerceNoteFontSizeUnit": {
			"type": "string",
			"default": "px"
		},
		"commerceNoteFontFamily": {
			"type": "string",
			"default": ""
		},
		"commerceNoteFontWeight": {
			"type": "string",
			"default": ""
		},
		"commerceNoteLineHeight": {
			"type": "object",
			"default": {}
		},
		"commerceNoteLineHeightUnit": {
			"type": "string",
			"default": ""
		},
		"commerceNoteLetterSpacing": {
			"type": "object",
			"default": {}
		},
		"commerceNoteLetterSpacingUnit": {
			"type": "string",
			"default": "em"
		},
		"commerceNoteTextTransform": {
			"type": "string",
			"default": ""
		},
		"commerceNoteTextAlign": {
			"type": "object",
			"default": {}
		},
		"commerceNoteLinkColour": {
			"type": "string",
			"default": ""
		},
		"commerceNoteLinkColourHover": {
			"type": "string",
			"default": ""
		},
		"commerceNoteFontStyle": {
			"type": "string",
			"enum": [
				"",
				"normal",
				"italic"
			],
			"default": ""
		},
		"commerceNoteLinkFontWeight": {
			"type": "string",
			"default": ""
		},
		"commerceNoteLinkUnderline": {
			"type": "string",
			"enum": [
				"",
				"none",
				"always",
				"hover",
				"sweep"
			],
			"default": "",
			"description": "How the link is underlined: '' unchanged (the theme's link style), none, always, hover (an underline on hover and keyboard focus) or sweep. sgs_link_underline_css()."
		},
		"commerceNoteLinkUnderlineThickness": {
			"type": "string",
			"default": "",
			"description": "Thickness of the link underline (a CSS length)."
		},
		"commerceNoteLinkUnderlineColour": {
			"type": "string",
			"default": "",
			"description": "The link underline's colour: a palette slug or any CSS colour; empty draws it in the link's own colour."
		},
		"commerceNoteLinkUnderlineColourHover": {
			"type": "string",
			"default": "",
			"description": "The underline colour on hover and keyboard focus."
		},
		"commerceNoteLinkUnderlineOffset": {
			"type": "string",
			"default": "",
			"description": "Gap between the link text and its underline (a CSS length)."
		},
		"commerceNoteLinkMinHeight": {
			"type": "object",
			"default": {},
			"description": "Minimum height of the link's tap area per device: {desktop,tablet,mobile}, each a CSS length or a bare number of px. Unset keeps the stylesheet's 44px."
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
