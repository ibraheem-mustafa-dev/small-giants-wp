{
	"_doc": "Spec 49 C0 fixture for C3 (emitter selectors), §7.3 (when the helper prints), §7.4 (what paints where) and AC-16 (editor and front end equal). 'paint' maps each setting to the selector role its declarations land on, in three states. Roles: 'layout' is the outermost printed element (figure, else a, else the surface); 'surface' is the helper when printed, else the media element; 'media' is the media element; 'overlay' is the helper's ::after, or the mask layer's ::after with a mask; 'mask' is .sgs-media-box__mask. Selectors per C3: layout .{uid}; surface .{uid} or the helper; media .{uid} .sgs-media-el with a helper or a wrapper, else .{uid}. 'slots' is AC-16's 12-slot matrix: each slot is built in the editor and on the front end and compared within 1px at 375, 768 and 1440.",
	"paint": {
		"Width": { "bare": "layout", "helper": "layout", "mask": "layout" },
		"MinWidth": { "bare": "layout", "helper": "layout", "mask": "layout" },
		"MaxWidth": { "bare": "layout", "helper": "layout", "mask": "layout" },
		"Alignment": { "bare": "layout", "helper": "layout", "mask": "layout" },
		"Order": { "bare": "layout", "helper": "layout", "mask": "layout" },
		"Height": { "bare": "media", "helper": "surface", "mask": "surface" },
		"Ratio": { "bare": "media", "helper": "surface", "mask": "surface" },
		"MinHeight": { "bare": "media", "helper": "surface", "mask": "surface" },
		"MaxHeight": { "bare": "media", "helper": "surface", "mask": "surface" },
		"Border": { "bare": "media", "helper": "surface", "mask": "omitted" },
		"Radius": { "bare": "media", "helper": "surface", "mask": "omitted" },
		"Shadow": { "bare": "media", "helper": "surface", "mask": "surface as filter:drop-shadow" },
		"Padding": { "bare": "media", "helper": "surface", "mask": "surface" },
		"Background": { "bare": "media", "helper": "surface", "mask": "surface" },
		"Fit": { "bare": "media", "helper": "media", "mask": "media" },
		"Focal": { "bare": "media", "helper": "media", "mask": "media" },
		"Opacity": { "bare": "media", "helper": "media", "mask": "media" },
		"Blend": { "bare": "media", "helper": "media", "mask": "media" },
		"Colour": { "bare": "media", "helper": "media", "mask": "media" },
		"Overlay": { "bare": "n/a: an overlay prints the helper", "helper": "overlay", "mask": "overlay" },
		"Shape": { "bare": "media (circle, ellipse, pill as border-radius)", "helper": "surface (circle, ellipse, pill)", "mask": "mask" }
	},
	"helperTriggers": {
