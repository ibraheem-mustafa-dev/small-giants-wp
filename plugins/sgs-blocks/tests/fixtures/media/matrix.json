			{ "effect": "parallax" },
			{ "effect": "ken-burns" },
			{ "entrance": "clip-reveal" },
			{ "effect": "sheen" },
			{ "Height": { "mobile": "fill" } }
		],
		"absent": [
			{},
			{ "caption": "A caption" },
			{ "link": "https://example.com" },
			{ "caption": "A caption", "link": "https://example.com" },
			{ "Shape": { "shape": "circle" } },
			{ "hover": { "scale": 1 } }
		],
		"note": "Once printed at any device, the helper prints at every device (§7.3)."
