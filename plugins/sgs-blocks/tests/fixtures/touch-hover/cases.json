{
	"_comment": "The hover-on-touch contract (Spec 38A FR-38A-17), one case per kind of rule. Both implementations must turn `in` into `out` (whitespace after commas and around newlines ignored): scripts/hover-guard/transform.js::transformCss (tests/js/touch-hover-transform.test.js) and includes/helpers-hover-state.php::sgs_touch_hover_css (tests/php/TouchHoverContractTest.php). Running either on `out` changes nothing. `unreadable` lists input neither can rewrite: the PHP twin prints it as it came (and names the reason in the error log under WP_DEBUG), the JS audit reports each finding `kind` and fails the postbuild.",
	"cases": [
		{
			"name": "a block motion rule already guarded gains its pressed half",
			"in": ":where(:root:not(.sgs-touch-input)) .sgs-card:hover{transform:translateY(-4px)}",
			"out": ".sgs-card.sgs-pressed,:where(:root:not(.sgs-touch-input)) .sgs-card:hover{transform:translateY(-4px)}"
		},
		{
			"name": "a block colour rule is guarded and gains its pressed half; its focus member stays put",
			"in": ".sgs-modal__trigger--primary:hover,.sgs-modal__trigger--primary:focus-visible{background:var(--x)}",
			"out": ".sgs-modal__trigger--primary.sgs-pressed,:where(:root:not(.sgs-touch-input)) .sgs-modal__trigger--primary:hover,.sgs-modal__trigger--primary:focus-visible{background:var(--x)}"
		},
		{
			"name": "a theme link rule",
			"in": ".sgs-link-list__items a:hover{color:var(--sgs-hover-accent)}",
			"out": ".sgs-link-list__items a.sgs-pressed,:where(:root:not(.sgs-touch-input)) .sgs-link-list__items a:hover{color:var(--sgs-hover-accent)}"
		},
		{
			"name": "a generated per-instance rule inside a width query",
			"in": "@media (max-width:767.98px){.sgs-btn-ab12.sgs-button:hover{background-color:#112233}}",
			"out": "@media (max-width:767.98px){.sgs-btn-ab12.sgs-button.sgs-pressed,:where(:root:not(.sgs-touch-input)) .sgs-btn-ab12.sgs-button:hover{background-color:#112233}}"
		},
		{
			"name": "an ::after underline sweep",
			"in": ".wp-block-navigation-item__content:hover::after{transform:scaleX(1)}",
			"out": ".wp-block-navigation-item__content.sgs-pressed::after,:where(:root:not(.sgs-touch-input)) .wp-block-navigation-item__content:hover::after{transform:scaleX(1)}"
		},
		{
			"name": "a motion Hover layer switch",
			"in": "[data-sgs-mh=\"self\"]:hover{--sgs-mh-on:1}[data-sgs-hover-group]:hover{--sgs-mh-group-on:1}",
			"out": "[data-sgs-mh=\"self\"].sgs-pressed,:where(:root:not(.sgs-touch-input)) [data-sgs-mh=\"self\"]:hover{--sgs-mh-on:1}[data-sgs-hover-group].sgs-pressed,:where(:root:not(.sgs-touch-input)) [data-sgs-hover-group]:hover{--sgs-mh-group-on:1}"
		},
		{
			"name": "a card hover reaching a child, and a :has() hover",
			"in": ".card:hover .title{color:red}.list:has(.item:hover) .item{opacity:.6}",
			"out": ".card.sgs-pressed .title,:where(:root:not(.sgs-touch-input)) .card:hover .title{color:red}.list:has(.item.sgs-pressed) .item,:where(:root:not(.sgs-touch-input)) .list:has(.item:hover) .item{opacity:.6}"
		},
		{
			"name": "a not-hovered rule keeps its touch half to touch input",
			"in": ".h a:not(:hover):not(:focus-visible){color:#fff}",
			"out": ":where(:root.sgs-touch-input) .h a:not(.sgs-pressed):not(:focus-visible),:where(:root:not(.sgs-touch-input)) .h a:not(:hover):not(:focus-visible){color:#fff}"
		},
		{
			"name": "hover and focus in one compound keep the focus alternative in the touch half",
			"in": ":is(a,button).sgs-hover-underline-slide:is(:hover,:focus-visible){background-size:100% 1px}",
			"out": ":is(a,button).sgs-hover-underline-slide:is(.sgs-pressed,:focus-visible),:where(:root:not(.sgs-touch-input)) :is(a,button).sgs-hover-underline-slide:is(:hover,:focus-visible){background-size:100% 1px}"
		},
		{
			"name": "a press look gains its pressed twin; a not-pressed rule does not",
			"in": ".wp-block-button__link:active{transform:scale(.97)}.q:not(:active){opacity:1}",
			"out": ".wp-block-button__link:active,.wp-block-button__link.sgs-pressed{transform:scale(.97)}.q:not(:active){opacity:1}"
		},
		{
			"name": "a scrollbar pseudo-element hover stays as written",
			"in": "::-webkit-scrollbar-thumb:hover{background:red}",
			"out": "::-webkit-scrollbar-thumb:hover{background:red}"
		},
		{
			"name": "an author's mouse-only media query gets its pressed half before it",
			"in": "@media (hover:hover){.sgs-info-box.sgs-has-hover:hover{box-shadow:var(--s)}}",
			"out": ".sgs-info-box.sgs-has-hover.sgs-pressed{box-shadow:var(--s)}@media (hover:hover){.sgs-info-box.sgs-has-hover:hover{box-shadow:var(--s)}}"
		},
		{
			"name": "a member that starts at the root (WordPress's global styles) takes the guard on the root itself",
			"in": ":root :where(a:where(:not(.wp-element-button)):hover){color:var(--x)}",
			"out": ":root :where(a:where(:not(.wp-element-button)).sgs-pressed),:root:where(:not(.sgs-touch-input)) :where(a:where(:not(.wp-element-button)):hover){color:var(--x)}"
		},
		{
			"name": "a :hover inside a quoted attribute value is text, not a state",
			"in": "a[title=\":hover\"]:hover{color:red}",
			"out": "a[title=\":hover\"].sgs-pressed,:where(:root:not(.sgs-touch-input)) a[title=\":hover\"]:hover{color:red}"
		},
		{
			"name": "rules without :hover or :active, and keyframes, are untouched",
			"in": ".p{color:green}@keyframes k{from{opacity:0}to{opacity:1}}",
			"out": ".p{color:green}@keyframes k{from{opacity:0}to{opacity:1}}"
		},
		{
			"name": "two mouse-only rules for one selector each get their own pressed half",
			"in": "@media (hover:hover){.a:hover{color:red}}@media (hover:hover){.a:hover{background:blue}}",
			"out": ".a.sgs-pressed{color:red}@media (hover:hover){.a:hover{color:red}}.a.sgs-pressed{background:blue}@media (hover:hover){.a:hover{background:blue}}"
		},
		{
			"name": "a press look and a mouse-only hover rule for one selector keep both halves",
			"in": ".a:active{transform:scale(.98)}@media (hover:hover){.a:hover{color:red}}",
			"out": ".a:active,.a.sgs-pressed{transform:scale(.98)}.a.sgs-pressed{color:red}@media (hover:hover){.a:hover{color:red}}"
		},
		{
			"name": "a base hover rule and a mouse-only hover rule for one selector keep both halves",
			"in": ".btn:hover{color:red}@media (hover:hover){.btn:hover{transform:translateY(-2px)}}",
			"out": ".btn.sgs-pressed,:where(:root:not(.sgs-touch-input)) .btn:hover{color:red}.btn.sgs-pressed{transform:translateY(-2px)}@media (hover:hover){.btn:hover{transform:translateY(-2px)}}"
		},
		{
			"name": "a pressed half already in the sheet as the identical rule is not added again",
			"in": ".a.sgs-pressed{color:red}@media (hover:hover){.a:hover{color:red}}",
			"out": ".a.sgs-pressed{color:red}@media (hover:hover){.a:hover{color:red}}"
		},
		{
			"name": "a mouse-only query that adds a width keeps the width around the pressed half",
			"in": "@media (hover:hover) and (min-width:1024px){.a:hover{color:red}}",
			"out": "@media (min-width:1024px){.a.sgs-pressed{color:red}}@media (hover:hover) and (min-width:1024px){.a:hover{color:red}}"
		},
		{
			"name": "a mouse-only query that adds a motion preference keeps it around the pressed half",
			"in": "@media (hover:hover) and (prefers-reduced-motion:no-preference){.a:hover{x:y}}",
			"out": "@media (prefers-reduced-motion:no-preference){.a.sgs-pressed{x:y}}@media (hover:hover) and (prefers-reduced-motion:no-preference){.a:hover{x:y}}"
		},
		{
			"name": "a mouse-only query written after the width keeps the width",
			"in": "@media (min-width:1024px) and (hover:hover){.a:hover{color:red}}",
			"out": "@media (min-width:1024px){.a.sgs-pressed{color:red}}@media (min-width:1024px) and (hover:hover){.a:hover{color:red}}"
		},
		{
			"name": "a mouse-only query inside another at-rule keeps both around the pressed half",
			"in": "@supports (display:grid){@media (hover:hover) and (min-width:600px){.a:hover{color:red}}}",
			"out": "@supports (display:grid){@media (min-width:600px){.a.sgs-pressed{color:red}}@media (hover:hover) and (min-width:600px){.a:hover{color:red}}}"
		},
		{
			"name": "a query that is not mouse-only (not, or) is an ordinary query",
			"in": "@media not all and (hover:hover){.a:hover{x:y}}",
			"out": "@media not all and (hover:hover){.a.sgs-pressed,:where(:root:not(.sgs-touch-input)) .a:hover{x:y}}"
		},
		{
			"name": "a guarded press look gets an unguarded pressed twin",
			"in": ":where(:root:not(.sgs-touch-input)) .a:active{transform:scale(.97)}",
			"out": ":where(:root:not(.sgs-touch-input)) .a:active,.a.sgs-pressed{transform:scale(.97)}"
		},
		{
			"name": "a press look inside a mouse-only query gets no twin",
			"in": "@media (hover:hover){.a:active{x:y}}",
			"out": "@media (hover:hover){.a:active{x:y}}"
		},
		{
			"name": "a member that asks for a press and for no press gets no pressed half",
			"in": ".a:active:not(:hover){x:y}",
			"out": ":where(:root:not(.sgs-touch-input)) .a:active:not(:hover){x:y}"
		},
		{
			"name": "a hover and a not-hover on one element get no pressed half",
			"in": ".a:not(:hover):hover{x:y}.a:hover:not(:active){x:z}",
			"out": ":where(:root:not(.sgs-touch-input)) .a:not(:hover):hover{x:y}:where(:root:not(.sgs-touch-input)) .a:hover:not(:active){x:z}"
		},
		{
			"name": "a not-hovered sibling and a hovered one are two elements and keep their pressed half",
			"in": ".a:not(:hover)+.b:hover{x:y}",
			"out": ":where(:root.sgs-touch-input) .a:not(.sgs-pressed)+.b.sgs-pressed,:where(:root:not(.sgs-touch-input)) .a:not(:hover)+.b:hover{x:y}"
		},
		{
			"name": "an escaped quote inside an attribute value is no state",
			"in": "a[title=\"a\\\"b:hover\"]:hover{x:y}",
			"out": "a[title=\"a\\\"b:hover\"].sgs-pressed,:where(:root:not(.sgs-touch-input)) a[title=\"a\\\"b:hover\"]:hover{x:y}"
		}
	],
	"unreadable": [
		{
			"name": "a stylesheet whose braces do not balance",
			"in": ".a:hover{color:red}}.b{color:blue}",
			"kind": "unparsable-stylesheet"
		},
		{
			"name": "a stylesheet that ends inside a rule",
			"in": ".a:hover{color:red",
			"kind": "unparsable-stylesheet"
		},
		{
			"name": "CSS nesting with a hover under the rule",
			"in": ".a{color:blue;&:hover{color:red}}",
			"kind": "nested-rule"
		},
		{
			"name": "CSS nesting under a rule that carries a hover",
			"in": ".a:hover{color:red;.b{color:blue}}",
			"kind": "nested-rule"
		},
		{
			"name": "an at-rule nested in a rule that carries a hover",
			"in": ".a:hover{color:red;@media (min-width:600px){color:blue}}",
			"kind": "nested-rule"
		}
	]
}
