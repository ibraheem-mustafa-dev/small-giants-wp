[
	{
		"name": "sgs/container",
		"attributes": {
			"layout": "stack",
			"tagName": "section",
			"className": "m43-loops-grid"
		},
		"innerBlocks": [
			{
				"name": "sgs/heading",
				"attributes": {
					"content": "Post grid: cards arrive row by row",
					"level": "h2"
				}
			},
			{
				"name": "sgs/post-grid",
				"attributes": {
					"className": "m43-grid",
					"postType": "post",
					"postsPerPage": 6,
					"layout": "grid",
					"columns": {
						"desktop": 3,
						"tablet": 2,
						"mobile": 1
					},
					"sgsMotion": {
						"v": 1,
						"elements": {
							"root": {
								"entrance": {
									"base": {
										"preset": "entrance-fade-up",
										"trigger": "scroll",
										"values": {
											"from": {
												"opacity": 0,
												"translateY": "token:entrance.distance"
											},
											"to": {
												"opacity": 1,
												"translateY": 0
											}
										}
									}
								}
							}
						},
						"stagger": {
							"apply": true,
							"offset": 0,
							"step": 80,
							"order": "row-first",
							"perRow": true,
							"closeOrder": "same"
						}
					}
				}
			}
		]
	}
]
