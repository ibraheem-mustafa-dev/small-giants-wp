				"attributes": {
					"heading": "Parent perspective card 1",
					"description": "Follow pointer at 8deg, perspective 1100px on the grid, hover scale 1.04 and a 6px lift.",
					"className": "m41p-parent-card",
					"sgsMotion": {
						"v": 1,
						"elements": {
							"root": {
								"hover": {
									"state": {
										"source": "self",
										"trigger": "hover",
										"values": {
											"scale": 1.04,
											"translateY": -6,
											"duration": 150,
											"perspective": 1100,
											"perspectiveOn": "parent",
											"followPointer": true,
											"maxAngle": 8,
											"axisLock": "none",
											"resetDuration": 600,
											"resetEasing": "token:easing.spring"
										}
									},
									"effects": [
										{
											"id": "glare1",
											"effect": "glare",
											"trigger": "hover",
											"values": {
												"glareColour": "#ffffff",
												"glareOpacity": 0.42,
												"glareSize": 55
											}
										}
									]
								}
							}
						}
					},
					"shadowLiftOnHover": false
				}
