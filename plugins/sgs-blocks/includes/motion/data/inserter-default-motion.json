{
    "sgs/card-grid": {
        "sgsMotion": {
            "v": 1,
            "elements": {
                "item": {
                    "entrance": {
                        "base": {
                            "preset": "entrance-fade-up",
                            "trigger": "scroll",
                            "values": {
                                "from": {
                                    "opacity": 0,
                                    "translateY": "token:entrance.distance"
                                },
                                "to": {
                                    "opacity": 1,
                                    "translateY": 0
                                }
                            }
                        }
                    }
                }
            }
        }
    },
