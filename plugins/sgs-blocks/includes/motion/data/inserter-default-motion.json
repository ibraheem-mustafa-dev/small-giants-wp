{
    "sgs/card-grid": {
        "sgsMotion": {
            "v": 1,
            "elements": {
                "item": {
                    "entrance": {
                        "base": {
                            "preset": "entrance-fade-up",
                            "trigger": "scroll",
                            "values": {
                                "from": {
                                    "opacity": 0,
                                    "translateY": "token:entrance.distance"
                                },
                                "to": {
                                    "opacity": 1,
                                    "translateY": 0
                                }
                            }
                        }
                    }
                },
                "image": {
                    "hover": {
                        "state": {
                            "source": "item",
                            "values": {
                                "scale": 1.05,
                                "duration": 300,
                                "easing": "ease-in-out"
                            }
                        }
                    }
                }
            }
        }
    },
    "sgs/gallery": {
