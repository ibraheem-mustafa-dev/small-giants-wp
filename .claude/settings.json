{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "permissions": {
    "allow": [
      "Read(//c/Users/Bean/Projects/**)",
      "Read(//c/Users/Bean/.claude/**)",
      "Read(//c/Users/Bean/.agents/**)",
      "Read(//c/Users/Bean/AppData/Local/Temp/claude/**)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "C:\\Users\\Bean\\AppData\\Local\\Temp\\claude",
      "C:\\Users\\Bean\\AppData\\Local\\Temp\\claude\\c--Users-Bean-Projects-small-giants-wp\\01ba43c8-9933-4132-8050-0f52ad1ea141\\scratchpad",
      "C:\\Users\\Bean\\AppData\\Local\\Temp\\claude\\scratch"
    ],
    "deny": [
      "Bash(git stash *)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git commit *--no-verify*)",
      "Bash(gh pr create*)",
      "Bash(*--allow-dirty*)",
      "Bash(*--skip-verify*)",
      "Bash(rg *--pre*)",
      "Bash(sed *--in-place*)",
      "Bash(sed -i*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-cap-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-gates.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
