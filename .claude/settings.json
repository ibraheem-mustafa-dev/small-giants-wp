{
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/Bean/Projects/small-giants-wp/.claude/hooks/memory-cap-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/Bean/Projects/small-giants-wp/.claude/hooks/commit-gates.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
