+#!/usr/bin/env node
+/**
+ * select-targets.mjs: which editor targets a check must open when only some blocks changed.
+ *
+ * check-editor-loads.mjs opens every page, post, template and template part of a mirror (46 on local-eye-care, about
+ * 12 s each). When the deploy knows the build changed only inside `build/blocks/<name>/` (deploy_editor_check.py), the
+ * targets that can show a new crash are the ones whose content holds one of those blocks, read through what the editor
+ * draws with them: synced patterns (`wp:block {"ref":N}`) and, for a template, its template parts
+ * (`wp:template-part {"slug":"header"}`). A target whose drawn content changed since the last clean run on this mirror
+ * is opened too, whatever its blocks.
+ *
+ * Self-test: node plugins/sgs-blocks/scripts/editor-crash/select-targets.mjs --self-test
+ *
+ * @package SGS\Blocks
+ */
+import crypto from 'crypto';
+import { fileURLToPath } from 'url';
+
+const BLOCK_COMMENT = /<!--\s+wp:([a-z][a-z0-9-]*(?:\/[a-z][a-z0-9-]*)?)(?=[\s/]|-->)/g;
+const SYNCED_REF = /<!--\s+wp:block\s+(\{[^}]*\})/g;
+const PART_REF = /<!--\s+wp:template-part\s+(\{[^}]*\})/g;
+
+/** Every block name in `content`, core names written `core/<name>`. */
+export function blockNamesIn( content ) {
+	const names = new Set();
+	for ( const match of ( content || '' ).matchAll( BLOCK_COMMENT ) ) {
+		names.add( match[ 1 ].includes( '/' ) ? match[ 1 ] : `core/${ match[ 1 ] }` );
+	}
+	return names;
+}
+
+function refs( content, pattern, key ) {
+	const out = [];
+	for ( const match of ( content || '' ).matchAll( pattern ) ) {
+		try {
+			const value = JSON.parse( match[ 1 ] )[ key ];
+			if ( value !== undefined ) out.push( String( value ) );
+		} catch ( error ) {
+			// An attribute object this reader cannot parse: the raw content still counts.
+		}
+	}
+	return out;
+}
+
+/** The content the editor draws for a target: its own, plus synced patterns and template parts, followed to depth 5. */
+export function drawnContent( content, patterns, parts, depth = 0 ) {
+	if ( depth > 5 ) return content || '';
+	let out = content || '';
+	for ( const id of refs( content, SYNCED_REF, 'ref' ) ) {
+		if ( patterns.has( id ) ) out += '\n' + drawnContent( patterns.get( id ), patterns, parts, depth + 1 );
+	}
+	for ( const slug of refs( content, PART_REF, 'slug' ) ) {
+		if ( parts.has( slug ) ) out += '\n' + drawnContent( parts.get( slug ), patterns, parts, depth + 1 );
+	}
+	return out;
+}
+
+export const sha = ( text ) => crypto.createHash( 'sha256' ).update( text || '' ).digest( 'hex' );
+
+/**
+ * targets: [{ key, drawn }]; changed: a Set of block names, or null for "everything may have changed";
+ * previous: { key: sha } from the last clean run on this mirror, or null. Returns { selected, why }.
+ */
+export function selectTargets( targets, changed, previous ) {
+	if ( changed === null ) return { selected: targets, why: Object.fromEntries( targets.map( ( t ) => [ t.key, 'full run' ] ) ) };
+	const selected = [];
+	const why = {};
+	for ( const target of targets ) {
+		const hits = [ ...blockNamesIn( target.drawn ) ].filter( ( name ) => changed.has( name ) );
+		if ( hits.length ) {
+			why[ target.key ] = `holds ${ hits.slice( 0, 3 ).join( ', ' ) }`;
+		} else if ( ! previous || previous[ target.key ] !== sha( target.drawn ) ) {
+			why[ target.key ] = previous && target.key in previous ? 'content changed since the last clean run' : 'not checked before';
+		} else {
+			continue;
+		}
+		selected.push( target );
+	}
+	return { selected, why };
+}
+
+function selfTest() {
+	const patterns = new Map( [ [ '7', '<!-- wp:sgs/hero {"a":1} /-->' ] ] );
+	const parts = new Map( [ [ 'header', '<!-- wp:sgs/nav-bar --><!-- /wp:sgs/nav-bar -->' ] ] );
+	const raw = {
+		'page:1': '<!-- wp:sgs/card /--><!-- wp:paragraph --><p>x</p><!-- /wp:paragraph -->',
+		'page:2': '<!-- wp:block {"ref":7} /-->',
+		'template:index': '<!-- wp:template-part {"slug":"header","theme":"sgs-theme"} /--><!-- wp:sgs/cardx /-->',
+		'part:header': parts.get( 'header' ),
+		'page:3': '<!-- wp:sgs/quote /-->',
+	};
+	const targets = ( draw ) => Object.entries( raw ).map( ( [ key, content ] ) => ( { key, drawn: draw( content ) } ) );
+	const real = ( c ) => drawnContent( c, patterns, parts );
+	const rawOnly = ( c ) => c; // planted fault: patterns and parts not followed
+	const previous = Object.fromEntries( targets( real ).map( ( t ) => [ t.key, sha( t.drawn ) ] ) );
+	const keys = ( result ) => result.selected.map( ( t ) => t.key ).sort();
+	const cases = [
+		[ 'a changed block selects the targets that draw it, through synced patterns and template parts',
+			( draw ) => keys( selectTargets( targets( draw ), new Set( [ 'sgs/hero', 'sgs/nav-bar' ] ), previous ) ),
+			[ 'page:2', 'part:header', 'template:index' ] ],
+		[ 'a name is matched whole (sgs/card does not select sgs/cardx)',
+			( draw ) => keys( selectTargets( targets( draw ), new Set( [ 'sgs/card' ] ), previous ) ), [ 'page:1' ] ],
+		[ 'nothing changed and nothing edited selects nothing',
+			( draw ) => keys( selectTargets( targets( draw ), new Set(), previous ) ), [] ],
+		[ 'a target whose content changed is opened',
+			( draw ) => keys( selectTargets( targets( draw ), new Set(), { ...previous, 'page:3': 'old' } ) ), [ 'page:3' ] ],
+		[ 'with no record every target is new',
+			( draw ) => keys( selectTargets( targets( draw ), new Set(), null ) ).length, 5 ],
+		[ 'a full run selects every target', ( draw ) => keys( selectTargets( targets( draw ), null, previous ) ).length, 5 ],
+	];
+	let failed = 0;
+	let plantedCaught = false;
+	for ( const [ label, run, want ] of cases ) {
+		const got = JSON.stringify( run( real ) );
+		const ok = got === JSON.stringify( want );
+		if ( JSON.stringify( run( rawOnly ) ) !== JSON.stringify( want ) ) plantedCaught = true;
+		console.log( `${ ok ? 'ok  ' : 'FAIL' } ${ label }${ ok ? '' : `: got ${ got }` }` );
+		if ( ! ok ) failed++;
+	}
+	console.log( `${ plantedCaught ? 'ok  ' : 'FAIL' } NEGATIVE CONTROL: a selector that reads raw content only misses a block drawn through a pattern or part` );
+	if ( ! plantedCaught ) failed++;
+	if ( blockNamesIn( '<!-- wp:paragraph --><!-- wp:sgs/a-b {"x":1} /--><!-- wp:core/image -->' ).size !== 3 ) {
+		console.log( 'FAIL blockNamesIn did not read core and namespaced names' );
+		failed++;
+	}
+	console.log( `select-targets self-test: ${ failed ? 'FAIL' : 'ok' }` );
+	return failed ? 1 : 0;
+}
+
+if ( process.argv[ 1 ] && fileURLToPath( import.meta.url ) === process.argv[ 1 ] && process.argv.includes( '--self-test' ) ) {
+	process.exit( selfTest() );
+}
