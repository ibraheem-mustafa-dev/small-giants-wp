+/**
+ * The attributes of each `named` extension in the roster, grouped by the blocks its rule names. The server registers
+ * a group's attributes on those blocks only (includes/extension-attrs-rest-register.php); every other extension
+ * attribute stays on every block that supports className.
+ */
+function collectNamedScope() {
+	const roster = JSON.parse( fs.readFileSync( ROSTER_FILE, 'utf8' ) );
+	const groups = new Map();
+	for ( const ext of roster.extensions ) {
+		if ( ext.rule.mode !== 'named' ) {
+			continue;
+		}
+		const blocks = [ ...ext.rule.blocks ].sort();
+		const key = blocks.join( ',' );
+		if ( ! groups.has( key ) ) {
+			groups.set( key, { blocks, attributes: [] } );
+		}
+		groups.get( key ).attributes.push( ...Object.keys( ext.attributes ) );
+	}
+	return [ ...groups.values() ]
+		.map( ( g ) => ( { blocks: g.blocks, attributes: [ ...new Set( g.attributes ) ].sort() } ) )
+		.sort( ( a, b ) => a.blocks.join( ',' ).localeCompare( b.blocks.join( ',' ) ) );
+}
