+		" * The attributes of each `named` extension, grouped by the blocks its rule names: they are registered on those blocks only.",
+		' *',
+		' * @package SGS\\Blocks',
+		' */',
+		'',
+		'return array(',
+	];
+	for ( const g of groups ) {
+		lines.push( '\tarray(' );
+		lines.push( `\t\t'blocks'     => array( ${ g.blocks.map( q ).join( ', ' ) } ),` );
+		lines.push( `\t\t'attributes' => array( ${ g.attributes.map( q ).join( ', ' ) } ),` );
+		lines.push( '\t),' );
+	}
+	lines.push( ');', '' );
+	return lines.join( '\n' );
+}
