{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "HelpingDoctors EHR",
  "description": "Bundled preset — colour + typography combined. For independent axes use colours/helping-doctors and typography/helping-doctors.",
  "settings": {
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Whisper",
          "slug": "whisper",
          "shadow": "0px 1px 2px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 10%, transparent), 0px 0px 0px 1px color-mix(in srgb, var(--wp--custom--shadow-colour) 5%, transparent)"
        },
        {
          "name": "Soft",
          "slug": "soft",
          "shadow": "0px 1px 2px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent), 0px 4px 12px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 10%, transparent)"
        },
        {
          "name": "Lifted",
          "slug": "lifted",
          "shadow": "0px 1px 2px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 5%, transparent), 0px 4px 8px -2px color-mix(in srgb, var(--wp--custom--shadow-colour) 8%, transparent), 0px 12px 24px -6px color-mix(in srgb, var(--wp--custom--shadow-colour) 12%, transparent)"
        },
        {
          "name": "Floating",
          "slug": "floating",
          "shadow": "0px 2px 4px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 4%, transparent), 0px 8px 16px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent), 0px 24px 48px -8px color-mix(in srgb, var(--wp--custom--shadow-colour) 12%, transparent), 0px 48px 96px -16px color-mix(in srgb, var(--wp--custom--shadow-colour) 10%, transparent)"
        },
        {
          "name": "Crisp",
          "slug": "crisp",
          "shadow": "0px 1px 1px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 16%, transparent), 0px 2px 4px -1px color-mix(in srgb, var(--wp--custom--shadow-colour) 14%, transparent)"
        },
        {
          "name": "Long",
          "slug": "long",
          "shadow": "0px 2px 1px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 4px 2px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 8px 4px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 16px 8px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 32px 16px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent)"
        },
        {
          "name": "Outline",
          "slug": "outline",
          "shadow": "0px 0px 0px 1px color-mix(in srgb, var(--wp--custom--shadow-colour) 14%, transparent), 0px 2px 8px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent)"
        },
        {
          "name": "Grounded",
          "slug": "grounded",
          "shadow": "0px 20px 20px -14px color-mix(in srgb, var(--wp--custom--shadow-colour) 26%, transparent), 0px 1px 2px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent)"
        },
        {
          "name": "Glow",
          "slug": "glow",
          "shadow": "0px 0px 16px 0px color-mix(in srgb, var(--wp--preset--color--primary) 55%, transparent), 0px 0px 40px 0px color-mix(in srgb, var(--wp--preset--color--primary) 28%, transparent)"
        },
        {
          "name": "Pressed",
          "slug": "pressed",
          "shadow": "inset 0px 2px 4px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 14%, transparent), inset 0px 0px 0px 1px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent)"
        },
        {
          "name": "Hard",
          "slug": "hard",
          "shadow": "4px 4px 0px 0px var(--wp--custom--shadow-colour)"
        },
        {
          "name": "Diffuse",
          "slug": "diffuse",
          "shadow": "0px 18px 44px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent)"
        }
      ]
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#2d6e5e",
          "name": "Primary"
        },
        {
          "slug": "primary-text",
          "name": "Text on Primary",
          "color": "#ffffff"
        },
        {
          "slug": "primary-dark",
          "color": "#1a4139",
          "name": "Primary Dark"
        },
        {
          "slug": "secondary",
          "color": "#3a8c73",
          "name": "Secondary Green"
        },
        {
          "slug": "secondary-dark",
          "color": "#256050",
          "name": "Secondary Green Dark"
        },
        {
          "slug": "accent",
          "color": "#e8a020",
          "name": "Accent"
        },
        {
          "slug": "accent-light",
          "color": "#fef3dc",
          "name": "Accent Light"
        },
        {
          "slug": "success",
          "color": "#2e7d4f",
          "name": "Success"
        },
        {
          "slug": "success-light",
          "name": "Success Light",
          "color": "#ECFDF5"
        },
        {
          "slug": "error",
          "color": "#dc2626",
          "name": "Error"
        },
        {
          "slug": "error-light",
          "name": "Error Light",
          "color": "#FEF2F2"
        },
        {
          "slug": "info",
          "name": "Info",
          "color": "#3B82F6"
        },
        {
          "slug": "info-light",
          "name": "Info Light",
          "color": "#EBF5FF"
        },
        {
          "slug": "whatsapp",
          "color": "#25D366",
          "name": "WhatsApp"
        },
        {
          "slug": "surface",
          "color": "#ffffff",
          "name": "Page Background"
        },
        {
          "slug": "surface-alt",
          "color": "#e8f5f2",
          "name": "Raised Background"
        },
        {
          "slug": "text",
          "color": "#1a1a1a",
          "name": "Text"
        },
        {
          "slug": "text-muted",
          "color": "#555555",
          "name": "Text Muted"
        },
        {
          "slug": "text-inverse",
          "color": "#ffffff",
          "name": "Text on Dark"
        },
        {
          "slug": "border",
          "color": "#d4e8e4",
          "name": "Border"
        },
        {
          "slug": "border-light",
          "color": "#e5e7eb",
          "name": "Border Light"
        },
        {
          "slug": "footer-bg",
          "color": "#1a4139",
          "name": "Footer Background"
        },
        {
          "slug": "accent-text",
          "name": "Text on Accent",
          "color": "#92400E"
        },
        {
          "slug": "heading",
          "name": "Heading Text",
          "color": "#1a4139"
        },
        {
          "slug": "link",
          "name": "Link",
          "color": "#2d6e5e"
        },
        {
          "slug": "link-hover",
          "name": "Link Hover",
          "color": "#1a4139"
        },
        {
          "slug": "section",
          "name": "Section Background",
          "color": "#e8f5f2"
        },
        {
          "slug": "section-text",
          "name": "Section Text",
          "color": "#1a1a1a"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
          "slug": "heading",
          "name": "Heading",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-variable-latin.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
          "slug": "body",
          "name": "Body",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-variable-latin.woff2"
              ]
            }
          ]
        }
      ]
    },
    "custom": {
      "focus": {
        "width": "2px",
        "inner": "var(--wp--preset--color--surface)",
        "ink": "var(--wp--preset--color--text)",
        "ring": "#b88023",
        "near": "var(--wp--preset--color--accent)",
        "far": "var(--wp--preset--color--accent)",
        "ringOnDark": "var(--wp--preset--color--accent)",
        "nearOnDark": "var(--wp--preset--color--accent)",
        "farOnDark": "var(--wp--preset--color--accent)",
        "signatureA": "var(--wp--preset--color--primary)",
        "signatureB": "var(--wp--preset--color--accent)",
        "signatureC": "var(--wp--preset--color--accent-light)"
      },
      "shadowHover": {
        "whisper": "soft",
        "soft": "lifted",
        "lifted": "floating",
        "floating": "0px 3px 5px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 4%, transparent), 0px 10px 20px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent), 0px 30px 60px -8px color-mix(in srgb, var(--wp--custom--shadow-colour) 14%, transparent), 0px 60px 120px -16px color-mix(in srgb, var(--wp--custom--shadow-colour) 12%, transparent)",
        "crisp": "0px 2px 2px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 16%, transparent), 0px 4px 8px -1px color-mix(in srgb, var(--wp--custom--shadow-colour) 14%, transparent)",
        "long": "0px 3px 1.5px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 6px 3px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 12px 6px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 24px 12px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent), 0px 48px 24px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 9%, transparent)",
        "outline": "0px 0px 0px 2px color-mix(in srgb, var(--wp--custom--shadow-colour) 14%, transparent), 0px 4px 12px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent)",
        "grounded": "0px 26px 24px -14px color-mix(in srgb, var(--wp--custom--shadow-colour) 30%, transparent), 0px 1px 2px 0px color-mix(in srgb, var(--wp--custom--shadow-colour) 6%, transparent)",
        "glow": "0px 0px 20px 0px color-mix(in srgb, var(--wp--preset--color--primary) 70%, transparent), 0px 0px 52px 0px color-mix(in srgb, var(--wp--preset--color--primary) 40%, transparent)",
        "hard": "6px 6px 0px 0px var(--wp--custom--shadow-colour)",
        "pressed": "pressed"
      },
      "shadowColour": "var(--wp--preset--color--text)",
      "sgs": {
        "headerPattern": "sgs/framework-header-default",
        "footerPattern": "sgs/framework-footer-default"
      },
      "section": {
        "padding": {
          "mobile": "0",
          "tablet": "0",
          "desktop": "0"
        }
      },
      "gutter": {
        "mobile": "0",
        "tablet": "0",
        "desktop": "0"
      },
      "transition": {
        "fast": "250ms cubic-bezier(0.4, 0, 0.2, 1)",
        "medium": "300ms cubic-bezier(0.4, 0, 0.2, 1)",
        "slow": "450ms cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "duration": {
        "instant": "60ms",
        "fast": "250ms",
        "medium": "300ms",
        "slow": "450ms",
        "extra-slow": "900ms"
      },
      "easing": {
        "default": "cubic-bezier(0.4, 0, 0.2, 1)",
        "ease-out": "cubic-bezier(0.2, 0.7, 0.2, 1)",
        "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
        "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
        "spring-gentle": "linear(0, 0.06, 0.197, 0.365, 0.532, 0.68, 0.801, 0.894, 0.959, 1.001, 1.026, 1.037, 1.04, 1.037, 1.031, 1.025, 1.018, 1.012, 1.007, 1.004, 1.001, 1, 0.999, 0.998, 1)",
        "spring-bouncy": "linear(0, 0.087, 0.283, 0.511, 0.722, 0.889, 1.003, 1.07, 1.097, 1.098, 1.082, 1.06, 1.038, 1.019, 1.005, 0.996, 0.991, 0.99, 0.991, 0.993, 0.995, 0.997, 0.999, 1, 1)",
        "linear": "linear"
      },
      "entrance": {
        "distance": "28px",
        "duration": "750ms",
        "easing": "cubic-bezier(0.2, 0.7, 0.2, 1)"
      },
      "distance": {
        "xs": "2px",
        "sm": "3px",
        "md": "8px",
        "lg": "18px",
        "xl": "32px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|surface",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "600",
          "lineHeight": "1.25"
        },
        "color": {
          "text": "var:preset|color|heading"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|hero"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "textTransform": "uppercase",
          "letterSpacing": "0.06em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|link"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|link-hover"
          }
        },
        ":focus-visible": {
          "color": {
            "text": "var:preset|color|link-hover"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|surface"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|small",
          "textDecoration": "none"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|primary-dark",
            "text": "var:preset|color|surface"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontSize": "var:preset|font-size|large"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500"
        }
      },
      "core/quote": {
        "border": {
          "color": "var:preset|color|primary",
          "width": "3px"
        }
      }
    }
  }
}
