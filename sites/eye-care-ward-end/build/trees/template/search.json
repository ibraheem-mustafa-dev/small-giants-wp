[
  {
    "name": "core/template-part",
    "attributes": {
      "slug": "header",
      "tagName": "header"
    }
  },
  {
    "name": "sgs/container",
    "attributes": {
      "tagName": "main",
      "anchor": "main",
      "contentWidth": {
        "desktop": "full"
      }
    },
    "innerBlocks": [
      {
        "name": "sgs/container",
        "attributes": {
          "tagName": "div",
          "backgroundColour": "surface-alt",
          "contentWidth": {
            "desktop": "normal"
          },
          "padding": {
            "top": "var:preset|spacing|60",
            "bottom": "var:preset|spacing|40"
          },
          "flexWrap": "wrap",
          "layout": "stack"
        },
        "innerBlocks": [
          {
            "name": "core/template-part",
            "attributes": {
              "slug": "sgs-archive-toolbar"
            }
          },
          {
            "name": "core/query-title",
            "attributes": {
              "type": "search"
            }
          },
          {
            "name": "core/search",
            "attributes": {
              "label": "Search",
              "showLabel": false,
              "placeholder": "Search this site…",
              "buttonText": "Search",
              "buttonPosition": "button-inside",
              "buttonUseIcon": true,
              "style": {
                "border": {
                  "radius": "8px"
                }
              },
              "backgroundColor": "surface"
            }
          }
        ]
      },
      {
        "name": "sgs/container",
        "attributes": {
          "tagName": "div",
          "contentWidth": {
            "desktop": "normal"
          },
          "padding": {
            "top": "var:preset|spacing|50",
            "bottom": "var:preset|spacing|60"
          },
          "flexWrap": "wrap"
        },
        "innerBlocks": [
          {
            "name": "core/query",
            "attributes": {
              "queryId": 1,
              "query": {
                "perPage": 10,
                "pages": 0,
                "offset": 0,
                "postType": "post",
                "order": "desc",
                "orderBy": "relevance",
                "inherit": true
              }
            },
            "innerBlocks": [
              {
                "name": "core/query-total",
                "attributes": {
                  "style": {
                    "spacing": {
                      "margin": {
                        "bottom": "var:preset|spacing|30"
                      }
                    }
                  }
                }
              },
              {
                "name": "core/post-template",
                "innerBlocks": [
                  {
                    "name": "sgs/container",
                    "attributes": {
                      "tagName": "div",
                      "padding": {
                        "bottom": "var:preset|spacing|40"
                      },
                      "flexWrap": "wrap",
                      "borderWidth": {
                        "bottom": "1px"
                      },
                      "borderColour": "var:preset|color|surface-alt",
                      "borderStyle": "solid"
                    },
                    "innerBlocks": [
                      {
                        "name": "core/post-title",
                        "attributes": {
                          "level": 2,
                          "isLink": true
                        }
                      },
                      {
                        "name": "core/post-date",
                        "attributes": {
                          "fontSize": "small",
                          "textColor": "text-muted"
                        }
                      },
                      {
                        "name": "core/post-excerpt",
                        "attributes": {
                          "moreText": "Read more",
                          "excerptLength": 30
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "name": "core/query-pagination",
                "attributes": {
                  "layout": {
                    "type": "flex",
                    "justifyContent": "center"
                  },
                  "style": {
                    "spacing": {
                      "margin": {
                        "top": "var:preset|spacing|50"
                      }
                    }
                  }
                },
                "innerBlocks": [
                  {
                    "name": "core/query-pagination-previous"
                  },
                  {
                    "name": "core/query-pagination-numbers"
                  },
                  {
                    "name": "core/query-pagination-next"
                  }
                ]
              },
              {
                "name": "core/query-no-results",
                "innerBlocks": [
                  {
                    "name": "sgs/container",
                    "attributes": {
                      "tagName": "div",
                      "contentWidth": {
                        "desktop": "500px"
                      },
                      "padding": {
                        "top": "var:preset|spacing|70",
                        "bottom": "var:preset|spacing|70"
                      },
                      "flexWrap": "wrap"
                    },
                    "innerBlocks": [
                      {
                        "name": "sgs/heading",
                        "attributes": {
                          "content": "No results found",
                          "textAlign": "center",
                          "level": "h2"
                        }
                      },
                      {
                        "name": "sgs/text",
                        "attributes": {
                          "text": "Sorry, no content matched your search. Please try a different search term.",
                          "textAlign": "center",
                          "textColour": "text-muted"
                        }
                      },
                      {
                        "name": "sgs/text",
                        "attributes": {
                          "text": "Try fewer or different words, or browse from here:",
                          "textAlign": "center",
                          "textColour": "text-muted",
                          "fontSize": {
                            "desktop": "small"
                          },
                          "margin": {
                            "top": "var:preset|spacing|40"
                          }
                        }
                      },
                      {
                        "name": "sgs/multi-button",
                        "attributes": {
                          "justifyContent": {
                            "desktop": "center"
                          },
                          "margin": {
                            "top": "var:preset|spacing|20"
                          }
                        },
                        "innerBlocks": [
                          {
                            "name": "sgs/button",
                            "attributes": {
                              "label": "Home",
                              "url": "/",
                              "inheritStyle": "secondary",
                              "borderRadius": {
                                "desktop": "8px"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "name": "core/template-part",
    "attributes": {
      "slug": "footer",
      "tagName": "footer"
    }
  }
]
