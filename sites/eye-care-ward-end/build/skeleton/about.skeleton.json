						"innerBlocks": []
					},
					{
						"name": "sgs/text",
						"attributes": {
							"text": "Day to day I test eyes, treat eye conditions and dispense glasses. The letters below aren't decoration — they're why I can look at your prescription and tell you what will actually work in a given frame."
						},
						"draftRef": {
							"tpl": "Root/608#0"
						},
						"draftFingerprint": {
							"tag": "p",
							"cls": "",
