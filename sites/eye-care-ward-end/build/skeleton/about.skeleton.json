					{
						"name": "sgs/text",
						"attributes": {
							"text": "Eye Care Birmingham is an independent clinic in Birmingham. This shop is how it sells eyewear beyond the front door: the same frames the chains stock, priced by someone without a chain's overheads, with lenses glazed and fitted on site."
						},
						"draftRef": {
							"tpl": "Root/607#0"
						},
						"draftFingerprint": {
							"tag": "p",
							"cls": "",
