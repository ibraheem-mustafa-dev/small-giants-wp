							"line": 1381
						},
						"innerBlocks": []
					},
					{
						"name": "sgs/text",
						"attributes": {
							"text": "Every prescription order is checked by me before it's made. If a frame won't suit a strong prescription, I'll say so before you pay and suggest something that will."
