                  "textTransform": "uppercase",
                  "letterSpacing": {
                    "desktop": 0.2
                  },
                  "fontSize": {
                    "desktop": 12
                  },
                  "textColour": "text-label"
                }
              },
              {
                "name": "sgs/text",
                "attributes": {
                  "text": "30 days on unworn frames with case and tags, refunded in full. Lenses made to your prescription can't be resold, so they're only refundable if I got them wrong.",
