                  },
                  "fontSize": {
                    "desktop": 12
                  },
                  "textColour": "text-label"
                }
              },
              {
                "name": "sgs/text",
                "attributes": {
                  "text": "Free over £75, otherwise £3.95 tracked. Frames in stock go out within one working day; prescription orders take 7–10 working days to make.",
                  "fontSize": {
