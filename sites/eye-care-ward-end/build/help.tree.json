              },
              "backgroundColour": "surface-alt",
              "padding": {
                "desktop": {
                  "top": "26px",
                  "right": "26px",
                  "bottom": "26px",
                  "left": "26px"
                }
              }
            },
            "innerBlocks": [
              {
                "name": "sgs/text",
                "attributes": {
                  "text": "Collect in Birmingham",
                  "textTransform": "uppercase",
                  "letterSpacing": {
                    "desktop": 0.2
                  },
                  "fontSize": {
                    "desktop": 12
                  },
                  "textColour": "text-label"
                }
              },
              {
                "name": "sgs/text",
                "attributes": {
                  "text": "Free. Pick it at checkout and I'll message when it's ready. I'll adjust them to fit while you wait.",
                  "fontSize": {
                    "desktop": 15
