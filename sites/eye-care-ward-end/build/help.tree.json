          {
            "name": "sgs/container",
            "attributes": {
              "layout": "stack",
              "gap": {
                "desktop": "10px"
              },
              "backgroundColour": "surface-alt",
              "padding": {
                "desktop": {
                  "top": "26px",
                  "right": "26px",
                  "bottom": "26px",
                  "left": "26px"
                }
              }
            },
            "innerBlocks": [
              {
                "name": "sgs/text",
