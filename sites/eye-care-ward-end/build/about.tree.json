              "sgsAnimation": "fade-up",
              "sgsAnimationDuration": "800",
              "sgsAnimationDistance": "18",
              "sgsAnimationEasing": "ease"
            }
          },
          {
            "name": "sgs/text",
            "attributes": {
              "text": "Day to day I test eyes, treat eye conditions and dispense glasses. The letters below aren't decoration — they're why I can look at your prescription and tell you what will actually work in a given frame.",
              "textColour": "text-muted",
              "fontSize": {
                "desktop": "16px"
              },
              "margin": {
                "desktop": {
                  "bottom": "18px"
                }
              },
              "sgsAnimation": "fade-up",
              "sgsAnimationDuration": "850",
              "sgsAnimationDistance": "18",
              "sgsAnimationEasing": "ease"
            }
          },
          {
            "name": "sgs/text",
            "attributes": {
              "text": "Every prescription order is checked by me before it's made. If a frame won't suit a strong prescription, I'll say so before you pay and suggest something that will.",
              "textColour": "text-muted",
              "fontSize": {
                "desktop": "16px"
              },
              "margin": {
                "desktop": {
                  "bottom": "18px"
                }
