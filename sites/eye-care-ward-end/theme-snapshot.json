{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Eye Care Ward End",
  "description": "Bundled preset — colour + typography combined. For independent axes use colours/eye-care-ward-end and typography/eye-care-ward-end.",
  "slug": "eye-care-ward-end",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#0D1B2A",
          "name": "Primary"
        },
        {
          "slug": "primary-text",
          "name": "Text on Primary",
          "color": "#FFFFFF"
        },
        {
          "slug": "primary-dark",
          "color": "#060D14",
          "name": "Primary Dark"
        },
        {
          "slug": "accent",
          "color": "#C9A84C",
          "name": "Accent"
        },
        {
          "slug": "accent-light",
          "color": "#F0E4C3",
          "name": "Accent Light"
        },
        {
          "slug": "error",
          "color": "#DC2626",
          "name": "Error"
        },
        {
          "slug": "error-light",
          "name": "Error Light",
          "color": "#FEF2F2"
        },
        {
          "slug": "info",
          "name": "Info",
          "color": "#3B82F6"
        },
        {
          "slug": "info-light",
          "name": "Info Light",
          "color": "#EBF5FF"
        },
        {
          "slug": "surface",
          "color": "#FFFFFF",
          "name": "Page Background"
        },
        {
          "slug": "surface-alt",
          "color": "#F5F5F0",
          "name": "Raised Background"
        },
        {
          "slug": "footer-bg",
          "color": "#0D1B2A",
          "name": "Footer Background"
        },
        {
          "slug": "text",
          "color": "#0D1B2A",
          "name": "Text"
        },
        {
          "slug": "text-secondary",
          "color": "#4A4A4A",
          "name": "Text Secondary"
        },
        {
          "slug": "text-muted",
          "color": "#6B6B6B",
          "name": "Text Muted"
        },
        {
          "slug": "text-inverse",
          "color": "#FFFFFF",
          "name": "Text on Dark"
        },
        {
          "slug": "border",
          "color": "#C9A84C",
          "name": "Border"
        },
        {
          "slug": "border-light",
          "color": "#E5E7EB",
          "name": "Border Light"
        },
        {
          "slug": "success-light",
          "name": "Success Light",
          "color": "#ECFDF5"
        },
        {
          "slug": "accent-text",
          "name": "Text on Accent",
          "color": "#92400E"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#2E7D4F"
        },
        {
          "slug": "whatsapp",
          "name": "WhatsApp",
          "color": "#25D366"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'DM Serif Display', Georgia, serif",
          "slug": "heading",
          "name": "Heading (DM Serif Display)"
        },
        {
          "fontFamily": "'DM Sans', system-ui, sans-serif",
          "slug": "body",
          "name": "Body (DM Sans)"
        },
        {
          "fontFamily": "'DM Sans', system-ui, sans-serif",
          "slug": "mono",
          "name": "Mono (DM Sans)"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "clamp(0.75rem, 1.5vw, 0.875rem)",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "clamp(0.875rem, 2vw, 1rem)",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "clamp(1rem, 2.5vw, 1.25rem)",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "clamp(1.25rem, 3vw, 1.75rem)",
          "name": "X Large"
        },
        {
          "slug": "xx-large",
          "size": "clamp(1.75rem, 4vw, 2.5rem)",
          "name": "XX Large"
        },
        {
          "slug": "xxx-large",
          "size": "clamp(2.25rem, 5.5vw, 3.5rem)",
          "name": "XXX Large"
        }
      ],
      "defaultFontSizes": false
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "XXS"
        },
        {
          "slug": "30",
          "size": "0.75rem",
          "name": "XS"
        },
        {
          "slug": "40",
          "size": "1rem",
          "name": "S"
        },
        {
          "slug": "50",
          "size": "1.5rem",
          "name": "M"
        },
        {
          "slug": "60",
          "size": "2rem",
          "name": "L"
        },
        {
          "slug": "70",
          "size": "3rem",
          "name": "XL"
        },
        {
          "slug": "80",
          "size": "4rem",
          "name": "XXL"
        },
        {
          "slug": "90",
          "size": "5.5rem",
          "name": "XXXL"
        }
      ],
      "customSpacingSize": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "400",
          "fontSize": "var(--wp--preset--font-size--xxx-large)",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "400",
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.15",
          "letterSpacing": "-0.015em"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "400",
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "400",
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.25"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.3",
          "letterSpacing": "0.05em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--preset--color--accent)"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--preset--color--text-secondary)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "letterSpacing": "0.04em"
        },
        "border": {
          "radius": "4px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--text-inverse)"
          }
        }
      }
    }
  }
}
