{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smallgiants.studio/schemas/handoff-manifest.schema.json",
  "title": "Claude Design handoff manifest",
  "description": "MANIFEST.json, written last into the handoff folder. Lists every file in the folder except MANIFEST.json itself. Paths are relative to the folder root, use / separators, and never start with ./ or / or contain .. or a backslash; directories are not listed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated", "project", "entry_drafts", "runtime_sha256", "files"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date written, YYYY-MM-DD." },
    "project": { "type": "string", "minLength": 1, "description": "The Claude Design project name." },
    "entry_drafts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "The drafts a visitor starts from: the site's main draft, or every page draft when the site has one file per page. Drafts mounted through <dc-import> or reached by a link from an entry draft need not be listed.",
      "items": { "type": "string", "allOf": [{ "$ref": "#/$defs/path" }], "pattern": "\\.dc\\.html$" }
    },
    "runtime_sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of support.js." },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\./)(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\)(?!.*//)[^\\u0000]*[^/\\u0000]$"
    }
  }
}
