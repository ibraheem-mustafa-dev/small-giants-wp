{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff-schema/animations.schema.json",
  "title": "Animation and interaction-effect inventory for a .dc.html handoff",
  "type": "object",
  "required": ["schema_version", "project", "runtime_sha256", "drafts", "records", "counts", "unresolved"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": { "type": "string" },
    "generated": { "type": "string", "format": "date" },
    "runtime_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["dc", "file", "sha256"], "additionalProperties": false,
        "properties": { "dc": { "type": "string" }, "file": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "counts": {
      "type": "object",
      "description": "Occurrences counted in the source next to the records that cover them. Every source occurrence maps to one or more record ids (a shared call site, e.g. fx(), maps to every record that uses it).",
      "required": ["animate_calls", "inline_transitions", "pseudo_rules", "css_animations", "js_style_writers"],
      "additionalProperties": false,
      "properties": {
        "animate_calls": { "$ref": "#/$defs/count" },
        "inline_transitions": { "$ref": "#/$defs/count" },
        "pseudo_rules": { "$ref": "#/$defs/count" },
        "css_animations": { "$ref": "#/$defs/count" },
        "js_style_writers": { "$ref": "#/$defs/count" }
      }
    },
    "runtime_trace": {
      "type": "object",
      "description": "Summary of the instrumented run used to check the records.",
      "additionalProperties": true
    },
    "unresolved": { "type": "array", "items": { "type": "object", "required": ["item", "reason"], "properties": { "item": { "type": "string" }, "reason": { "type": "string" }, "record_ids": { "type": "array", "items": { "type": "string" } } } } }
  },
  "$defs": {
    "count": {
      "type": "object", "required": ["by_dc", "total", "record_ids"], "additionalProperties": false,
      "properties": {
        "by_dc": { "type": "object", "additionalProperties": { "type": "integer" } },
        "total": { "type": "integer" },
        "record_ids": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "element": {
      "type": "object", "required": ["dc", "template_tpl_id", "selector", "description"], "additionalProperties": false,
      "properties": {
        "dc": { "type": "string" },
        "template_tpl_id": { "description": "data-dc-tpl of the template element (string), a list when several template elements share the record, or null when the target is created by code or lives inside an external SVG.", "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "nearest_tpl_id": { "description": "For code-created or SVG targets: data-dc-tpl of the nearest template ancestor (a list when several hosts).", "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "selector": { "type": "string", "description": "How the code finds the element at runtime (ref setter, data-* hook, structural query, id inside an SVG)." },
        "selection_rule": { "type": "string", "description": "Required when targets are chosen at runtime (computed style, index, viewport)." },
        "description": { "type": "string" }
      }
    },
    "property": {
      "type": "object", "required": ["property", "from", "to"], "additionalProperties": false,
      "properties": {
        "property": { "type": "string" },
        "from": { "type": ["string", "number", "null"] },
        "to": { "type": ["string", "number", "null"] },
        "keyframes": { "type": "array", "description": "Full keyframe list when there are more than two.", "items": { "type": "object" } },
        "formula": { "type": "string", "description": "For continuous effects: the expression that computes the value." },
        "duration_ms": { "type": ["number", "string", "null"], "description": "Per-property timing (CSS transitions with several properties)." },
        "delay_ms": { "type": ["number", "string", "null"] },
        "easing": { "type": ["string", "null"] }
      }
    },
    "record": {
      "type": "object",
      "required": ["id", "name", "mechanism", "element", "source", "trigger", "properties", "duration_ms", "delay_ms", "stagger", "easing", "iterations", "direction", "fill", "reduced_motion", "status", "trace"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{1,3}-[0-9]{2,3}$", "description": "Prefix by mechanism family: A (Web Animations in .dc.html logic), L (external scripts), J (JS style/scroll/text writers), TR (CSS transitions), PS (instant pseudo rules), RM (reduced-motion overrides)." },
        "name": { "type": "string" },
        "group": { "type": "string", "description": "Effect family, e.g. entrance, scroll-reveal, magnetic, tilt, pinned-timeline, marquee, mega-menu, drawer, logo, about-hero, hover, state-transition." },
        "mechanism": { "enum": ["waapi", "waapi-control", "css-transition", "css-pseudo", "css-animation", "css-media", "js-style-write", "js-text-write", "js-scroll", "js-dom-insert"] },
        "element": { "$ref": "#/$defs/element" },
        "source": {
          "type": "object", "required": ["file", "function", "line"], "additionalProperties": false,
          "properties": {
            "file": { "type": "string" },
            "function": { "type": "string", "description": "Logic-class method, ref setter or external function. 'template' for transitions and pseudo rules." },
            "ref": { "type": ["string", "null"] },
            "line": { "type": ["integer", "null"], "description": "1-based line in source.file (the .dc.html or .js file as shipped). null for template records, which are identified by template_tpl_id." },
            "code": { "type": "string" }
          }
        },
        "trigger": {
          "type": "object", "required": ["type", "detail"], "additionalProperties": false,
          "properties": {
            "type": { "enum": ["load", "route", "media-query", "scroll-into-view", "scroll-position", "hover", "focus", "pointer-move", "pointer-leave", "press", "state", "interval", "loop", "mount", "validation-fail"] },
            "detail": { "type": "string" },
            "state_keys": { "type": "array", "items": { "type": "string" } }
          }
        },
        "properties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/property" } },
        "duration_ms": { "type": ["number", "string", "null"], "description": "Number, or a formula string when computed." },
        "delay_ms": { "type": ["number", "string", "null"] },
        "stagger": {
          "oneOf": [{ "type": "null" }, { "type": "object", "required": ["ms", "basis"], "additionalProperties": false,
            "properties": { "ms": { "type": "number" }, "cap_ms": { "type": ["number", "null"] }, "base_ms": { "type": ["number", "null"] }, "basis": { "type": "string" } } }]
        },
        "easing": { "type": ["string", "null"] },
        "iterations": { "type": ["number", "string"], "description": "Number or 'infinite'." },
        "direction": { "enum": ["normal", "reverse", "alternate", "alternate-reverse", null] },
        "fill": { "enum": ["none", "forwards", "backwards", "both", "auto", null] },
        "reduced_motion": {
          "type": "object", "required": ["behaviour", "detail"], "additionalProperties": false,
          "properties": { "behaviour": { "enum": ["skip", "final-state", "unchanged"] }, "detail": { "type": "string" } }
        },
        "breakpoints": { "type": "array", "items": { "enum": ["mobile", "tablet", "desktop"] } },
        "routes": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["active", "dead-code", "no-op"], "description": "dead-code: present in the source but can never run in this draft. no-op: runs but changes nothing visible." },
        "trace": {
          "type": "object", "required": ["observed"], "additionalProperties": false,
          "properties": {
            "observed": { "enum": ["yes", "no", "not-instrumented"], "description": "yes: seen in the runtime trace. no: not seen (dead code, or a path the trace did not reach; see note). not-instrumented: the trace cannot produce or capture this (real :hover/:focus, scroll position, playbackRate, textContent)." },
            "calls": { "type": "integer" },
            "phases": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
