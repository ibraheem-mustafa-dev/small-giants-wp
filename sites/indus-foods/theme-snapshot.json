        "outline": {
          "background": "transparent",
          "text": "var(--wp--preset--color--text)",
          "border": "var(--wp--preset--color--border)",
          "border-width": "2px",
          "border-radius": "8px",
          "padding": "12px 24px 12px 24px",
          "font-size": "15px",
          "font-weight": "600",
          "min-height": "48px",
          "hover-background": "var(--wp--preset--color--surface-alt)",
          "hover-text": "var(--wp--preset--color--text)",
          "hover-border": "var(--wp--preset--color--primary)"
        }
      },
      "borderRadius": {
        "small": "3px",
        "medium": "12px",
        "large": "22px",
        "pill": "999px"
      },
      "transition": {
        "fast": "250ms cubic-bezier(0.25, 0.1, 0.25, 1)",
