  "gaps": [
    {
      "draftId": "*",
      "kind": "facet",
      "detail": "the filter on \"occ\" meets \"hospital\" on products, which the filter's own list offers no choice for; it is not written as terms"
    },
    {
      "draftId": "zookies",
      "kind": "multi-choice",
      "detail": "choice \"flav\" lets the shopper pick several of Vanilla, Chocolate, Strawberry, Mango, Banana, Coffee, Mint, Caramel, Coconut, Pistachio, Honey: a WooCommerce variation holds one value per attribute, so it needs a product add-ons field; recorded, not built"
    },
    {
      "draftId": "zookies",
      "kind": "switch",
      "detail": "choice \"sub\" is an on/off switch that multiplies the price by 0.9; when on, the shopper also picks \"freq\" (2, 4): WooCommerce core holds no recurring or price-changing switch (a recurring order needs WooCommerce Subscriptions or an equivalent plugin); recorded, not built"
    },
    {
      "draftId": "giftcard",
      "kind": "open-amount",
      "detail": "the shopper picks the amount paid (£15, £25, £40): sold as one variation per amount; redeeming it later as store credit needs a gift-card plugin, which WooCommerce core does not have"
    },
    {
      "draftId": "giftcard",
      "kind": "no-variesby",
      "detail": "no choice (\"amount\") is one of Google's variesBy axes (color, size, material, pattern, suggestedAge, suggestedGender), and SGS's product preflight publishes a variable product only when one of its variation terms maps to one (no_variesby); the product is made and kept a draft"
    }
  ],
